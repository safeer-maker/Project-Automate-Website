---
// Slim sub-navigation directly under a service hero: the pillar the service
// belongs to (linking to its block on the /solutions/ hub), its sibling
// services, and any other pillar it is also part of. On narrow screens the row
// scrolls sideways rather than wrapping.
import { withBase } from '../../lib/paths.ts';
import { pillarOf, pillars, services, type ServiceKey } from '../../data/services.ts';

interface Props {
	current: ServiceKey;
}

const { current } = Astro.props;
const service = services[current];
const pillar = pillarOf(current);
const siblings = pillar.services.map((key) => services[key]);
// A pillar of one (Concierge Care) would repeat its own name as the only link,
// so its service goes by its full title there.
const linkLabel = (s: (typeof siblings)[number]) => (siblings.length === 1 ? s.title : s.shortTitle);
const alsoIn = (service.alsoIn ?? []).map((key) => pillars.find((p) => p.key === key)!).filter(Boolean);
const hubHref = (key: string) => withBase(`/solutions/#${key}`);
---

<nav class="pillar-nav" aria-label={`${pillar.title} services`}>
	<div class="container">
		<div class="pillar-scroll" data-lenis-prevent>
			<div class="pillar-row">
				<a class="pillar-home" href={hubHref(pillar.key)}>
					{pillar.title}<span class="visually-hidden"> (all services)</span>
				</a>
				<span class="pillar-rule" aria-hidden="true"></span>
				<ul class="pillar-links">
					{siblings.map((s) => (
						<li>
							<a
								href={withBase(s.href)}
								class="pillar-link"
								aria-current={s.key === current ? 'page' : undefined}
							>
								{linkLabel(s)}
							</a>
						</li>
					))}
				</ul>
				{alsoIn.length > 0 && (
					<p class="pillar-also">
						<span>Also part of</span>
						{alsoIn.map((p, i) => (
							<>
								{i > 0 && <span aria-hidden="true">·</span>}
								<a href={hubHref(p.key)}>{p.title}</a>
							</>
						))}
					</p>
				)}
			</div>
		</div>
	</div>
</nav>

<style>
	.pillar-nav {
		position: relative;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.pillar-scroll {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		/* Room for the focus ring, which overflow would otherwise clip. */
		padding-block: 3px;
		margin-block: -3px;
	}

	.pillar-scroll::-webkit-scrollbar {
		display: none;
	}

	.pillar-row {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		min-height: 4rem;
		width: max-content;
		min-width: 100%;
		white-space: nowrap;
	}

	.pillar-home {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-bronze-text);
		transition: color var(--dur-fast) ease;
	}

	.pillar-home:hover {
		color: var(--color-text);
	}

	.pillar-rule {
		flex-shrink: 0;
		width: 1px;
		height: 1.25rem;
		background: var(--color-border);
	}

	.pillar-links {
		display: flex;
		align-items: center;
		gap: var(--space-8);
	}

	.pillar-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 4rem;
		font-size: var(--text-sm);
		font-weight: var(--fw-medium);
		color: var(--color-text-muted);
		transition: color var(--dur-fast) ease;
	}

	/* A bronze hairline marks the page you are on, sitting on the bar's own rule. */
	.pillar-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--color-bronze);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.pillar-link:hover {
		color: var(--color-text);
	}

	.pillar-link[aria-current='page'] {
		color: var(--color-text);
	}

	.pillar-link[aria-current='page']::after {
		transform: scaleX(1);
	}

	.pillar-also {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0 0 0 auto;
		padding-left: var(--space-8);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.pillar-also a {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.3em;
		transition:
			color var(--dur-fast) ease,
			text-decoration-color var(--dur-fast) ease;
	}

	.pillar-also a:hover {
		color: var(--color-bronze-text);
		text-decoration-color: currentColor;
	}

	.pillar-nav a:focus-visible {
		outline: 2px solid var(--color-bronze);
		outline-offset: 2px;
		border-radius: 2px;
	}

	@media (max-width: 760px) {
		.pillar-nav .container {
			padding-inline: 0;
		}

		/* Full-bleed scroller: the gutter lives inside it, and a soft fade at
		   the right edge says there is more to see. */
		.pillar-scroll {
			padding-inline: var(--container-padding);
			scroll-padding-inline: var(--container-padding);
			mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
		}

		.pillar-row {
			gap: var(--space-4);
			min-height: 3.5rem;
			padding-right: var(--space-8);
		}

		.pillar-links {
			gap: var(--space-6);
		}

		.pillar-link {
			min-height: 3.5rem;
		}

		.pillar-also {
			margin-left: 0;
			padding-left: var(--space-2);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pillar-link::after {
			transition: none;
		}
	}
</style>
