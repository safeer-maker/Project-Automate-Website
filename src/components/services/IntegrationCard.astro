---
// One "where systems meet" scenario: photograph, title, a short story and the
// services it brings together as chips. `current` (the page's own service) is
// listed first and not linked. A scenario without a photograph becomes a dark
// tile, so a grid that mixes the two still reads as deliberate.
// Used by ServiceIntegrations; `data-services` lets a page filter cards by service.
import Picture from '../ui/Picture.astro';
import { withBase } from '../../lib/paths.ts';
import { services, type ServiceKey } from '../../data/services.ts';
import type { Integration } from '../../data/integrations.ts';

interface Props {
	integration: Integration;
	current?: ServiceKey;
	/** `sizes` for the photograph; match the card's column. */
	sizes?: string;
	headingLevel?: 'h3' | 'h4';
	class?: string;
	style?: string;
}

const {
	integration,
	current,
	sizes = '(max-width: 700px) 100vw, 50vw',
	headingLevel = 'h3',
	class: className,
	style,
} = Astro.props;
const Heading = headingLevel;
const involved = [...integration.services].sort((a, b) => Number(b === current) - Number(a === current)).map((key) => services[key]);
const hasImage = Boolean(integration.image);
---

<article
	class:list={['integration-card', { 'is-plain': !hasImage }, className]}
	style={style}
	data-integration={integration.id}
	data-services={integration.services.join(' ')}
>
	{integration.image && (
		<div class="card-media">
			<Picture id={integration.image} alt={integration.imageAlt ?? ''} sizes={sizes} />
		</div>
	)}
	<div class="card-body">
		<Heading class="card-title">{integration.title}</Heading>
		<div class="card-foot">
			<p class="card-story">{integration.story}</p>
			<p class="card-label" aria-hidden="true">Brings together</p>
			<ul class="card-chips" aria-label={`${integration.title}: services involved`}>
				{involved.map((s) =>
					s.key === current ? (
						<li>
							<span class="chip is-current">
								{s.shortTitle}
								<span class="visually-hidden"> (this service)</span>
							</span>
						</li>
					) : (
						<li>
							<a class="chip" href={withBase(s.href)}>
								{s.shortTitle}
							</a>
						</li>
					)
				)}
			</ul>
		</div>
	</div>
</article>

<style>
	.integration-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.card-media {
		overflow: hidden;
		border-radius: var(--radius-md);
		/* Shown only while the photo loads. */
		background: rgba(22, 16, 8, 0.05);
	}

	.card-media :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: var(--card-ratio, 3 / 2);
		object-fit: cover;
	}

	.card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding-top: var(--space-6);
	}

	.card-title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
		font-weight: var(--fw-medium);
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	/* Label and chips sit on the card's floor, so they line up across a row. */
	.card-foot {
		display: flex;
		flex: 1;
		flex-direction: column;
	}

	.card-story {
		max-width: 36rem;
		margin: 0 0 var(--space-6);
		font-size: var(--text-base);
		line-height: 1.65;
		text-wrap: pretty;
	}

	.card-label {
		margin: auto 0 var(--space-3);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-bronze-text);
	}

	.card-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.25rem;
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: var(--text-sm);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		color: var(--color-text);
		transition:
			color var(--dur-fast) ease,
			border-color var(--dur-fast) ease,
			background-color var(--dur-fast) ease;
	}

	a.chip:hover {
		border-color: var(--color-bronze);
		color: var(--color-bronze-text);
	}

	a.chip:focus-visible {
		outline: 2px solid var(--color-bronze);
		outline-offset: 2px;
	}

	/* The page's own service: named, not linked, marked by a bronze dot. */
	.chip.is-current {
		border-color: transparent;
		padding-left: 0.2rem;
		color: var(--color-text-muted);
	}

	.chip.is-current::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-bronze);
	}

	/* ---- Without a photograph: a dark tile, title above, story below ---- */

	.is-plain {
		min-height: 22rem;
		padding: clamp(1.75rem, 3vw, 2.75rem);
		border-radius: var(--radius-md);
		/* A low warm glow, like light spilling from a screen, keeps the empty
		   space in the tile atmospheric rather than blank. */
		background:
			radial-gradient(90% 70% at 88% 0%, rgba(175, 136, 80, 0.2), rgba(175, 136, 80, 0) 70%),
			var(--color-charcoal);
		color: var(--color-text-on-dark);
	}

	.is-plain .card-body {
		justify-content: space-between;
		gap: var(--space-12);
		padding-top: 0;
	}

	.is-plain .card-foot {
		flex: 0 0 auto;
	}

	.is-plain .card-title {
		font-size: var(--text-3xl);
		color: var(--color-text-on-dark);
	}

	.is-plain .card-story {
		color: var(--color-text-on-dark-muted);
	}

	.is-plain .card-label {
		color: var(--color-gold-light);
	}

	.is-plain .chip {
		border-color: var(--color-border-on-dark);
		color: var(--color-text-on-dark);
	}

	.is-plain a.chip:hover {
		border-color: var(--color-gold-light);
		color: var(--color-gold-light);
	}

	.is-plain a.chip:focus-visible {
		outline-color: var(--color-gold-light);
	}

	.is-plain .chip.is-current {
		border-color: transparent;
		color: var(--color-text-on-dark-muted);
	}

	.is-plain .chip.is-current::before {
		background: var(--color-gold-light);
	}

	@media (max-width: 700px) {
		.is-plain {
			min-height: 0;
		}

		.is-plain .card-body {
			gap: var(--space-8);
		}

		.is-plain .card-title {
			font-size: var(--text-2xl);
		}
	}
</style>
