---
import { withBase } from '../../lib/paths.ts';
import { siteInfo, footerQuickLinks, footerMenu, legalLinks } from '../../data/site.ts';
import { coreServices } from '../../data/nav.ts';
import Button from '../ui/Button.astro';

const year = new Date().getFullYear();

// The HTA Design Partner mark is white-on-transparent, so it vanishes on the
// light chip the other badges need — it gets a dark chip of its own.
const badges = [
	{ src: '/images/badges/hta-design-partner.webp', alt: 'HTA Design Partner', dark: true },
	{ src: '/images/badges/cedia-certified.webp', alt: 'CEDIA Smart Home CE Provider' },
	{ src: '/images/badges/cert-level-luxury.webp', alt: 'HTA Certified — Luxury Level' },
	{ src: '/images/badges/17-years-badge.webp', alt: '17+ Years of Smart Home Expertise' },
];
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			{/* 150×97 matches the file's 451×291 ratio — nothing in CSS resizes it, so these attributes are its rendered size. */}
			<img src={withBase('/images/logo/logo-static.webp')} alt="PROJECT: automate logo" width="150" height="97" />
			<p class="tagline">{siteInfo.tagline}</p>

			<form class="newsletter" data-placeholder-form>
				<label for="footer-email" class="visually-hidden">Email</label>
				<input id="footer-email" type="email" name="email" placeholder="Email" required />
				<button type="submit">Submit</button>
			</form>
			<p class="newsletter-success" data-form-success hidden>Thanks — you're on the list.</p>

			<ul class="social">
				{siteInfo.social.map((s) => (
					<li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Quick Links</h3>
			<ul>
				{footerQuickLinks.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Services</h3>
			<ul>
				{coreServices.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>More</h3>
			<ul>
				{footerMenu.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col footer-concierge">
			<h3>Concierge</h3>
			<ul class="contact-list">
				<li><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></li>
				{siteInfo.phones.map((phone) => (
					<li><a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a></li>
				))}
				<li>{siteInfo.address.line1}<br />{siteInfo.address.line2}</li>
			</ul>
			<Button href={withBase('/schedule/')} data-ghl-form-open variant="outline" size="md" class="footer-cta">Book a Consultation</Button>
		</div>
	</div>

	<div class="container badge-row">
		{badges.map((badge) => (
			<div class:list={['badge-chip', { 'badge-chip--dark': badge.dark }]}>
				<img src={withBase(badge.src)} alt={badge.alt} loading="lazy" decoding="async" />
			</div>
		))}
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} {siteInfo.legalName}. All rights reserved.</p>
		<ul class="legal-links">
			{legalLinks.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
		<a href={siteInfo.credit.href} target="_blank" rel="noopener noreferrer" class="credit">{siteInfo.credit.label}</a>
	</div>
</footer>

<script>
	document.querySelectorAll('.newsletter[data-placeholder-form]').forEach((form) => {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const successEl = form.parentElement?.querySelector('[data-form-success]');
			if (successEl instanceof HTMLElement) {
				form.classList.add('is-hidden');
				successEl.hidden = false;
			}
		});
	});

	// Fade the footer's columns + badges up into place the first time it's scrolled into view.
	const footer = document.querySelector('.site-footer');
	if (footer && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			([entry], obs) => {
				if (entry.isIntersecting) {
					footer.setAttribute('data-visible', 'true');
					obs.disconnect();
				}
			},
			{ threshold: 0.15 }
		);
		observer.observe(footer);
	}
</script>

<style>
	.site-footer {
		background: var(--color-charcoal);
		border-top: 1px solid var(--color-border-on-dark);
		padding-block: var(--space-16) var(--space-8);
		color: var(--color-text-on-dark-muted);
	}

	.site-footer p {
		color: var(--color-text-on-dark-muted);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr;
		gap: var(--space-8);
	}

	.footer-brand img {
		margin-bottom: var(--space-4);
	}

	.tagline {
		max-width: 320px;
		font-size: var(--text-sm);
	}

	.newsletter {
		display: flex;
		align-items: stretch;
		max-width: 320px;
		margin-bottom: var(--space-4);
		border: none;
		border-bottom: 1px solid var(--color-border-on-dark);
		transition: border-color var(--dur-fast) ease, border-width var(--dur-fast) ease;
	}

	.newsletter:focus-within {
		border-bottom: 2px solid var(--color-accent);
	}

	.newsletter input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: none;
		color: var(--color-text-on-dark);
		font-size: var(--text-sm);
		padding: var(--space-3) 0;
	}

	.newsletter input::placeholder {
		color: var(--color-text-on-dark-muted);
	}

	.newsletter button {
		background: transparent;
		color: var(--color-accent);
		border: none;
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		padding: 0 0 0 var(--space-4);
		transition: color var(--dur-fast) ease;
	}

	.newsletter button:hover {
		color: var(--color-accent-hover);
	}

	.newsletter-success {
		font-size: var(--text-sm);
		color: var(--color-accent);
		margin-bottom: var(--space-4);
	}

	.newsletter.is-hidden {
		display: none;
	}

	.social {
		display: flex;
		gap: var(--space-4);
	}
	.social a {
		color: var(--color-text-on-dark-muted);
		font-size: var(--text-sm);
	}
	.social a:hover {
		color: var(--color-accent);
	}

	.footer-col h3 {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin-bottom: var(--space-4);
	}

	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-col a {
		color: var(--color-text-on-dark-muted);
		font-size: var(--text-sm);
	}
	.footer-col a:hover {
		color: var(--color-white);
	}

	.contact-list li {
		font-size: var(--text-sm);
		color: var(--color-text-on-dark-muted);
	}

	.footer-cta {
		margin-top: var(--space-6);
	}

	.badge-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-8);
		margin-top: var(--space-12);
		border-top: 1px solid var(--color-border-on-dark);
	}

	/* The source badges carry their own white/black/transparent backgrounds —
	   a plain desaturated image disappears into the dark footer. A light chip
	   gives every badge the same clean, legible card regardless of its art. */
	.badge-chip {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 60px;
		padding: var(--space-2) var(--space-4);
		background: var(--color-white);
		border-radius: var(--radius-sm);
		opacity: 0.85;
		transition: opacity var(--dur-base) ease, transform var(--dur-base) ease;
	}

	.badge-chip--dark {
		background: var(--color-charcoal-2);
		border: 1px solid var(--color-border-on-dark);
	}

	.badge-chip:hover {
		opacity: 1;
		transform: translateY(-2px);
	}

	.badge-chip img {
		height: 100%;
		width: auto;
		max-width: 140px;
		object-fit: contain;
	}

	/* Reveal-on-scroll: columns + badges fade up 16px on a stagger, see script below */
	.footer-grid > *,
	.badge-row {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity var(--dur-slow) var(--ease-out-expo), transform var(--dur-slow) var(--ease-out-expo);
	}

	.footer-grid > *:nth-child(1) { transition-delay: 0ms; }
	.footer-grid > *:nth-child(2) { transition-delay: 60ms; }
	.footer-grid > *:nth-child(3) { transition-delay: 120ms; }
	.footer-grid > *:nth-child(4) { transition-delay: 180ms; }
	.footer-grid > *:nth-child(5) { transition-delay: 240ms; }
	.badge-row { transition-delay: 300ms; }

	.site-footer[data-visible='true'] .footer-grid > *,
	.site-footer[data-visible='true'] .badge-row {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-grid > *,
		.badge-row {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-on-dark);
		font-size: var(--text-xs);
		color: var(--color-text-on-dark-muted);
	}

	.legal-links {
		display: flex;
		gap: var(--space-6);
	}
	.legal-links a:hover {
		color: var(--color-accent);
	}

	.credit {
		color: var(--color-text-on-dark-muted);
	}
	.credit:hover {
		color: var(--color-accent);
	}

	@media (max-width: 1100px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 700px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
		/* The email address is wider than half a 375px screen. */
		.footer-concierge {
			grid-column: 1 / -1;
		}
	}
</style>
