---
import { withBase } from '../../lib/paths.ts';
import { siteInfo, footerQuickLinks, footerMenu, legalLinks } from '../../data/site.ts';
import { serviceGroups, solutionsHub } from '../../data/nav.ts';
import Button from '../ui/Button.astro';

const year = new Date().getFullYear();

// The HTA Design Partner mark is white-on-transparent, so it vanishes on the
// light chip the other badges need — it gets a dark chip of its own.
// The -sm files are 150px tall (enough for the 44px chip at 3x); the originals
// (785–1853px, ~125KB for three) stay for the pages that show them large.
// width/height are each file's own size, so a chip is laid out at its final
// width before the image arrives; CSS sets the rendered height.
const badges = [
	{ src: '/images/badges/hta-design-partner.webp', alt: 'HTA Design Partner', width: 280, height: 40, dark: true },
	{ src: '/images/badges/cedia-certified-sm.webp', alt: 'CEDIA Smart Home CE Provider', width: 150, height: 150 },
	{ src: '/images/badges/cert-level-luxury-sm.webp', alt: 'HTA Certified — Luxury Level', width: 319, height: 150 },
	{ src: '/images/badges/17-years-badge-sm.webp', alt: '17+ Years of Smart Home Expertise', width: 126, height: 150 },
];

// "Building 7" and "Suite 400" never split across lines. Only here: line1
// also feeds the JSON-LD streetAddress, which should stay plain.
const addressLine1 = siteInfo.address.line1.replace(/(Building|Suite) /g, '$1\u00a0');
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			{/* 150×97 matches the file's 451×291 ratio — nothing in CSS resizes it, so these attributes are its rendered size. */}
			<img src={withBase('/images/logo/logo-static.webp')} alt="PROJECT: automate logo" width="150" height="97" />
			<p class="tagline">{siteInfo.tagline}</p>
			{/* The newsletter field that sat here was a placeholder: it said
			    "you're on the list" but sent the address nowhere. Removed until
			    there is a real list to connect it to. */}

			<ul class="social">
				{siteInfo.social.map((s) => (
					<li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Quick Links</h3>
			<ul>
				{footerQuickLinks.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Services</h3>
			{/* One line per pillar, each opening its lead service; the hub holds the rest. */}
			<ul>
				{serviceGroups.map((group) => (
					<li><a href={group.leadHref}>{group.title}</a></li>
				))}
				<li>
					<a class="footer-all" href={solutionsHub}>All services <span aria-hidden="true">&rarr;</span></a>
				</li>
			</ul>
		</div>

		<div class="footer-col">
			<h3>More</h3>
			<ul>
				{footerMenu.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col footer-concierge">
			<h3>Concierge</h3>
			<ul class="contact-list">
				<li><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></li>
				{siteInfo.phones.map((phone) => (
					<li><a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a></li>
				))}
				<li>{addressLine1}<br />{siteInfo.address.line2}</li>
			</ul>
			<Button href={withBase('/schedule/')} data-ghl-form-open variant="outline" size="md" class="footer-cta">Book a Consultation</Button>
		</div>
	</div>

	<div class="container badge-row">
		{badges.map((badge) => (
			<div class:list={['badge-chip', { 'badge-chip--dark': badge.dark }]}>
				<img src={withBase(badge.src)} alt={badge.alt} width={badge.width} height={badge.height} loading="lazy" decoding="async" />
			</div>
		))}
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} {siteInfo.legalName} All rights reserved.</p>
		<ul class="legal-links">
			{legalLinks.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
		<a href={siteInfo.credit.href} target="_blank" rel="noopener noreferrer" class="credit">{siteInfo.credit.label}</a>
	</div>
</footer>

<script>
	// Fade the footer's columns + badges up into place the first time it's scrolled into view.
	const footer = document.querySelector('.site-footer');
	if (footer && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			([entry], obs) => {
				if (entry.isIntersecting) {
					footer.setAttribute('data-visible', 'true');
					obs.disconnect();
				}
			},
			{ threshold: 0.15 }
		);
		observer.observe(footer);
	}
</script>

<style>
	.site-footer {
		background: var(--color-charcoal);
		border-top: 1px solid var(--color-border-on-dark);
		padding-block: var(--space-16) var(--space-8);
		color: var(--color-text-on-dark-muted);
	}

	.site-footer p {
		color: var(--color-text-on-dark-muted);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr;
		gap: var(--space-8);
	}

	.footer-brand img {
		margin-bottom: var(--space-4);
	}

	.tagline {
		max-width: 320px;
		font-size: var(--text-sm);
		text-wrap: pretty;
	}

	.social {
		display: flex;
		gap: var(--space-4);
	}
	.social a {
		/* Padding brings the tap target to ~44px without moving the text. */
		display: inline-block;
		padding-block: 0.75rem;
		margin-block: -0.75rem;
		color: var(--color-text-on-dark-muted);
		font-size: var(--text-sm);
	}
	.social a:hover {
		color: var(--color-accent-hover);
	}

	/* Gold-light, not the brand bronze: 14px caps on charcoal need 4.5:1,
	   and the bronze is 4.17:1 here (gold-light 5.57:1). */
	.footer-col h3 {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent-hover);
		margin-bottom: var(--space-4);
	}

	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-col a {
		color: var(--color-text-on-dark-muted);
		font-size: var(--text-sm);
	}
	.footer-col a:hover {
		color: var(--color-white);
	}

	.footer-col .footer-all {
		display: inline-block;
		margin-top: var(--space-2);
		color: var(--color-text-on-dark);
		font-weight: var(--fw-semibold);
	}
	.footer-col .footer-all:hover {
		color: var(--color-accent-hover);
	}

	.contact-list li {
		font-size: var(--text-sm);
		color: var(--color-text-on-dark-muted);
		text-wrap: pretty;
	}

	.footer-cta {
		margin-top: var(--space-6);
	}

	.badge-row {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-8);
		margin-top: var(--space-12);
	}

	/* The two hairlines are inset by the container's padding, so they start
	   and end with the content above them rather than out in the gutter. */
	.badge-row::before,
	.footer-bottom::before {
		content: '';
		position: absolute;
		top: 0;
		left: var(--container-padding);
		right: var(--container-padding);
		height: 1px;
		background: var(--color-border-on-dark);
	}

	/* The source badges carry their own white/black/transparent backgrounds —
	   a plain desaturated image disappears into the dark footer. A light chip
	   gives every badge the same clean, legible card regardless of its art. */
	.badge-chip {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 60px;
		padding: var(--space-2) var(--space-4);
		background: var(--color-white);
		border-radius: var(--radius-sm);
		opacity: 0.85;
		transition: opacity var(--dur-base) ease, transform var(--dur-base) ease;
	}

	.badge-chip--dark {
		background: var(--color-charcoal-2);
		border: 1px solid var(--color-border-on-dark);
	}

	.badge-chip:hover {
		opacity: 1;
		transform: translateY(-2px);
	}

	.badge-chip img {
		height: 100%;
		width: auto;
		max-width: 140px;
		object-fit: contain;
	}

	/* Reveal-on-scroll: columns + badges fade up 16px on a stagger, see script below */
	.footer-grid > *,
	.badge-row {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity var(--dur-slow) var(--ease-out-expo), transform var(--dur-slow) var(--ease-out-expo);
	}

	.footer-grid > *:nth-child(1) { transition-delay: 0ms; }
	.footer-grid > *:nth-child(2) { transition-delay: 60ms; }
	.footer-grid > *:nth-child(3) { transition-delay: 120ms; }
	.footer-grid > *:nth-child(4) { transition-delay: 180ms; }
	.footer-grid > *:nth-child(5) { transition-delay: 240ms; }
	.badge-row { transition-delay: 300ms; }

	.site-footer[data-visible='true'] .footer-grid > *,
	.site-footer[data-visible='true'] .badge-row {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-grid > *,
		.badge-row {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	.footer-bottom {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		font-size: var(--text-xs);
		color: var(--color-text-on-dark-muted);
	}

	/* The global p margin lifted the copyright 8px above its row. */
	.footer-bottom p {
		margin: 0;
	}

	.legal-links {
		display: flex;
		gap: var(--space-6);
	}
	.legal-links a:hover {
		color: var(--color-accent-hover);
	}

	.credit {
		display: inline-block;
		padding-block: 0.75rem;
		margin-block: -0.75rem;
		color: var(--color-text-on-dark-muted);
	}
	.credit:hover {
		color: var(--color-accent-hover);
	}

	@media (max-width: 1100px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 700px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
		/* The email address is wider than half a 375px screen. */
		.footer-concierge {
			grid-column: 1 / -1;
		}
		/* Taller tap targets (the links were 17–19px), key for the studio's
		   phone numbers and email. The padding replaces the list gap, so the
		   rhythm only loosens slightly. */
		.footer-col ul {
			gap: 0;
		}
		.footer-col a,
		.contact-list a,
		.legal-links a {
			display: inline-block;
			padding-block: 0.625rem;
		}
		.footer-col .footer-all {
			margin-top: 0;
		}
	}
</style>
