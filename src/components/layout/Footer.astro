---
import { siteInfo, footerMenu, footerServices, legalLinks } from '../../data/site.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<img src="/images/logo/logo-static.png" alt="PROJECT: automate logo" width="150" height="84" />
			<p class="tagline">{siteInfo.tagline}</p>
			<ul class="social">
				{siteInfo.social.map((s) => (
					<li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Menu</h3>
			<ul>
				{footerMenu.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Service</h3>
			<ul>
				{footerServices.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Concierge</h3>
			<ul class="contact-list">
				<li><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></li>
				{siteInfo.phones.map((phone) => (
					<li><a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a></li>
				))}
				<li>{siteInfo.address.line1}<br />{siteInfo.address.line2}</li>
			</ul>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} PROJECT: automate. All rights reserved.</p>
		<ul class="legal-links">
			{legalLinks.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
		<a href={siteInfo.credit.href} target="_blank" rel="noopener noreferrer" class="credit">{siteInfo.credit.label}</a>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-charcoal);
		border-top: 1px solid var(--color-border);
		padding-block: var(--space-16) var(--space-8);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1.4fr;
		gap: var(--space-8);
	}

	.footer-brand img {
		margin-bottom: var(--space-4);
	}

	.tagline {
		max-width: 320px;
		font-size: var(--text-sm);
	}

	.social {
		display: flex;
		gap: var(--space-4);
	}
	.social a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.social a:hover {
		color: var(--color-accent);
	}

	.footer-col h3 {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin-bottom: var(--space-4);
	}

	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-col a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.footer-col a:hover {
		color: var(--color-white);
	}

	.contact-list li {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.legal-links {
		display: flex;
		gap: var(--space-6);
	}
	.legal-links a:hover {
		color: var(--color-accent);
	}

	.credit {
		color: var(--color-text-muted);
	}
	.credit:hover {
		color: var(--color-accent);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}
</style>
