---
import { withBase } from '../../lib/paths.ts';
import { siteInfo, footerQuickLinks, footerMenu, legalLinks } from '../../data/site.ts';
import { coreServices } from '../../data/nav.ts';
import Button from '../ui/Button.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<img src={withBase('/images/logo/logo-static.webp')} alt="PROJECT: automate logo" width="150" height="84" />
			<p class="tagline">{siteInfo.tagline}</p>

			<form class="newsletter" data-placeholder-form>
				<label for="footer-email" class="visually-hidden">Email</label>
				<input id="footer-email" type="email" name="email" placeholder="Email" required />
				<button type="submit">Submit</button>
			</form>
			<p class="newsletter-success" data-form-success hidden>Thanks — you're on the list.</p>

			<ul class="social">
				{siteInfo.social.map((s) => (
					<li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Quick Links</h3>
			<ul>
				{footerQuickLinks.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>Services</h3>
			<ul>
				{coreServices.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<h3>More</h3>
			<ul>
				{footerMenu.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</div>

		<div class="footer-col footer-concierge">
			<h3>Concierge</h3>
			<ul class="contact-list">
				<li><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></li>
				{siteInfo.phones.map((phone) => (
					<li><a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a></li>
				))}
				<li>{siteInfo.address.line1}<br />{siteInfo.address.line2}</li>
			</ul>
			<Button href={withBase('/schedule/')} variant="outline" size="md" class="footer-cta">Book a Consultation</Button>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} {siteInfo.legalName}. All rights reserved.</p>
		<ul class="legal-links">
			{legalLinks.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>
		<a href={siteInfo.credit.href} target="_blank" rel="noopener noreferrer" class="credit">{siteInfo.credit.label}</a>
	</div>
</footer>

<script>
	document.querySelectorAll('.newsletter[data-placeholder-form]').forEach((form) => {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const successEl = form.parentElement?.querySelector('[data-form-success]');
			if (successEl instanceof HTMLElement) {
				form.classList.add('is-hidden');
				successEl.hidden = false;
			}
		});
	});
</script>

<style>
	.site-footer {
		background: var(--color-charcoal);
		border-top: 1px solid var(--color-border-on-dark);
		padding-block: var(--space-16) var(--space-8);
		color: var(--color-text-on-dark-muted);
	}

	.site-footer p {
		color: var(--color-text-on-dark-muted);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr;
		gap: var(--space-8);
	}

	.footer-brand img {
		margin-bottom: var(--space-4);
	}

	.tagline {
		max-width: 320px;
		font-size: var(--text-sm);
	}

	.newsletter {
		display: flex;
		max-width: 320px;
		margin-bottom: var(--space-4);
		border: 1px solid var(--color-border-on-dark);
		border-radius: var(--radius-sm);
		overflow: hidden;
	}

	.newsletter input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: none;
		color: var(--color-text-on-dark);
		font-size: var(--text-sm);
		padding: var(--space-3);
	}

	.newsletter input::placeholder {
		color: var(--color-text-on-dark-muted);
	}

	.newsletter button {
		background: var(--color-accent);
		color: var(--color-white);
		border: none;
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		padding: 0 var(--space-4);
	}

	.newsletter button:hover {
		background: var(--color-accent-hover);
	}

	.newsletter-success {
		font-size: var(--text-sm);
		color: var(--color-accent);
		margin-bottom: var(--space-4);
	}

	.newsletter.is-hidden {
		display: none;
	}

	.social {
		display: flex;
		gap: var(--space-4);
	}
	.social a {
		color: var(--color-text-on-dark-muted);
		font-size: var(--text-sm);
	}
	.social a:hover {
		color: var(--color-accent);
	}

	.footer-col h3 {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin-bottom: var(--space-4);
	}

	.footer-col ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.footer-col a {
		color: var(--color-text-on-dark-muted);
		font-size: var(--text-sm);
	}
	.footer-col a:hover {
		color: var(--color-white);
	}

	.contact-list li {
		font-size: var(--text-sm);
		color: var(--color-text-on-dark-muted);
	}

	.footer-cta {
		margin-top: var(--space-6);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-on-dark);
		font-size: var(--text-xs);
		color: var(--color-text-on-dark-muted);
	}

	.legal-links {
		display: flex;
		gap: var(--space-6);
	}
	.legal-links a:hover {
		color: var(--color-accent);
	}

	.credit {
		color: var(--color-text-on-dark-muted);
	}
	.credit:hover {
		color: var(--color-accent);
	}

	@media (max-width: 1100px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 700px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
