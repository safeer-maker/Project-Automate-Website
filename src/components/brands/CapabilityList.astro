---
interface Item {
	title: string;
	description: string;
	image?: string;
}

interface Props {
	eyebrow: string;
	title: string;
	items: Item[];
}

const { eyebrow, title, items } = Astro.props;
---

<section class="section capability-list">
	<div class="container">
		<div class="heading">
			<span class="eyebrow">{eyebrow}</span>
			<h2>{title}</h2>
		</div>
		<div class="items">
			{items.map((item) => (
				<article class="item">
					{item.image && <img src={item.image} alt="" loading="lazy" />}
					<div class="item-text">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.heading {
		max-width: 600px;
		margin-bottom: var(--space-12);
	}

	.items {
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.item {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: var(--space-8);
		align-items: center;
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-8);
	}

	.item img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.item-text h3 {
		font-size: var(--text-2xl);
		margin-bottom: var(--space-3);
	}

	@media (max-width: 800px) {
		.item {
			grid-template-columns: 1fr;
		}
	}
</style>
