---
interface Props {
	slug: string;
	title: string;
	excerpt: string;
	coverImage: string;
	coverImageAlt: string;
	category: string;
	publishDate: Date;
}

const { slug, title, excerpt, coverImage, coverImageAlt, category, publishDate } = Astro.props;
const formattedDate = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a class="post-card" href={`/${slug}/`}>
	<div class="post-image">
		<img src={coverImage} alt={coverImageAlt} loading="lazy" width="480" height="320" />
		<span class="category">{category}</span>
	</div>
	<div class="post-body">
		<time datetime={publishDate.toISOString()}>{formattedDate}</time>
		<h3>{title}</h3>
		<p>{excerpt}</p>
	</div>
</a>

<style>
	.post-card {
		display: block;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: border-color var(--transition-base), transform var(--transition-base);
	}
	.post-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-4px);
	}

	.post-image {
		position: relative;
		aspect-ratio: 3 / 2;
		overflow: hidden;
	}
	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.category {
		position: absolute;
		top: var(--space-3);
		left: var(--space-3);
		background: var(--color-accent);
		color: var(--color-white);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
	}

	.post-body {
		padding: var(--space-6);
	}

	.post-body time {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.post-body h3 {
		font-size: var(--text-xl);
		margin: var(--space-2) 0;
	}

	.post-body p {
		font-size: var(--text-sm);
		margin: 0;
	}
</style>
