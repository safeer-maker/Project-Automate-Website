---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---

<div class={`section-heading align-${align}`}>
	{eyebrow && <span class="eyebrow">{eyebrow}</span>}
	<h2 set:html={title} />
	{subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
	.section-heading {
		margin-bottom: var(--space-12);
		max-width: 640px;
	}

	.align-center {
		margin-inline: auto;
		text-align: center;
	}

	.subtitle {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		margin: 0;
	}
</style>
