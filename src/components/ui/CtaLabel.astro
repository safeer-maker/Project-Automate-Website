---
// Inner markup for a `.cta-lux` button (styles in src/styles/cta.css): the
// light layer, the label (with its phone-length variant) and the arrow.
// Use it as the button's only child:
//   <Button class="cta-lux cta-lux-beacon" …><CtaLabel /></Button>
import { consultationCta } from '../../data/cta.ts';

interface Props {
	label?: string;
	/** Shown instead of `label` at ≤700px. Defaults to `label` when a custom label is given. */
	short?: string;
	arrow?: boolean;
}

const custom = Astro.props.label !== undefined;
const { label = consultationCta.label, short = custom ? Astro.props.label : consultationCta.short, arrow = true } = Astro.props;
---

<span class="cta-sheen" aria-hidden="true"></span>
{short === label ? (
	<span class="cta-label">{label}</span>
) : (
	<span class="cta-label">
		<span class="cta-label-full">{label}</span><span class="cta-label-short">{short}</span>
	</span>
)}
{arrow && (
	<svg class="cta-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
		<path d="M1.5 8h12.5M9.5 3.5 14 8l-4.5 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}
