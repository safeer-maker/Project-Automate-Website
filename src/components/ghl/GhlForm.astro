---
// The GHL lead form iframe. form_embed.js (loaded once in BaseLayout) finds it,
// resizes it to fit its content, and passes our cookie-consent state into it.
import { ghl, ghlFormUrl } from '../../data/ghl.ts';

interface Props {
	/**
	 * Distinguishes multiple copies of the form on one page (e.g. the homepage
	 * section and the popup). form_embed.js deletes iframes that share an id,
	 * so each copy needs its own.
	 */
	instance?: string;
	/**
	 * Leave loading to the caller (the popup preloads it after page load). Otherwise
	 * the form loads itself as it nears the viewport.
	 */
	deferLoad?: boolean;
	/**
	 * The form is the point of the page (/schedule/, /get-started/, landing
	 * pages). Its src is written straight into the HTML so the browser starts
	 * fetching it while the page is still parsing, instead of waiting for a
	 * script — and the popup stands down on that page (see GhlFormModal).
	 */
	primary?: boolean;
}

const { instance = 'inline', deferLoad = false, primary = false } = Astro.props;
const id = instance === 'inline' ? `inline-${ghl.formId}` : `inline-${ghl.formId}-${instance}`;

// A generic outline of a form, not a field-for-field copy, so it doesn't go
// stale when the GHL form changes.
const skeletonFields = 9;
---

<div class="ghl-form-shell" data-ghl-shell style={`--ghl-form-height:${ghl.formHeight}px`}>
	<!-- Fills the reserved height while the form loads: on a slow connection
	     a visitor could otherwise scroll into a whole screen of empty cream. -->
	<div class="ghl-form-loading" aria-hidden="true">
		<span class="ghl-form-loading-bar"></span>
		<span class="ghl-form-loading-label">Preparing your private consultation form…</span>
		{Array.from({ length: skeletonFields }, () => (
			<span class="ghl-skeleton-field">
				<span class="ghl-skeleton-label"></span>
				<span class="ghl-skeleton-input"></span>
			</span>
		))}
		<span class="ghl-skeleton-submit"></span>
	</div>
	<!-- form_embed.js moves an iframe into a `${id}-wrapper` container of its
	     own unless it already sits in one, and moving an iframe reloads it: the
	     form appeared, blanked for a frame and loaded a second time (losing
	     anything typed). Providing the wrapper up front keeps it in place. -->
	<div id={`${id}-wrapper`}>
		<iframe
			class="ghl-form"
			src={primary ? ghlFormUrl : undefined}
			data-src={ghlFormUrl}
			data-ghl-manual-load={deferLoad ? '' : undefined}
			data-ghl-primary={primary ? '' : undefined}
			style={`height:${ghl.formHeight}px`}
			id={id}
			data-layout="{'id':'INLINE'}"
			data-trigger-type="alwaysShow"
			data-trigger-value=""
			data-activation-type="alwaysActivated"
			data-activation-value=""
			data-deactivation-type="neverDeactivate"
			data-deactivation-value=""
			data-form-name={ghl.formName}
			data-height={ghl.formHeight}
			data-layout-iframe-id={id}
			data-form-id={ghl.formId}
			data-cookie-consent="true"
			data-cookie-consent-provider="ghl_cookie"
			title="Private consultation request form"
		></iframe>
	</div>
</div>

<script>
	// Why not loading="lazy": form_embed.js parks an iframe off-screen until it
	// has loaded, and a lazy iframe off-screen never loads — so it never appears.
	// An iframe without src is ignored by form_embed.js until the form inside
	// reports in, so we set src ourselves as it approaches the viewport.
	const io = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const frame = entry.target.querySelector<HTMLIFrameElement>('iframe.ghl-form')!;
				if (!frame.getAttribute('src')) frame.src = frame.dataset.src!;
				io.unobserve(entry.target);
			});
		},
		// Generous: the form takes 1–2s to arrive, so start well before it is on screen.
		{ rootMargin: '1400px 0px' }
	);

	document.querySelectorAll<HTMLElement>('[data-ghl-shell]').forEach((shell) => {
		const frame = shell.querySelector<HTMLIFrameElement>('iframe.ghl-form');
		if (!frame) return;
		// Observe the shell, not the iframe: form_embed.js moves the iframe
		// off-screen while it loads, so the iframe itself may never intersect.
		if (!frame.hasAttribute('data-ghl-manual-load') && !frame.getAttribute('src')) io.observe(shell);
		// The placeholder (and the space it reserves) stays until the form is
		// actually in place. form_embed.js parks the iframe off-screen with
		// position:absolute while it boots, and the iframe's load event can fire
		// while it's still parked — releasing the reserved height then collapsed
		// the page for a beat and jumped it back (a large layout shift).
		const parked = () => frame.style.position === 'absolute';
		const revealed = () => !parked() && (frame.style.visibility === 'visible' || frame.style.opacity === '1');
		const done = () => {
			shell.classList.add('is-loaded');
			reveal.disconnect();
		};
		const reveal = new MutationObserver(() => {
			if (revealed()) done();
		});
		reveal.observe(frame, { attributes: true, attributeFilter: ['style'] });
		// Fallback for when form_embed.js never runs (blocked): the iframe then
		// renders unparked and its load event is the only signal. The grace
		// period lets a late-arriving form_embed.js (it's async) park the frame
		// first, in which case the observer above takes over.
		frame.addEventListener('load', () => {
			setTimeout(() => {
				if (!parked()) done();
			}, 2000);
		});
		// A primary form can be revealed before this script runs.
		if (revealed()) done();
	});
</script>

<style>
	/* Holds the form's space while form_embed.js has the iframe parked
	   off-screen, so nothing below jumps when it arrives. */
	.ghl-form-shell {
		position: relative;
		scroll-margin-top: calc(var(--header-height, 96px) + var(--space-6));
	}

	.ghl-form-shell:not(.is-loaded) {
		min-height: var(--ghl-form-height);
	}

	.ghl-form {
		position: relative;
		display: block;
		width: 100%;
		border: none;
		border-radius: var(--radius-md);
	}

	/* Sits behind the iframe (which form_embed.js keeps transparent until the
	   form is ready), so the slot reads as "arriving" rather than empty: a
	   quiet card the size of the form, with label and field bars. */
	.ghl-form-loading {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: clamp(1.5rem, 3vw, 2rem);
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		transition: opacity var(--dur-base) var(--ease-in-out-soft);
		pointer-events: none;
	}

	/* Gone entirely once the form is in (after the fade), so it can never
	   show through or around the loaded form. */
	.ghl-form-shell.is-loaded .ghl-form-loading {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--dur-base) var(--ease-in-out-soft),
			visibility 0s linear var(--dur-base);
	}

	.ghl-skeleton-field {
		display: grid;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.ghl-skeleton-label,
	.ghl-skeleton-input,
	.ghl-skeleton-submit {
		display: block;
		border-radius: var(--radius-sm);
		background: rgba(22, 16, 8, 0.06);
	}

	.ghl-skeleton-label {
		width: 32%;
		height: 0.75rem;
	}

	.ghl-skeleton-field:nth-of-type(3n + 2) .ghl-skeleton-label {
		width: 46%;
	}

	.ghl-skeleton-input {
		height: 3rem;
		border: 1px solid var(--color-border);
		background: var(--color-white);
	}

	.ghl-skeleton-submit {
		height: 3rem;
		margin-top: var(--space-8);
		background: rgba(150, 111, 56, 0.18);
	}

	/* A slow, low-contrast sheen so the card reads as loading, not broken. */
	.ghl-form-loading::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.45) 50%, transparent 70%);
		transform: translateX(-100%);
		animation: ghl-sheen 2.4s var(--ease-in-out-soft) infinite;
	}

	@keyframes ghl-sheen {
		to {
			transform: translateX(100%);
		}
	}

	.ghl-form-loading-bar {
		position: relative;
		display: block;
		height: 1px;
		overflow: hidden;
		background: var(--color-border);
	}

	.ghl-form-loading-bar::after {
		content: '';
		position: absolute;
		inset: 0;
		width: 40%;
		background: var(--color-accent);
		animation: ghl-loading 1.6s var(--ease-in-out-soft) infinite;
	}

	.ghl-form-loading-label {
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	@keyframes ghl-loading {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(250%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ghl-form-loading-bar::after {
			animation: none;
			width: 100%;
			opacity: 0.4;
		}
		.ghl-form-loading::after {
			display: none;
		}
	}
</style>
