---
// Site-wide popup for the GHL form. Any element with `data-ghl-form-open`
// opens it. Those CTAs keep their normal href (/schedule/, which has the form
// inline) so they still work without JS and on ctrl/cmd-click.
import GhlForm from './GhlForm.astro';
---

<dialog class="ghl-modal" data-ghl-modal aria-labelledby="ghl-modal-title">
	<div class="ghl-modal-panel">
		<button class="ghl-modal-close" type="button" data-ghl-modal-close aria-label="Close form">&times;</button>
		<span class="eyebrow">Private Consultation</span>
		<h2 id="ghl-modal-title">Design your living experience</h2>
		<p>Share a few details and a PROJECT: automate specialist will follow up to plan the right system for your home.</p>
		<GhlForm instance="popup" deferLoad />
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-ghl-modal]');

	// On pages where the form is the main content (/schedule/, /get-started/,
	// landing pages), a second copy in a popup only competes with it for
	// bandwidth. There, CTAs scroll to the page's own form and the popup is
	// never loaded.
	const primaryForm = document.querySelector<HTMLElement>('iframe[data-ghl-primary]')?.closest<HTMLElement>('[data-ghl-shell]');

	if (primaryForm) {
		document.addEventListener('click', (e) => {
			const trigger = (e.target as Element | null)?.closest?.('[data-ghl-form-open]');
			if (!trigger) return;
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			trigger.closest('[data-offcanvas]')?.querySelector<HTMLElement>('[data-menu-close]')?.click();
			// Through Lenis when it's running, so the two don't fight over the scroll.
			// Deferred a frame: Lenis's own click handler (stopInertiaOnNavigate) runs
			// after this one, sees a link to another path (/schedule/) and resets —
			// which would cancel a scroll started synchronously here.
			const lenis = (window as Window & { lenis?: { scrollTo: (el: Element) => void } }).lenis;
			requestAnimationFrame(() => {
				if (lenis) lenis.scrollTo(primaryForm);
				else primaryForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});
	}

	if (dialog && !primaryForm) {
		const frame = dialog.querySelector<HTMLIFrameElement>('iframe[data-src]');
		const load = () => {
			if (frame && !frame.getAttribute('src')) frame.src = frame.dataset.src!;
		};

		// Preload the popup's form in the background so it's already rendered
		// when a CTA is clicked. Waits for page load + an idle moment so it never
		// competes with the page itself. On Save-Data connections, skip the
		// background load and rely on the intent warm-up below instead.
		// Pages that mark themselves [data-ghl-no-preload] (the thank-you page,
		// reached right after a submission) rarely need the form again.
		const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
		const skipPreload = saveData || document.querySelector('[data-ghl-no-preload]') !== null;
		if (!skipPreload) {
			const preload = () =>
				'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1500);
			if (document.readyState === 'complete') preload();
			else window.addEventListener('load', preload, { once: true });
		}

		// Hover, keyboard focus or touch on a CTA is a strong signal a click is
		// coming — start loading then if the preload hasn't happened yet.
		const warmOnIntent = (e: Event) => {
			if ((e.target as Element | null)?.closest?.('[data-ghl-form-open]')) load();
		};
		['pointerover', 'focusin', 'touchstart'].forEach((type) =>
			document.addEventListener(type, warmOnIntent, { passive: true })
		);

		const open = () => {
			load();
			dialog.showModal();
		};

		document.addEventListener('click', (e) => {
			const trigger = (e.target as Element | null)?.closest?.('[data-ghl-form-open]');
			if (!trigger) return;
			// Let modified clicks fall through to the href (open /schedule/ in a new tab).
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			// Opened from the mobile menu: close it so it isn't still open behind the form.
			trigger.closest('[data-offcanvas]')?.querySelector<HTMLElement>('[data-menu-close]')?.click();
			open();
		});

		dialog.querySelector('[data-ghl-modal-close]')?.addEventListener('click', () => dialog.close());

		// A click on the dialog element itself (not the panel) is a backdrop click.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	}
</script>

<style>
	.ghl-modal {
		width: min(720px, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		padding: 0;
		border: none;
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		color: var(--color-text);
		overflow-y: auto;
		overscroll-behavior: contain;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
	}

	/* Closed: rendered but invisible and off-screen instead of the default
	   display:none. The preloaded form needs real layout — inside a display:none
	   iframe its web fonts never apply and it sizes itself at the wrong width. */
	.ghl-modal:not([open]) {
		display: block;
		position: fixed;
		top: 0;
		left: -10000px;
		visibility: hidden;
		pointer-events: none;
	}

	.ghl-modal::backdrop {
		background: rgba(10, 10, 10, 0.7);
		backdrop-filter: blur(6px);
	}

	.ghl-modal[open] {
		animation: ghl-modal-in var(--dur-base) var(--ease-out-expo);
	}

	@keyframes ghl-modal-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ghl-modal[open] {
			animation: none;
		}
	}

	.ghl-modal-panel {
		position: relative;
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}

	.ghl-modal-close {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border: none;
		background: transparent;
		color: var(--color-text);
		font-size: 2rem;
		line-height: 1;
		border-radius: 50%;
		transition: background-color var(--dur-fast) var(--ease-in-out-soft);
	}

	.ghl-modal-close:hover {
		background: var(--color-surface-2);
	}

	.ghl-modal h2 {
		margin: 0 0 var(--space-3);
		padding-right: var(--space-12);
		font-size: var(--text-3xl);
		font-weight: var(--fw-medium);
		line-height: 1.25;
	}

	.ghl-modal p {
		margin: 0 0 var(--space-6);
		max-width: 34rem;
	}

	/* Stop the page scrolling behind the open popup. */
	:global(html:has(.ghl-modal[open])) {
		overflow: hidden;
	}
</style>
