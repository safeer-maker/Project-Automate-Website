---
// Necessary-cookies-only notice. The site sets no cookies of its own; the only
// ones come from GHL (form + visitor tracking). No marketing/advertising cookies
// are used, so there is nothing to opt into — this informs and records the
// acknowledgement.
//
// The acknowledgement is stored in `cookie-config=essential`, the first-party
// cookie GHL's form_embed.js reads (provider "ghl_cookie", set on GhlForm) —
// so the GHL form is also told: necessary only, marketing/analytics not granted.
// GHL accepts "essential" or "all"; we never write "all".
//
// Mounted at the top of <body> (BaseLayout) so "Got it" is an early Tab stop
// rather than the last one on the page; it's position: fixed either way.
import { withBase } from '../../lib/paths.ts';
---

<div class="cookie-notice" role="region" aria-label="Cookie notice" data-cookie-notice hidden>
	<p>
		<!-- Phones get one short line, so the notice is a slim bar rather than
		     a ~180px block over the hero's actions. -->
		<span class="cookie-long">
			We use only necessary cookies, set by our customer platform to run our inquiry forms and recognize
			returning visitors. No advertising or marketing cookies.
		</span>
		<span class="cookie-short">Necessary cookies only.</span>{' '}
		<a href={withBase('/privacy-policy/#cookies')}>Privacy Policy</a>
	</p>
	<button type="button" data-cookie-accept>Got it</button>
</div>

<script>
	const COOKIE = 'cookie-config';
	const notice = document.querySelector<HTMLElement>('[data-cookie-notice]');
	const hasChoice = document.cookie.split('; ').some((c) => c.startsWith(`${COOKIE}=`));

	if (notice && !hasChoice) {
		notice.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
			const secure = location.protocol === 'https:' ? '; Secure' : '';
			document.cookie = `${COOKIE}=essential; Max-Age=${60 * 60 * 24 * 365}; Path=/; SameSite=Lax${secure}`;
			notice.hidden = true;
		});

		// Anything marked [data-cookie-clear] (the homepage hero's actions and
		// film toggle) must not be covered on arrival. On phones, and on short
		// laptop screens like 1024x768, they sit exactly where the notice goes,
		// so there it waits for the first scroll (or key press) instead of
		// covering the first impression. Measured with the notice laid out for
		// a moment in the same task, so it never paints in between.
		const reveal = () => {
			notice.hidden = false;
			window.removeEventListener('scroll', reveal);
			window.removeEventListener('keydown', reveal);
		};
		const place = () => {
			notice.hidden = false;
			const box = notice.getBoundingClientRect();
			const covers = [...document.querySelectorAll('[data-cookie-clear]')].some((el) => {
				const r = el.getBoundingClientRect();
				return r.width > 0 && r.bottom > box.top && r.top < box.bottom && r.right > box.left && r.left < box.right;
			});
			if (covers) {
				notice.hidden = true;
				window.addEventListener('scroll', reveal, { passive: true });
				window.addEventListener('keydown', reveal);
			}
		};
		// Until it's dismissed, the notice sits over the bottom of the screen,
		// and the browser won't scroll a focused element it considers visible.
		// Nudge anything keyboard focus lands on out from under it.
		document.addEventListener('focusin', (e) => {
			if (notice.hidden) return;
			const target = e.target as Element | null;
			if (!target || notice.contains(target)) return;
			const box = notice.getBoundingClientRect();
			const r = target.getBoundingClientRect();
			if (r.bottom > box.top - 8 && r.top < box.bottom && r.right > box.left && r.left < box.right) {
				const delta = r.bottom - box.top + 24;
				// Through Lenis when it's running, or a glide still in progress
				// would carry the page straight back.
				const lenis = (window as Window & { lenis?: { scrollTo: (y: number, o?: { immediate?: boolean }) => void } }).lenis;
				if (lenis) lenis.scrollTo(window.scrollY + delta, { immediate: true });
				else window.scrollBy(0, delta);
			}
		});

		// After every page script has run (the hero's toggle is only unhidden
		// by its own script), so everything to keep clear is measurable.
		if (document.readyState === 'complete') place();
		else document.addEventListener('DOMContentLoaded', place, { once: true });
	}
</script>

<style>
	.cookie-notice {
		position: fixed;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		/* Above the sticky header (40), below the open mobile menu (50) so it never covers the menu's CTA. */
		z-index: 45;
		display: flex;
		align-items: center;
		gap: var(--space-4);
		max-width: 34rem;
		padding: var(--space-4) var(--space-6);
		background: var(--color-charcoal);
		color: var(--color-text-on-dark);
		border: 1px solid var(--color-border-on-dark);
		border-radius: var(--radius-md);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
		animation: cookie-in var(--dur-slow) var(--ease-out-expo);
	}

	.cookie-notice[hidden] {
		display: none;
	}

	@keyframes cookie-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cookie-notice {
			animation: none;
		}
	}

	.cookie-notice p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--color-text-on-dark-muted);
	}

	.cookie-short {
		display: none;
	}

	.cookie-notice a {
		color: var(--color-accent-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	/* A quiet outline rather than a bronze fill, so the notice's button never
	   competes with the page's own primary action (the hero's bronze CTA). */
	.cookie-notice button {
		flex-shrink: 0;
		min-height: 40px;
		padding: 0.5rem 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.45);
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--color-white);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		transition:
			border-color var(--dur-fast) var(--ease-in-out-soft),
			background-color var(--dur-fast) var(--ease-in-out-soft);
	}

	.cookie-notice button:hover {
		border-color: var(--color-accent-hover);
		background: rgba(255, 255, 255, 0.06);
	}

	.cookie-notice button:focus-visible,
	.cookie-notice a:focus-visible {
		outline: 2px solid var(--color-accent-hover);
		outline-offset: 2px;
	}

	/* Phones: one slim row, ~56px tall, hugging the bottom edge. */
	@media (max-width: 520px) {
		.cookie-notice {
			left: 0.5rem;
			right: 0.5rem;
			bottom: 0.5rem;
			gap: var(--space-3);
			padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
		}
		.cookie-long {
			display: none;
		}
		.cookie-short {
			display: inline;
		}
		.cookie-notice p {
			flex: 1;
			min-width: 0;
		}
		.cookie-notice button {
			padding-inline: 1rem;
		}
	}
</style>
