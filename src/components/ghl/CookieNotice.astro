---
// Necessary-cookies-only notice. The site sets no cookies of its own; the only
// ones come from GHL (form + visitor tracking). No marketing/advertising cookies
// are used, so there is nothing to opt into — this informs and records the
// acknowledgement.
//
// The acknowledgement is stored in `cookie-config=essential`, the first-party
// cookie GHL's form_embed.js reads (provider "ghl_cookie", set on GhlForm) —
// so the GHL form is also told: necessary only, marketing/analytics not granted.
// GHL accepts "essential" or "all"; we never write "all".
import { withBase } from '../../lib/paths.ts';
---

<div class="cookie-notice" role="region" aria-label="Cookie notice" data-cookie-notice hidden>
	<p>
		We use only necessary cookies, set by our customer platform to run our enquiry forms and recognise returning
		enquiries. No advertising or marketing cookies.{' '}
		<a href={withBase('/privacy-policy/#cookies')}>Privacy Policy</a>
	</p>
	<button type="button" data-cookie-accept>Got it</button>
</div>

<script>
	const COOKIE = 'cookie-config';
	const notice = document.querySelector<HTMLElement>('[data-cookie-notice]');
	const hasChoice = document.cookie.split('; ').some((c) => c.startsWith(`${COOKIE}=`));

	if (notice && !hasChoice) {
		notice.hidden = false;
		notice.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
			const secure = location.protocol === 'https:' ? '; Secure' : '';
			document.cookie = `${COOKIE}=essential; Max-Age=${60 * 60 * 24 * 365}; Path=/; SameSite=Lax${secure}`;
			notice.hidden = true;
		});
	}
</script>

<style>
	.cookie-notice {
		position: fixed;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		/* Above the sticky header (40), below the open mobile menu (50) so it never covers the menu's CTA. */
		z-index: 45;
		display: flex;
		align-items: center;
		gap: var(--space-4);
		max-width: 34rem;
		padding: var(--space-4) var(--space-6);
		background: var(--color-charcoal);
		color: var(--color-text-on-dark);
		border: 1px solid var(--color-border-on-dark);
		border-radius: var(--radius-md);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
		animation: cookie-in var(--dur-slow) var(--ease-out-expo);
	}

	.cookie-notice[hidden] {
		display: none;
	}

	@keyframes cookie-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cookie-notice {
			animation: none;
		}
	}

	.cookie-notice p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--color-text-on-dark-muted);
	}

	.cookie-notice a {
		color: var(--color-accent-hover);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.cookie-notice button {
		flex-shrink: 0;
		padding: 0.6rem 1.25rem;
		border: none;
		border-radius: var(--radius-sm);
		background: var(--color-accent);
		color: var(--color-white);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		transition: background-color var(--dur-fast) var(--ease-in-out-soft);
	}

	.cookie-notice button:hover {
		background: var(--color-accent-hover);
	}

	@media (max-width: 520px) {
		.cookie-notice {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
