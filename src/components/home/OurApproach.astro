---
const pillars = [
	{
		title: 'Control',
		description: 'Every system, every room answered with a single, intuitive gesture.',
	},
	{
		title: 'Atmosphere',
		description: 'Light, warmth and shade compose for the mood of every moment.',
	},
	{
		title: 'Audio Solutions',
		description: 'Immersive entertainment that blends beautifully into every living space.',
	},
	{
		title: 'Entertainment',
		description: 'Cinematic sound and vision, redefined for the architecture of your home.',
	},
];
---

<section class="section our-approach">
	<div class="container">
		<div class="heading">
			<span class="eyebrow">Our Approach</span>
			<h2>Technology that Elevates Everyday Life.</h2>
		</div>
		<ul class="pillars">
			{pillars.map((pillar) => (
				<li>
					<h3>{pillar.title}</h3>
					<p>{pillar.description}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.heading {
		max-width: 600px;
		margin-bottom: var(--space-12);
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-8);
	}

	.pillars li {
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-4);
	}

	.pillars h3 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-2);
	}

	.pillars p {
		margin: 0;
	}

	@media (max-width: 900px) {
		.pillars {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.pillars {
			grid-template-columns: 1fr;
		}
	}
</style>
