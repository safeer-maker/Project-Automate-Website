---
import { withBase } from '../../lib/paths.ts';
interface Props {
	/** Full-height video treatment, as used at the bottom of the homepage. */
	variant?: 'feature' | 'compact';
}

const { variant = 'compact' } = Astro.props;
---

<section class:list={['cta', `cta-${variant}`]}>
	{variant === 'feature' && (
		<div class="cta-media">
			<video
				class="cta-video"
				autoplay
				muted
				loop
				playsinline
				preload="none"
				poster={withBase('/images/home/hero/poster.webp')}
				aria-hidden="true"
				tabindex="-1"
			>
				<source src={withBase('/videos/hero.webm')} type="video/webm" />
				<source src={withBase('/videos/hero.mp4')} type="video/mp4" />
			</video>
			<span class="cta-scrim"></span>
		</div>
	)}

	<div class="page cta-inner">
		<h2>Design your<br />Living Experience</h2>
		<p>Intelligent technology, designed around your lifestyle.</p>
		<a class="cta-btn" href={withBase('/get-started/')}>Let&rsquo;s Talk</a>
	</div>
</section>

<style>
	.cta {
		position: relative;
		overflow: hidden;
		background: var(--color-charcoal);
		color: var(--color-text-on-dark);
	}

	.cta-compact {
		padding-block: clamp(3.5rem, 8vw, 6rem);
	}

	.cta-feature {
		min-height: 100vh;
		display: flex;
		align-items: center;
		background: var(--color-black);
	}

	.cta-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.cta-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.cta-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(10, 10, 10, 0.82) 0%, rgba(10, 10, 10, 0.45) 60%, rgba(10, 10, 10, 0.3) 100%);
	}

	.cta-inner {
		position: relative;
		z-index: 1;
	}

	.cta h2 {
		margin: 0 0 var(--space-4);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--color-text-on-dark);
	}

	.cta p {
		margin: 0 0 var(--space-6);
		max-width: 34rem;
		font-size: var(--text-body-lg);
		line-height: 1.6;
		color: var(--color-text-on-dark-muted);
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--color-accent-hover);
		color: var(--color-white);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.7rem 1.6rem;
		border-radius: var(--radius-sm);
		transition: background-color var(--transition-base);
	}

	.cta-btn:hover {
		background: var(--color-accent);
	}
</style>
