---
import Button from '../ui/Button.astro';
---

<section class="cta-banner">
	<div class="container">
		<h2>Design your Living Experience</h2>
		<p>Intelligent technology, designed around your lifestyle.</p>
		<div class="actions">
			<Button href="/get-started/" variant="primary" size="lg">Let's Talk</Button>
			<Button href="/budget-calculator/" variant="outline" size="lg">HTA Budget Calculator</Button>
		</div>
	</div>
</section>

<style>
	.cta-banner {
		padding-block: var(--space-24);
		text-align: center;
		background: linear-gradient(135deg, var(--color-charcoal), var(--color-navy));
		border-top: 1px solid var(--color-border-on-dark);
		color: var(--color-text-on-dark);
	}

	.cta-banner p {
		font-size: var(--text-lg);
		margin-bottom: var(--space-8);
		color: var(--color-text-on-dark-muted);
	}

	.actions {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}
</style>
