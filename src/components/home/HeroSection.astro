---
import { withBase } from '../../lib/paths.ts';
import { siteInfo } from '../../data/site.ts';

const phone = siteInfo.phones[1] ?? siteInfo.phones[0];
const phoneHref = `tel:${phone.replace(/[^0-9+]/g, '')}`;
---

<section class="hero">
	<div class="hero-media">
		<video
			class="hero-video"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			poster={withBase('/images/home/hero/poster.webp')}
			aria-hidden="true"
			tabindex="-1"
		>
			<source src={withBase('/videos/hero.webm')} type="video/webm" />
			<source src={withBase('/videos/hero.mp4')} type="video/mp4" />
		</video>
		<div class="hero-scrim"></div>
	</div>

	<div class="hero-inner">
		<h1 class="hero-title">
			<span>Tailored</span> <span>Luxury</span> <span>Technologies</span>
		</h1>
		<div class="hero-actions">
			<a class="hero-btn hero-btn-primary" href={withBase('/schedule/')}>Book a Consultation</a>
			<a class="hero-btn hero-btn-ghost" href={phoneHref}>Call Now: {phone}</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(10, 10, 10, 0.45) 0%,
			rgba(10, 10, 10, 0.15) 45%,
			rgba(10, 10, 10, 0.75) 100%
		);
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		padding-bottom: clamp(4rem, 9vh, 6.5rem);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
	}

	.hero-title {
		margin: 0 0 var(--space-6);
		font-size: clamp(2rem, 3.9vw, 3.5rem);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: 0.01em;
		color: var(--color-text-on-dark);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
	}

	.hero-title span {
		display: inline-block;
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	.hero-title span:nth-child(2) {
		animation-delay: 0.12s;
	}
	.hero-title span:nth-child(3) {
		animation-delay: 0.24s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.6em);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.7rem 1.4rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		white-space: nowrap;
		transition: background-color var(--transition-base), border-color var(--transition-base);
	}

	.hero-btn-primary {
		background: var(--color-accent-hover);
		color: var(--color-white);
	}
	.hero-btn-primary:hover {
		background: var(--color-accent);
	}

	.hero-btn-ghost {
		background: rgba(10, 10, 10, 0.55);
		color: var(--color-white);
		border-color: rgba(255, 255, 255, 0.55);
		backdrop-filter: blur(4px);
	}
	.hero-btn-ghost:hover {
		background: rgba(10, 10, 10, 0.8);
	}

	@media (max-width: 700px) {
		.hero-inner {
			align-items: flex-start;
			text-align: left;
		}
		.hero-actions {
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title span {
			animation: none;
		}
	}
</style>
