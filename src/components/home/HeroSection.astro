---
import Button from '../ui/Button.astro';
import { siteInfo } from '../../data/site.ts';

const primaryPhone = siteInfo.phones[1] ?? siteInfo.phones[0];
const primaryPhoneHref = `tel:${primaryPhone.replace(/[^0-9+]/g, '')}`;
---

<section class="hero">
	<div class="hero-video">
		<iframe
			src="https://www.youtube.com/embed/6pd_jC1O3xw?autoplay=1&mute=1&loop=1&playlist=6pd_jC1O3xw&controls=0&showinfo=0&modestbranding=1&playsinline=1"
			title="PROJECT: automate background video"
			frameborder="0"
			allow="autoplay; encrypted-media"
			loading="lazy"
		></iframe>
		<div class="hero-overlay"></div>
	</div>

	<div class="container hero-content">
		<span class="eyebrow">Tailored Luxury Technologies</span>
		<h1>Tailored Luxury Technology Systems Designed for Your Lifestyle</h1>
		<p>
			Integrated technology, thoughtfully designed to make luxury homes more intuitive,
			comfortable, connected, and effortless.
		</p>
		<div class="hero-actions">
			<Button href="/schedule/" variant="primary" size="lg">Book a Consultation</Button>
			<Button href={primaryPhoneHref} variant="outline" size="lg">Call Now: {primaryPhone}</Button>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 92vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-video iframe {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 100vw;
		height: 56.25vw; /* 16:9 */
		min-height: 100vh;
		min-width: 177.78vh; /* 16:9 */
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(10, 10, 10, 0.3) 0%, rgba(10, 10, 10, 0.55) 55%, rgba(10, 10, 10, 0.92) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		padding-block: var(--space-32) var(--space-24);
		max-width: 760px;
		color: var(--color-text-on-dark);
	}

	.hero-content p {
		color: var(--color-text-on-dark-muted);
	}

	.hero-content h1 {
		font-size: var(--text-6xl);
		margin-bottom: var(--space-6);
	}

	.hero-content p {
		font-size: var(--text-lg);
		max-width: 560px;
		margin-bottom: var(--space-8);
	}

	.hero-actions {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	@media (max-width: 700px) {
		.hero-content h1 {
			font-size: var(--text-4xl);
		}
	}
</style>
