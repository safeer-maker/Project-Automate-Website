---
import Button from '../ui/Button.astro';

const badges = [
	{ src: '/images/badges/17-years-badge.webp', alt: '17+ Years in business badge' },
	{ src: '/images/badges/cedia-certified.webp', alt: 'CEDIA Smart Home Certified Expert Provider' },
	{ src: '/images/badges/cert-level-luxury.webp', alt: 'Certification Level: Luxury' },
	{ src: '/images/badges/hta-design-partner.webp', alt: 'HTA Design Partner' },
];
---

<section class="section trust">
	<div class="container trust-inner">
		<div class="trust-text">
			<span class="eyebrow">Why PROJECT: automate?</span>
			<h2>17+ Years of Smart Home Expertise</h2>
			<p>
				For more than two decades, PROJECT: automate has designed intelligent environments
				where technology feels effortless, reliable, and beautifully integrated.
			</p>
			<p>
				We begin with the way you live — not a list of products. Every system is carefully
				planned around your architecture, interior design, routines, and expectations.
			</p>
			<p>
				From lighting, shading, and entertainment to security, networking, and energy
				management, every element works together through one intuitive experience.
			</p>
			<p>
				Our relationship continues beyond installation. Through thoughtful refinement and
				ongoing support, we help ensure your home continues to perform exactly as it should.
			</p>
			<Button href="/about-us/" variant="outline" size="md">Why Us</Button>
		</div>
		<ul class="badges">
			{badges.map((badge) => (
				<li><img src={badge.src} alt={badge.alt} loading="lazy" width="140" height="140" /></li>
			))}
		</ul>
	</div>
</section>

<style>
	.trust-inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-12);
		flex-wrap: wrap;
	}

	.trust-text {
		max-width: 620px;
	}

	.trust-text h2 {
		margin-bottom: var(--space-6);
	}

	.badges {
		display: flex;
		gap: var(--space-8);
		flex-wrap: wrap;
	}

	.badges img {
		width: 90px;
		height: 90px;
		object-fit: contain;
		opacity: 0.9;
	}
</style>
