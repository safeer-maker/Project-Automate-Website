---
import { withBase } from '../../lib/paths.ts';
// Tile widths mirror the live site's asymmetric rows at 1440px:
// row 1: 464 / 732 · row 2: 708 / 488 · row 3: full · row 4: 488 / 708
const rows = [
	[
		{
			title: 'Security Solution',
			image: withBase('/images/home/experience/security.webp'),
			href: withBase('/security-systems/'),
			span: 38,
		},
		{
			title: 'Cinema Rooms & Media Spaces',
			image: withBase('/images/home/experience/cinema.webp'),
			href: withBase('/home-cinama/'),
			span: 60,
		},
	],
	[
		{
			title: 'Smart Home Automation',
			image: withBase('/images/home/experience/automation.webp'),
			href: withBase('/control-systems/'),
			span: 58,
		},
		{
			title: 'Lighting Control',
			image: withBase('/images/home/experience/lighting.webp'),
			href: withBase('/lighting-control-systems/'),
			span: 40,
		},
	],
	[
		{
			title: 'Audio Solutions',
			image: withBase('/images/home/experience/audio.webp'),
			href: withBase('/audio-video-solutions/'),
			span: 100,
		},
	],
	[
		{
			title: 'Energy Management',
			image: withBase('/images/home/experience/energy.webp'),
			href: withBase('/energy-moment/'),
			span: 40,
		},
		{
			title: 'Motorized Shades and Draperies',
			image: withBase('/images/home/experience/shades.webp'),
			href: withBase('/motorized-shades-and-drapery/'),
			span: 58,
		},
	],
];
---

<section class="experience">
	<div class="page">
		<span class="eyebrow">The Experience</span>
		<h2>Every system,<br />Working as one.</h2>

		<div class="tiles">
			{rows.map((row) => (
				<div
					class="row"
					style={`grid-template-columns:${row.map((t) => `${t.span}fr`).join(' ')}`}
				>
					{row.map((tile) => (
						<a class="tile" href={tile.href}>
							<img src={tile.image} alt="" loading="lazy" />
							<span class="tile-scrim"></span>
							<span class="tile-foot">
								<span class="tile-title">{tile.title}</span>
								<span class="tile-arrow" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
										<path d="M7 17L17 7M17 7H8M17 7v9" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
							</span>
						</a>
					))}
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.experience {
		background: var(--color-bg);
		padding-block: clamp(4rem, 9vw, 7.5rem);
	}

	.experience h2 {
		margin: 0 0 clamp(2rem, 5vw, 3.5rem);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.tiles {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.row {
		display: grid;
		gap: 1.25rem;
	}

	.tile {
		position: relative;
		display: block;
		height: clamp(260px, 33vw, 480px);
		border-radius: 20px;
		overflow: hidden;
		isolation: isolate;
	}

	.tile img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tile:hover img {
		transform: scale(1.04);
	}

	.tile-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.62) 100%);
	}

	.tile-foot {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: clamp(1rem, 2vw, 1.5rem);
	}

	.tile-title {
		font-size: var(--text-tile);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		color: var(--color-white);
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
	}

	.tile-arrow {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 39px;
		height: 39px;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.55);
		color: var(--color-white);
		transition: background-color var(--transition-base), border-color var(--transition-base);
	}

	.tile-arrow svg {
		width: 18px;
		height: 18px;
	}

	.tile:hover .tile-arrow {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	@media (max-width: 800px) {
		/* overrides the per-row inline grid-template-columns */
		.row {
			grid-template-columns: 1fr !important;
		}
	}
</style>
