---
import { withBase } from '../../lib/paths.ts';
const projects = [
	{
		location: 'Malibu - 2025',
		name: 'Oceanfront Villa',
		image: withBase('/images/home/inspiration/malibu.webp'),
	},
	{
		location: 'Hidden Hills - 2024',
		name: 'Marazul Estate',
		image: withBase('/images/home/inspiration/hidden-hills.webp'),
	},
	{
		location: 'Manhattan Beach - 2023',
		name: 'Alpine Retreat',
		image: withBase('/images/home/inspiration/manhattan-beach.webp'),
	},
];
---

<section class="inspiration">
	<div class="page">
		<div class="intro">
			<h2>Inspiration</h2>
			<p>Explore homes where technology enhances the way you live.</p>
		</div>

		<div class="grid">
			{projects.map((project) => (
				<a class="project" href={withBase('/get-inspired/')}>
					<div class="project-image">
						<img src={project.image} alt={`${project.name}, ${project.location}`} loading="lazy" width="405" height="364" />
					</div>
					<span class="location">{project.location}</span>
					<span class="name">
						{project.name}
						<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
							<path d="M7 17L17 7M17 7H8M17 7v9" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.inspiration {
		display: flex;
		align-items: center;
		min-height: 100vh;
		background: var(--color-bg);
		padding-block: clamp(4rem, 9vw, 7.5rem);
	}

	.inspiration > .page {
		width: 100%;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: center;
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
	}

	.intro h2 {
		margin: 0;
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.intro p {
		margin: 0;
		font-size: var(--text-body-lg);
		line-height: 1.6;
		color: var(--color-charcoal-2);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 1.8vw, 1.5rem);
	}

	.project {
		display: block;
	}

	.project-image {
		border-radius: 20px;
		overflow: hidden;
		margin-bottom: var(--space-4);
	}

	.project-image img {
		width: 100%;
		aspect-ratio: 405 / 364;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project:hover .project-image img {
		transform: scale(1.04);
	}

	.location {
		display: block;
		font-size: var(--text-sm);
		font-weight: var(--fw-medium);
		color: var(--color-text-muted);
		margin-bottom: var(--space-1);
	}

	.name {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-2xl);
		font-weight: var(--fw-medium);
		color: var(--color-text);
	}

	.arrow {
		width: 16px;
		height: 16px;
		color: var(--color-accent);
		transition: transform var(--transition-base);
	}

	.project:hover .arrow {
		transform: translate(3px, -3px);
	}

	@media (max-width: 900px) {
		.intro {
			grid-template-columns: 1fr;
			align-items: start;
		}
		.grid {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}
	}
</style>
