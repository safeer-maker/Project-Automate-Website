---
const steps = [
	{
		title: 'Understand',
		description:
			'We begin with your lifestyle, your space, and how you want your home to feel and function.',
		icon: '/images/home/process/step-1.webp',
	},
	{
		title: 'Design',
		description:
			'Every system is thoughtfully planned around the architecture, interior design, and requirements of your home.',
		icon: '/images/home/process/step-2.webp',
	},
	{
		title: 'Integrate',
		description:
			'Every system is installed, connected, and programmed with precision and minimal visual impact.',
		icon: '/images/home/process/step-3.webp',
	},
	{
		title: 'Refine',
		description:
			'We test, personalize, and fine-tune every detail until your complete experience feels effortless.',
		icon: '/images/home/process/step-4.webp',
	},
];
---

<section class="process">
	<div class="page">
		<span class="eyebrow">Our Process</span>

		<div class="intro">
			<h2>From Vision to<br />Effortless Living.</h2>
			<p>
				Every PROJECT: automate system begins with understanding how you live. From initial
				design through installation and ongoing support, every detail is carefully considered
				to create technology that feels natural, reliable, and beautifully integrated.
			</p>
		</div>

		<ol class="steps">
			{steps.map((step) => (
				<li>
					<img src={step.icon} alt="" width="165" height="146" loading="lazy" />
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.process {
		display: flex;
		align-items: center;
		min-height: 100vh;
		padding-block: clamp(4rem, 9vw, 7.5rem);
	}

	.process > .page {
		width: 100%;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
		margin-bottom: clamp(3rem, 7vw, 5.5rem);
	}

	.intro h2 {
		margin: 0;
		font-size: var(--text-display-lg);
		font-weight: var(--fw-bold);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.intro p {
		margin: 0;
		font-size: var(--text-body-lg);
		line-height: 1.6;
		color: var(--color-charcoal-2);
		max-width: 34rem;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1.5rem, 2.5vw, 2rem);
		list-style: none;
		counter-reset: step;
	}

	.steps li {
		display: flex;
		flex-direction: column;
	}

	.steps img {
		width: clamp(110px, 11vw, 165px);
		height: auto;
		margin-bottom: clamp(1.5rem, 4vw, 3.5rem);
	}

	.steps h3 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-step);
		font-weight: var(--fw-medium);
		line-height: 1.3;
		color: var(--color-text);
	}

	.steps p {
		margin: 0;
		font-size: var(--text-body-lg);
		line-height: 1.6;
		color: var(--color-charcoal-2);
	}

	@media (max-width: 900px) {
		.intro {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
		.steps {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-8);
		}
	}

	@media (max-width: 560px) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
