---
import PageLayout from './PageLayout.astro';
import Button from '../components/ui/Button.astro';

interface Props {
	title: string;
	description: string;
	heroImage: string;
	eyebrow: string;
	heroTitle: string;
	heroSubtitle?: string;
}

const { title, description, heroImage, eyebrow, heroTitle, heroSubtitle } = Astro.props;
---

<PageLayout title={title} description={description} image={heroImage}>
	<section class="service-hero">
		<img class="hero-bg" src={heroImage} alt="" loading="eager" />
		<div class="hero-overlay"></div>
		<div class="container hero-content">
			<span class="eyebrow">{eyebrow}</span>
			<h1>{heroTitle}</h1>
			{heroSubtitle && <p>{heroSubtitle}</p>}
			<Button href="/schedule/" variant="primary" size="lg">Schedule Consultation</Button>
		</div>
	</section>

	<slot />
</PageLayout>

<style>
	.service-hero {
		position: relative;
		min-height: 65vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(10, 10, 10, 0.35), rgba(10, 10, 10, 0.92));
	}

	.hero-content {
		position: relative;
		padding-block: var(--space-24) var(--space-16);
		max-width: 640px;
		color: var(--color-text-on-dark);
	}

	.hero-content p {
		font-size: var(--text-lg);
		margin-bottom: var(--space-8);
		color: var(--color-text-on-dark-muted);
	}
</style>
