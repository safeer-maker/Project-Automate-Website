---
import PageLayout from './PageLayout.astro';
import Button from '../components/ui/Button.astro';

interface Props {
	brandName: string;
	logo: string;
	heroImage: string;
	heroTitle: string;
	heroSubtitle?: string;
	description: string;
}

const { brandName, logo, heroImage, heroTitle, heroSubtitle, description } = Astro.props;
---

<PageLayout title={brandName} description={description} image={heroImage}>
	<section class="brand-hero">
		<img class="hero-bg" src={heroImage} alt="" loading="eager" />
		<div class="hero-overlay"></div>
		<div class="container hero-content">
			<img class="brand-logo" src={logo} alt={`${brandName} logo`} />
			<h1>{heroTitle}</h1>
			{heroSubtitle && <p>{heroSubtitle}</p>}
			<Button href="/schedule/" variant="primary" size="lg">Schedule Consultation</Button>
		</div>
	</section>

	<slot />
</PageLayout>

<style>
	.brand-hero {
		position: relative;
		min-height: 70vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(10, 10, 10, 0.35), rgba(10, 10, 10, 0.9));
	}

	.hero-content {
		position: relative;
		padding-block: var(--space-24) var(--space-16);
		max-width: 640px;
	}

	.brand-logo {
		height: 48px;
		width: auto;
		margin-bottom: var(--space-6);
		filter: brightness(0) invert(1);
	}

	.hero-content p {
		font-size: var(--text-lg);
		margin-bottom: var(--space-8);
	}
</style>
