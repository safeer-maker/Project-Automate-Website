---
import { withBase } from '../lib/paths.ts';
import { siteInfo, areaServed } from '../data/site.ts';
import PageLayout from './PageLayout.astro';
import Button from '../components/ui/Button.astro';

interface Props {
	brandName: string;
	/**
	 * The page's <title> without the brand suffix, e.g. "Savant Integrator in
	 * Los Angeles". Falls back to `brandName`, which on its own reads as a bare
	 * "Savant | PROJECT: automate" in search results.
	 */
	seoTitle?: string;
	/**
	 * A transparent wordmark, shown white over the hero. Omit it when the brand
	 * has no clean logo asset; the hero then carries a text eyebrow instead.
	 */
	logo?: string;
	/**
	 * For a dark logo on a solid white square (no transparency): inverts it and
	 * screen-blends it, so the white box drops out and only the mark shows.
	 */
	logoOnWhite?: boolean;
	/** Brand-supplied product imagery stays here (not the photo library). */
	heroImage: string;
	heroTitle: string;
	heroSubtitle?: string;
	/** Meta description, 140–160 characters. */
	description: string;
}

const { brandName, seoTitle, logo, logoOnWhite = false, heroImage, heroTitle, heroSubtitle, description } = Astro.props;

const site = Astro.site ?? new URL(siteInfo.url);
const pageUrl = new URL(Astro.url.pathname, site).toString();
const studioPhone = siteInfo.phones[0];

// One Service node per brand page (research-luxury-seo.md §D): the integration
// service, tied to the business node and naming the platform as its brand.
const schema = [
	{
		'@type': 'Service',
		'@id': `${pageUrl}#service`,
		name: `${brandName} Integration`,
		serviceType: `${brandName} smart home design, installation and support`,
		description,
		url: pageUrl,
		image: new URL(heroImage, site).toString(),
		brand: { '@type': 'Brand', name: brandName },
		provider: { '@id': 'https://projectautomate.com/#business' },
		areaServed,
		audience: {
			'@type': 'Audience',
			audienceType: 'Owners of luxury residences, architects, interior designers',
		},
	},
];
---

<PageLayout
	title={seoTitle ?? brandName}
	description={description}
	image={heroImage}
	imageAlt={`${brandName} smart home control in a luxury residence`}
	schema={schema}
	breadcrumbTitle={brandName}
>
	<section class="brand-hero">
		<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
		<div class="hero-media">
			<img class="hero-bg" src={heroImage} alt="" loading="eager" fetchpriority="high" decoding="sync" />
		</div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="container hero-content">
			{logo ? (
				<img class:list={['brand-logo', { 'brand-logo--on-white': logoOnWhite }]} src={logo} alt={`${brandName} logo`} />
			) : (
				<span class="eyebrow hero-eyebrow">{brandName} Integration</span>
			)}
			<h1>{heroTitle}</h1>
			{heroSubtitle && <p class="hero-subtitle">{heroSubtitle}</p>}
			<div class="hero-actions">
				<Button href={withBase('/schedule/')} data-ghl-form-open variant="primary" size="lg">Book a Private Consultation</Button>
				<a class="hero-phone" href={`tel:${studioPhone.replace(/[^\d+]/g, '')}`}>
					<span>or call the studio</span>
					{studioPhone}
				</a>
			</div>
		</div>
	</section>

	<slot />
</PageLayout>

<style>
	.brand-hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the hero image instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: clamp(540px, 80svh, 880px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
	}

	.hero-bg {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* One slow settle on arrival, never replayed — same as the solution pages. */
		animation: hero-settle 2400ms var(--ease-out-expo) both;
	}

	/* A light veil at the top keeps the transparent header legible; the deeper
	   fall-off at the bottom carries the logo and headline. */
	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0) 26%),
			linear-gradient(0deg, rgba(10, 10, 10, 0.88) 0%, rgba(10, 10, 10, 0.55) 40%, rgba(10, 10, 10, 0.1) 75%);
	}

	.hero-content {
		position: relative;
		padding-block: calc(var(--header-height, 96px) + var(--space-16)) clamp(3rem, 8vw, 6.5rem);
	}

	.hero-content > * {
		animation: hero-rise 1100ms var(--ease-out-expo) both;
	}
	.hero-content > :nth-child(2) {
		animation-delay: 90ms;
	}
	.hero-content > :nth-child(3) {
		animation-delay: 180ms;
	}
	.hero-content > :nth-child(4) {
		animation-delay: 270ms;
	}

	.brand-logo {
		height: clamp(32px, 3.4vw, 44px);
		width: auto;
		max-width: 220px;
		object-fit: contain;
		object-position: left center;
		margin-bottom: var(--space-8);
		filter: brightness(0) invert(1);
		opacity: 0.92;
	}

	/* Invert turns the white square black, and screen makes black transparent
	   over the hero; grayscale + brightness lift the mark to near-white. */
	.brand-logo--on-white {
		height: clamp(72px, 7.5vw, 104px);
		max-width: none;
		margin-block: calc(-1 * var(--space-4)) var(--space-4);
		margin-left: calc(-0.12 * clamp(72px, 7.5vw, 104px));
		filter: grayscale(1) invert(1) brightness(1.5);
		mix-blend-mode: screen;
		opacity: 1;
	}

	.hero-eyebrow {
		color: var(--color-gold-light);
		margin-bottom: var(--space-4);
	}

	.hero-content h1 {
		max-width: 20ch;
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text-on-dark);
		text-wrap: balance;
	}

	.hero-subtitle {
		max-width: 36rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-text-on-dark-muted);
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-8);
	}

	.hero-phone {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		color: var(--color-text-on-dark);
		transition: color var(--dur-fast) ease;
	}

	.hero-phone span {
		font-size: var(--text-xs);
		font-weight: var(--fw-regular);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
	}

	.hero-phone:hover,
	.hero-phone:focus-visible {
		color: var(--color-gold-light);
	}

	@keyframes hero-settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 600px) {
		.hero-content {
			padding-bottom: var(--space-12);
		}
		.hero-content h1 {
			margin-bottom: var(--space-4);
		}
		.hero-subtitle {
			font-size: var(--text-base);
			margin-bottom: var(--space-6);
		}
		.hero-actions :global(.btn) {
			width: 100%;
		}
		.hero-phone {
			flex-direction: row;
			align-items: baseline;
			gap: var(--space-2);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-bg,
		.hero-content > * {
			animation: none;
		}
	}
</style>
