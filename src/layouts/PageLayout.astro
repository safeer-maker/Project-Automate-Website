---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Bronze scroll-progress hairline in the header — blog posts and long solution pages only. */
	progress?: boolean;
}

const { title, description, image, progress = false } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
	<Header />
	<main data-progress-track={progress}>
		<slot />
	</main>
	<Footer />
</BaseLayout>
