---
import Seo from '../components/seo/Seo.astro';
import { siteInfo } from '../data/site.ts';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;

// LocalBusiness structured data — legalName is the registered entity
// (Project Automate Inc.), name/alternateName carry the public brand
// (PROJECT: automate) used everywhere else on the site.
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: siteInfo.name,
	legalName: siteInfo.legalName,
	alternateName: siteInfo.name,
	url: siteInfo.url,
	email: siteInfo.email,
	telephone: siteInfo.phones[0],
	address: {
		'@type': 'PostalAddress',
		streetAddress: siteInfo.address.line1,
		addressLocality: 'Manhattan Beach',
		addressRegion: 'CA',
		postalCode: '90266',
		addressCountry: 'US',
	},
	sameAs: siteInfo.social.map((s) => s.href),
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/webp" href="/images/logo/favicon.webp" />
		<meta name="generator" content={Astro.generator} />

		<link
			rel="preload"
			href="/fonts/manrope/manrope-latin-700-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/manrope/manrope-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<Seo title={title} description={description} image={image} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<slot />
	</body>
</html>
