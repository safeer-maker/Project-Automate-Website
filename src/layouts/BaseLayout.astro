---
import { withBase } from '../lib/paths.ts';
import Seo from '../components/seo/Seo.astro';
import { siteInfo } from '../data/site.ts';
import { ghl, ghlFormEmbedScript, ghlTrackingScript } from '../data/ghl.ts';
import GhlFormModal from '../components/ghl/GhlFormModal.astro';
import CookieNotice from '../components/ghl/CookieNotice.astro';
import '../styles/global.css';
// Imported (not public/) so Vite hashes them and applies the deploy base —
// these resolve to the same emitted files the @font-face rules reference.
import manrope400 from '../styles/fonts/manrope-latin-400-normal.woff2';
import manrope700 from '../styles/fonts/manrope-latin-700-normal.woff2';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;

// LocalBusiness structured data — legalName is the registered entity
// (Project Automate Inc.), name/alternateName carry the public brand
// (PROJECT: automate) used everywhere else on the site.
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: siteInfo.name,
	legalName: siteInfo.legalName,
	alternateName: siteInfo.name,
	url: siteInfo.url,
	email: siteInfo.email,
	telephone: siteInfo.phones[0],
	address: {
		'@type': 'PostalAddress',
		streetAddress: siteInfo.address.line1,
		addressLocality: 'Manhattan Beach',
		addressRegion: 'CA',
		postalCode: '90266',
		addressCountry: 'US',
	},
	sameAs: siteInfo.social.map((s) => s.href),
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/webp" href={withBase('/images/logo/favicon.webp')} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin />

		<Seo title={title} description={description} image={image} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<!-- Warm connections to the hosts the GHL form loads from, so the preloaded popup form starts fetching sooner. -->
		<link rel="preconnect" href="https://api.leadconnectorhq.com" />
		<link rel="preconnect" href="https://stcdn.leadconnectorhq.com" crossorigin />
		<link rel="preconnect" href="https://backend.leadconnectorhq.com" crossorigin />

		<!-- GoHighLevel: visitor tracking + form embed (sizing, consent hand-off). IDs live in src/data/ghl.ts. -->
		<script is:inline async src={ghlTrackingScript} data-tracking-id={ghl.trackingId}></script>
		<script is:inline defer src={ghlFormEmbedScript}></script>
	</head>
	<body>
		<slot />
		<GhlFormModal />
		<CookieNotice />
	</body>
</html>
