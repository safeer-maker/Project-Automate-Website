---
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths.ts';

// Legacy posts that no longer fit the brand (the budget-switch reviews
// research-luxury-seo.md singles out) carry `noindex: true` in their
// frontmatter: they stay reachable at their URLs but are left out of the
// Journal and the sitemap.
const posts = (
	await getCollection('blog', ({ data }) => !data.draft && !data.noindex)
).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const [latest, ...rest] = posts;

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="journal-intro">
	<div class="container intro-grid">
		<div class="intro-head">
			<span class="eyebrow">Insights</span>
			<h1>The Journal</h1>
		</div>
		<p class="intro-lede">
			Notes on lighting design, private cinema, motorized shading, security and whole-home
			control, from our Los Angeles studio.
		</p>
	</div>
</section>

{latest && (
	<section class="latest" aria-label="Latest article">
		<div class="container">
			<a class="latest-card" href={withBase(`/${latest.id}/`)}>
				<figure class="latest-media">
					<img
						src={withBase(latest.data.coverImage)}
						alt={latest.data.coverImageAlt}
						width="1200"
						height="800"
						fetchpriority="high"
						decoding="async"
					/>
				</figure>
				<div class="latest-copy">
					<span class="meta">
						{latest.data.category}
						<span aria-hidden="true">·</span>
						<time datetime={latest.data.publishDate.toISOString()}>{formatDate(latest.data.publishDate)}</time>
					</span>
					<h2>{latest.data.title}</h2>
					<p>{latest.data.excerpt}</p>
					<span class="read-link">
						Read the article
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
				</div>
			</a>
		</div>
	</section>
)}

{rest.length > 0 && (
	<section class="archive" aria-labelledby="archive-heading">
		<div class="container">
			<h2 id="archive-heading" class="archive-heading">More from the Journal</h2>
			<ul class="grid">
				{rest.map((post) => (
					<li>
						<a class="post" href={withBase(`/${post.id}/`)}>
							<figure class="post-media">
								<img
									src={withBase(post.data.coverImage)}
									alt={post.data.coverImageAlt}
									width="600"
									height="400"
									loading="lazy"
									decoding="async"
								/>
							</figure>
							<span class="meta">
								{post.data.category}
								<span aria-hidden="true">·</span>
								<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
							</span>
							<h3>{post.data.title}</h3>
							<p>{post.data.excerpt}</p>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
)}

<style>
	.journal-intro {
		padding-block: clamp(4rem, 10vw, 8rem) clamp(2.5rem, 6vw, 4.5rem);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: var(--space-6) clamp(2rem, 6vw, 6rem);
		align-items: end;
	}

	.intro-head h1 {
		margin: 0;
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.intro-lede {
		margin: 0;
		max-width: 32rem;
		font-size: var(--text-body-lg);
		line-height: 1.65;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.meta time {
		color: var(--color-text-muted);
	}

	/* ---- Latest ---- */

	.latest {
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}

	.latest-card {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
		padding-bottom: clamp(4rem, 9vw, 7rem);
		border-bottom: 1px solid var(--color-border);
	}

	.latest-media,
	.post-media {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-md);
		aspect-ratio: 3 / 2;
		background: var(--color-surface);
	}

	.latest-media img,
	.post-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1200ms var(--ease-out-expo);
	}

	.latest-copy h2 {
		margin: 0 0 var(--space-4);
		font-size: var(--text-display-sm);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--color-text);
		text-wrap: balance;
		transition: color var(--dur-fast) ease;
	}

	.latest-copy p {
		max-width: 30rem;
		margin-bottom: var(--space-8);
		line-height: 1.7;
	}

	.read-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding-bottom: var(--space-1);
		border-bottom: 1px solid currentColor;
		font-weight: var(--fw-medium);
		color: var(--color-accent);
	}

	.read-link svg {
		width: 18px;
		height: 18px;
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.latest-card:hover h2,
	.latest-card:focus-visible h2,
	.post:hover h3,
	.post:focus-visible h3 {
		color: var(--color-accent);
	}

	.latest-card:hover img,
	.latest-card:focus-visible img,
	.post:hover img,
	.post:focus-visible img {
		transform: scale(1.03);
	}

	.latest-card:hover .read-link svg,
	.latest-card:focus-visible .read-link svg {
		transform: translateX(5px);
	}

	/* ---- Archive ---- */

	.archive {
		padding-bottom: clamp(4.5rem, 10vw, 8.5rem);
	}

	.archive-heading {
		margin: 0 0 clamp(2rem, 4vw, 3rem);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(3rem, 5vw, 4rem) clamp(1.25rem, 2.5vw, 2rem);
	}

	.post {
		display: block;
	}

	.post-media {
		margin-bottom: var(--space-6);
	}

	.post h3 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
		font-weight: var(--fw-medium);
		line-height: 1.35;
		color: var(--color-text);
		text-wrap: pretty;
		transition: color var(--dur-fast) ease;
	}

	.post p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 1000px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 900px) {
		.intro-grid,
		.latest-card {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.latest-media img,
		.post-media img,
		.read-link svg {
			transition: none;
		}
	}
</style>
