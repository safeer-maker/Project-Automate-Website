---
// Branded 404. Cloudflare serves the built dist/404.html for any unknown path
// (wrangler.jsonc → not_found_handling: "404-page"); in dev Astro renders it
// for unmatched routes. Kept out of search and out of the sitemap.
import PageLayout from '../layouts/PageLayout.astro';
import Picture from '../components/ui/Picture.astro';
import Button from '../components/ui/Button.astro';
import { withBase } from '../lib/paths.ts';
import { libraryEntry, ogImageUrl } from '../lib/images.ts';
import { coreServices } from '../data/nav.ts';
import { siteInfo } from '../data/site.ts';

const phone = siteInfo.phones[0];
const phoneHref = `tel:+1${phone.replace(/\D/g, '')}`;

// The hero box is ~92vh tall (88vh on phones), so under object-fit: cover
// the ultra-wide photo renders at height x aspect, far wider than 100vw.
const heroEntry = libraryEntry('residences/stone-estate-wide');
const heroAspect = heroEntry.width / heroEntry.height;
const heroSizes = [
	`(max-width: 800px) ${Math.round(88 * heroAspect)}vh`,
	`(min-aspect-ratio: ${Math.round(92 * heroAspect)}/100) 100vw`,
	`${Math.round(92 * heroAspect)}vh`,
].join(', ');

const moreLinks = [
	{ label: 'About Us', href: withBase('/about-us/') },
	{ label: 'Success Stories', href: withBase('/success-stories/') },
	{ label: 'Design Partners', href: withBase('/design-partners/') },
	{ label: 'The Journal', href: withBase('/blog/') },
];
---

<PageLayout
	title="Page Not Found"
	description="The page you were looking for has moved or no longer exists. Explore our solutions for Los Angeles residences, or arrange a private consultation."
	image={ogImageUrl('residences/stone-estate-wide')}
	noindex
>
	<section class="lost" aria-labelledby="lost-title">
		<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
		<div class="lost-media" aria-hidden="true">
			<Picture id="residences/stone-estate-wide" alt="" sizes={heroSizes} priority />
		</div>
		<div class="lost-veil" aria-hidden="true"></div>

		<div class="page lost-inner">
			<div class="lost-copy">
				<span class="eyebrow">Page not found</span>
				<h1 id="lost-title">This page is no longer here.</h1>
				<p class="lede">The link may be out of date, or the page has moved. Everything you came for is only a step away.</p>
				<div class="actions">
					<Button href={withBase('/schedule/')} data-ghl-form-open variant="primary" size="lg">Book a Private Consultation</Button>
					<a class="text-link" href={withBase('/')}>Return to the homepage <span aria-hidden="true">&rarr;</span></a>
				</div>
			</div>
			<span class="lost-code" aria-hidden="true">404</span>
		</div>
	</section>

	<section class="explore page" aria-labelledby="explore-title">
		<div class="explore-intro">
			<span class="eyebrow">Continue exploring</span>
			<h2 id="explore-title">Our solutions</h2>
			<p>Lighting, shading, cinema, audio and security, designed as one quiet system for the way you live.</p>
		</div>

		<nav class="explore-body" aria-label="Solutions">
			<ol class="solutions">
				{coreServices.map((service, i) => (
					<li>
						<a href={service.href}>
							<span class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<span class="label">{service.label}</span>
							<span class="arrow" aria-hidden="true">&rarr;</span>
						</a>
					</li>
				))}
			</ol>

			<div class="more">
				<p class="more-title">Or visit</p>
				<ul class="more-links">
					{moreLinks.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
				<p class="more-call">
					Prefer to speak with us? Call the studio at <a href={phoneHref}>{phone}</a>.
				</p>
			</div>
		</nav>
	</section>
</PageLayout>

<style>
	/* ── Hero: the estate at dusk, tucked behind the transparent header ── */
	.lost {
		position: relative;
		/* Same overlap as the service heroes, so the header reads over the photo. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: min(92svh, 860px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-charcoal);
		color: var(--color-text-on-dark);
	}

	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.lost-media {
		position: absolute;
		inset: 0;
	}

	.lost-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* The ultra-wide frame keeps its glowing façade in view on narrow screens. */
		object-position: 55% 50%;
		animation: settle 2400ms var(--ease-out-expo) both;
	}

	/* Heavier at the base where the copy sits; the top stays dark enough for the header. */
	.lost-veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.1) 32%, rgba(10, 10, 10, 0.35) 58%, rgba(10, 10, 10, 0.88) 100%),
			linear-gradient(90deg, rgba(10, 10, 10, 0.6) 0%, rgba(10, 10, 10, 0.2) 45%, rgba(10, 10, 10, 0) 70%);
	}

	.lost-inner {
		position: relative;
		width: 100%;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-12);
		padding-block: calc(var(--header-height, 96px) + var(--space-24)) var(--space-24);
	}

	.lost-copy {
		max-width: 36rem;
		animation: rise 1100ms var(--ease-out-expo) 150ms both;
	}

	/* Gold lifted towards white: plain gold over the photograph fell short
	   of 4.5:1 for small caps. */
	.lost-copy .eyebrow {
		color: color-mix(in srgb, var(--color-gold-light) 68%, var(--color-white));
	}

	.lost h1 {
		font-size: var(--text-display-lg);
		line-height: 1.08;
		letter-spacing: -0.01em;
		margin-bottom: var(--space-6);
		text-wrap: balance;
	}

	.lede {
		font-size: var(--text-body-lg);
		line-height: 1.7;
		color: var(--color-text-on-dark-muted);
		max-width: 30rem;
		margin-bottom: var(--space-12);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-6) var(--space-8);
	}

	.text-link {
		display: inline-flex;
		gap: var(--space-2);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.02em;
		color: var(--color-text-on-dark);
		padding-block: var(--space-2);
		border-bottom: 1px solid var(--color-border-on-dark);
		transition:
			color var(--dur-fast) var(--ease-out-expo),
			border-color var(--dur-fast) var(--ease-out-expo);
	}

	.text-link:hover,
	.text-link:focus-visible {
		color: var(--color-gold-light);
		border-color: currentColor;
	}

	/* A quiet numeral, not a shout: thin outline, low contrast. */
	.lost-code {
		font-size: clamp(5rem, 13vw, 11rem);
		font-weight: var(--fw-extrabold);
		line-height: 0.8;
		letter-spacing: -0.03em;
		color: transparent;
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.28);
		user-select: none;
		animation: rise 1400ms var(--ease-out-expo) 350ms both;
	}

	/* ── Continue exploring ── */
	.explore {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: var(--space-16);
		padding-block: var(--space-32);
	}

	.explore-intro h2 {
		font-size: var(--text-display-md);
		letter-spacing: -0.01em;
		margin-bottom: var(--space-6);
	}

	.explore-intro p {
		font-size: var(--text-body-lg);
		line-height: 1.7;
		max-width: 22rem;
	}

	.solutions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--space-12);
		border-bottom: 1px solid var(--color-border);
	}

	.solutions li {
		border-top: 1px solid var(--color-border);
	}

	.solutions a {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		align-items: baseline;
		gap: var(--space-3);
		padding-block: var(--space-6);
		transition: color var(--dur-base) var(--ease-out-expo);
	}

	/* Small bronze type on cream takes the darker text bronze (4.75:1). */
	.index {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		color: var(--color-bronze-text);
	}

	.label {
		font-size: var(--text-lg);
		font-weight: var(--fw-semibold);
		line-height: 1.35;
	}

	.arrow {
		color: var(--color-accent);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--dur-base) var(--ease-out-expo),
			transform var(--dur-base) var(--ease-out-expo);
	}

	.solutions a:hover,
	.solutions a:focus-visible {
		color: var(--color-bronze-text);
	}

	.solutions a:hover .arrow,
	.solutions a:focus-visible .arrow {
		opacity: 1;
		transform: none;
	}

	.more {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-3) var(--space-8);
		margin-top: var(--space-12);
	}

	.more-title {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.more-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-8);
	}

	.more-links a,
	.more-call a {
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 2px;
		transition:
			color var(--dur-fast) var(--ease-out-expo),
			border-color var(--dur-fast) var(--ease-out-expo);
	}

	.more-links a:hover,
	.more-links a:focus-visible,
	.more-call a:hover,
	.more-call a:focus-visible {
		color: var(--color-bronze-text);
		border-color: currentColor;
	}

	.more-call {
		flex-basis: 100%;
		margin: var(--space-6) 0 0;
		font-size: var(--text-sm);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}

	@keyframes settle {
		from {
			transform: scale(1.06);
		}
	}

	@media (max-width: 1024px) {
		.explore {
			grid-template-columns: 1fr;
			gap: var(--space-12);
			padding-block: var(--space-24);
		}

		.explore-intro p {
			max-width: 34rem;
		}
	}

	@media (max-width: 800px) {
		.lost {
			min-height: min(88svh, 760px);
		}

		/* The copy spans the full width here, so the veil evens out behind it.
		   Measured from the bottom, because that is where the copy is anchored:
		   the eyebrow tops out ~28rem up, over the lit windows, and the veil
		   holds ~0.72 to just above it before easing back for the header. */
		.lost-veil {
			background: linear-gradient(
				0deg,
				rgba(10, 10, 10, 0.92) 0%,
				rgba(10, 10, 10, 0.72) 30rem,
				rgba(10, 10, 10, 0.45) 40rem,
				rgba(10, 10, 10, 0.6) 100%
			);
		}

		.lost-inner {
			padding-block: calc(var(--header-height, 80px) + var(--space-16)) var(--space-16);
		}

		.lost-code {
			display: none;
		}

		.lede {
			margin-bottom: var(--space-8);
		}

		.solutions {
			grid-template-columns: 1fr;
		}

		.solutions a {
			padding-block: var(--space-4);
		}

		/* No hover on touch: keep the arrow as a visible affordance. */
		.arrow {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 480px) {
		.actions :global(.btn) {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lost-media :global(img),
		.lost-copy,
		.lost-code {
			animation: none;
		}

		.arrow {
			transition: none;
		}
	}
</style>
