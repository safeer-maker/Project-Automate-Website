---
import { withBase } from '../../lib/paths.ts';
import { siteInfo } from '../../data/site.ts';
import Button from '../../components/ui/Button.astro';

const studioPhone = siteInfo.phones[0];
---

<section class="closing-cta" aria-labelledby="closing-heading">
	<div class="container closing-inner">
		<span class="eyebrow">Private Consultation</span>
		<h2 id="closing-heading">Turn a range into a considered plan.</h2>
		<p>Our team will refine your estimate into a detailed, buildable proposal, shaped around the residence and the way you live.</p>
		<div class="closing-actions">
			<Button href={withBase('/schedule/')} data-ghl-form-open variant="primary" size="lg">Book a Private Consultation</Button>
			<a class="closing-phone" href={`tel:${studioPhone.replace(/[^\d+]/g, '')}`}>
				<span>or call the studio</span>
				{studioPhone}
			</a>
		</div>
	</div>
</section>

<style>
	.closing-cta {
		padding-block: clamp(4.5rem, 10vw, 7.5rem);
		background: var(--color-charcoal);
		color: var(--color-text-on-dark);
	}

	.closing-inner .eyebrow {
		color: var(--color-gold-light);
	}

	h2 {
		max-width: 20ch;
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-text-on-dark);
		text-wrap: balance;
	}

	p {
		max-width: 36rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-text-on-dark-muted);
	}

	.closing-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-8);
	}

	.closing-phone {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		font-weight: var(--fw-medium);
		color: var(--color-text-on-dark);
		transition: color var(--dur-fast) ease;
	}

	.closing-phone span {
		font-size: var(--text-xs);
		font-weight: var(--fw-regular);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
	}

	.closing-phone:hover {
		color: var(--color-gold-light);
	}

	@media (max-width: 600px) {
		.closing-actions :global(.btn) {
			width: 100%;
		}

		.closing-phone {
			flex-direction: row;
			align-items: baseline;
			gap: var(--space-2);
		}
	}
</style>
