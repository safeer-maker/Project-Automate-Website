---
import { withBase } from '../../lib/paths.ts';

// Tier definitions and per-system base costs below are an estimated planning model built by
// PROJECT: automate for this client-side calculator. The original site embedded a third-party
// HTA (Home Technology Association) iframe tool at htacertified.org that does not expose its
// underlying figures, so no real numeric ranges could be sourced. Tier framing follows the real
// "Infrastructure / Experience / Protection" pillars used on the source page's "What HTA
// Considers" section; the dollar figures themselves are reasonable estimates, not sourced data.
const tiers = [
	{
		value: 'foundation',
		label: 'Foundation',
		description: 'Essential whole-home control and lighting, built on professionally engineered infrastructure.',
		multiplier: 0.7,
		sqftRate: 4,
		perRoom: 900,
	},
	{
		value: 'elevated',
		label: 'Elevated',
		description: 'Expanded automation, entertainment and comfort, layered onto a robust foundation.',
		multiplier: 1,
		sqftRate: 9,
		perRoom: 1800,
	},
	{
		value: 'ultra-luxury',
		label: 'Ultra-Luxury',
		description: 'Fully bespoke, estate-level integration by an HTA-certified team, with long-term white-glove support.',
		multiplier: 1.6,
		sqftRate: 18,
		perRoom: 3500,
	},
];

// One entry per PROJECT: automate discipline. Labels follow the site's solution
// names; the values stay stable so the estimate model above is unaffected.
const systems = [
	{ value: 'control-systems', label: 'Whole-Home Control', base: 12000 },
	{ value: 'security-systems', label: 'Security & Access', base: 9000 },
	{ value: 'lighting', label: 'Lighting Control', base: 7500 },
	{ value: 'outdoor-living', label: 'Outdoor Living', base: 8500 },
	{ value: 'home-cinema', label: 'Private Cinema', base: 15000 },
	{ value: 'audio-video', label: 'Audio & Video', base: 10000 },
	{ value: 'motorized-shades', label: 'Motorized Shades & Drapery', base: 6500 },
	{ value: 'energy-management', label: 'Energy Management', base: 5500 },
];

const defaultSystems = ['control-systems', 'lighting', 'security-systems'];
---

<section class="calculator" id="calculator" aria-label="Investment calculator">
	<div class="container calculator-grid">
		<form class="calc-inputs" onsubmit="return false">
			<div class="field">
				<div class="field-head">
					<label for="sqft-range">Residence size</label>
					<output id="sqft-value" for="sqft-range">6,000 sq ft</output>
				</div>
				<input type="range" id="sqft-range" min="2000" max="20000" step="500" value="6000" />
				<div class="range-scale" aria-hidden="true"><span>2,000</span><span>20,000 sq ft</span></div>
			</div>

			<div class="field">
				<div class="field-head">
					<label for="rooms-range">Rooms and zones</label>
					<output id="rooms-value" for="rooms-range">8 rooms</output>
				</div>
				<input type="range" id="rooms-range" min="1" max="25" step="1" value="8" />
				<div class="range-scale" aria-hidden="true"><span>1</span><span>25 rooms</span></div>
			</div>

			<div class="field">
				<label for="tier-select">Experience level</label>
				<div class="select-wrap">
					<select id="tier-select" aria-describedby="tier-description">
						{tiers.map((tier) => (
							<option value={tier.value} selected={tier.value === 'elevated'}>{tier.label}</option>
						))}
					</select>
				</div>
				<p class="tier-description" id="tier-description"></p>
			</div>

			<fieldset class="field">
				<legend>Systems</legend>
				<div class="systems-grid">
					{systems.map((system) => (
						<label class="system-checkbox">
							<input type="checkbox" name="systems" value={system.value} checked={defaultSystems.includes(system.value)} />
							<span>{system.label}</span>
						</label>
					))}
				</div>
			</fieldset>
		</form>

		<div class="calc-result" aria-live="polite">
			<span class="eyebrow result-eyebrow">Estimated Planning Range</span>
			{/* Set as two labelled lines: real ranges rarely fit one line in the card,
			    and a wrapped "low – high" leaves the dash hanging. */}
			<dl class="result-range">
				<div><dt>From</dt><dd id="estimate-low">$0</dd></div>
				<div><dt>To</dt><dd id="estimate-high">$0</dd></div>
			</dl>
			<ul class="breakdown">
				<li><span>Infrastructure &amp; wiring</span><span id="breakdown-infrastructure">$0</span></li>
				<li><span>Room &amp; zone integration</span><span id="breakdown-rooms">$0</span></li>
				<li><span>Selected systems</span><span id="breakdown-systems">$0</span></li>
			</ul>
			<p class="disclaimer">
				A planning estimate only, not a formal proposal. <a href={withBase('/schedule/')} data-ghl-form-open>Book a private consultation</a> for a detailed, buildable proposal.
			</p>
		</div>
	</div>
</section>

<script define:vars={{ tiers, systems }}>
	const sqftRange = document.getElementById('sqft-range');
	const roomsRange = document.getElementById('rooms-range');
	const tierSelect = document.getElementById('tier-select');
	const tierDescription = document.getElementById('tier-description');
	const systemCheckboxes = document.querySelectorAll('input[name="systems"]');

	const sqftValue = document.getElementById('sqft-value');
	const roomsValue = document.getElementById('rooms-value');
	const estimateLow = document.getElementById('estimate-low');
	const estimateHigh = document.getElementById('estimate-high');
	const breakdownInfrastructure = document.getElementById('breakdown-infrastructure');
	const breakdownRooms = document.getElementById('breakdown-rooms');
	const breakdownSystems = document.getElementById('breakdown-systems');

	function formatCurrency(value) {
		return '$' + Math.round(value).toLocaleString('en-US');
	}

	function roundTo(value, step) {
		return Math.round(value / step) * step;
	}

	// The bronze fill on the slider track follows the thumb (see --fill in the CSS).
	function paintRange(input) {
		const min = Number(input.min);
		const max = Number(input.max);
		const pct = ((Number(input.value) - min) / (max - min)) * 100;
		input.style.setProperty('--fill', `${pct}%`);
	}

	function calculate() {
		const sqft = Number(sqftRange.value);
		const rooms = Number(roomsRange.value);
		const tier = tiers.find((t) => t.value === tierSelect.value) || tiers[0];

		sqftValue.textContent = `${sqft.toLocaleString('en-US')} sq ft`;
		roomsValue.textContent = `${rooms} room${rooms === 1 ? '' : 's'}`;
		tierDescription.textContent = tier.description;
		paintRange(sqftRange);
		paintRange(roomsRange);

		const infrastructure = sqft * tier.sqftRate;
		const roomIntegration = rooms * tier.perRoom;

		const selected = Array.from(systemCheckboxes).filter((cb) => cb.checked);
		const systemsTotal = selected.reduce((sum, cb) => {
			const system = systems.find((s) => s.value === cb.value);
			return sum + (system ? system.base * tier.multiplier : 0);
		}, 0);

		const total = infrastructure + roomIntegration + systemsTotal;
		const low = roundTo(total * 0.85, 500);
		const high = roundTo(total * 1.15, 500);

		estimateLow.textContent = formatCurrency(low);
		estimateHigh.textContent = formatCurrency(high);
		breakdownInfrastructure.textContent = formatCurrency(infrastructure);
		breakdownRooms.textContent = formatCurrency(roomIntegration);
		breakdownSystems.textContent = formatCurrency(systemsTotal);
	}

	sqftRange.addEventListener('input', calculate);
	roomsRange.addEventListener('input', calculate);
	tierSelect.addEventListener('change', calculate);
	systemCheckboxes.forEach((cb) => cb.addEventListener('change', calculate));

	calculate();
</script>

<style>
	.calculator {
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		padding-block: clamp(3.5rem, 8vw, 6.5rem);
	}

	.calculator-grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.calc-inputs {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 4vw, 2.75rem);
		margin: 0;
	}

	.field {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	.field label,
	.field legend {
		display: block;
		padding: 0;
		margin-bottom: var(--space-4);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.field-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-4);
	}

	.field-head label {
		margin-bottom: 0;
	}

	.field-head output {
		font-size: var(--text-xl);
		font-weight: var(--fw-medium);
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	/* ---- Range: hairline track, bronze fill, quiet round thumb ---- */

	input[type='range'] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 28px;
		margin: 0;
		background: transparent;
		cursor: pointer;
	}

	input[type='range']::-webkit-slider-runnable-track {
		height: 2px;
		border-radius: 2px;
		background: linear-gradient(
			to right,
			var(--color-accent) 0 var(--fill, 50%),
			var(--color-border) var(--fill, 50%) 100%
		);
	}

	input[type='range']::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 20px;
		height: 20px;
		margin-top: -9px;
		border-radius: 50%;
		background: var(--color-bg);
		border: 1.5px solid var(--color-accent);
		box-shadow: 0 1px 6px rgba(22, 16, 8, 0.14);
		transition: transform var(--dur-fast) ease;
	}

	input[type='range']:active::-webkit-slider-thumb {
		transform: scale(1.12);
	}

	input[type='range']::-moz-range-track {
		height: 2px;
		border-radius: 2px;
		background: var(--color-border);
	}

	input[type='range']::-moz-range-progress {
		height: 2px;
		border-radius: 2px;
		background: var(--color-accent);
	}

	input[type='range']::-moz-range-thumb {
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--color-bg);
		border: 1.5px solid var(--color-accent);
		box-shadow: 0 1px 6px rgba(22, 16, 8, 0.14);
	}

	input[type='range']:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 6px;
		border-radius: var(--radius-sm);
	}

	.range-scale {
		display: flex;
		justify-content: space-between;
		margin-top: var(--space-2);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	/* ---- Select ---- */

	.select-wrap {
		position: relative;
	}

	.select-wrap::after {
		content: '';
		position: absolute;
		right: var(--space-4);
		top: 50%;
		width: 8px;
		height: 8px;
		margin-top: -6px;
		border-right: 1.5px solid var(--color-accent);
		border-bottom: 1.5px solid var(--color-accent);
		transform: rotate(45deg);
		pointer-events: none;
	}

	select {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		padding: var(--space-4) var(--space-12) var(--space-4) var(--space-4);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		color: var(--color-text);
		cursor: pointer;
		transition: border-color var(--dur-fast) ease;
	}

	select:hover {
		border-color: rgba(22, 16, 8, 0.28);
	}

	select:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		border-color: var(--color-accent);
	}

	.tier-description {
		margin: var(--space-3) 0 0;
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	/* ---- Systems ---- */

	.systems-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--space-8);
	}

	.field .system-checkbox {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0;
		padding-block: var(--space-3);
		border-top: 1px solid var(--color-border);
		font-size: var(--text-base);
		font-weight: var(--fw-regular);
		letter-spacing: 0;
		text-transform: none;
		color: var(--color-text);
		cursor: pointer;
	}

	.system-checkbox input {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		margin: 0;
		accent-color: var(--color-accent);
		cursor: pointer;
	}

	/* ---- Result ---- */

	.calc-result {
		position: sticky;
		top: calc(var(--header-height, 96px) + var(--space-6));
		padding: clamp(1.75rem, 4vw, 2.75rem);
		background: var(--color-charcoal);
		border-radius: var(--radius-md);
		color: var(--color-text-on-dark);
	}

	.result-eyebrow {
		color: var(--color-gold-light);
	}

	.result-range {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-1) var(--space-4);
		margin: var(--space-4) 0 var(--space-8);
	}

	.result-range div {
		display: contents;
	}

	.result-range dt {
		min-width: 2.75rem;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
	}

	.result-range dd {
		margin: 0;
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-text-on-dark);
		font-variant-numeric: tabular-nums;
	}

	.breakdown {
		margin-bottom: var(--space-8);
		border-bottom: 1px solid var(--color-border-on-dark);
	}

	.breakdown li {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-top: 1px solid var(--color-border-on-dark);
		font-size: var(--text-sm);
		color: var(--color-text-on-dark-muted);
	}

	.breakdown li span:last-child {
		color: var(--color-text-on-dark);
		font-weight: var(--fw-semibold);
		font-variant-numeric: tabular-nums;
	}

	.disclaimer {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text-on-dark-muted);
	}

	.disclaimer a {
		color: var(--color-gold-light);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.disclaimer a:hover {
		color: var(--color-text-on-dark);
	}

	@media (max-width: 900px) {
		.calculator-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.calc-result {
			position: static;
		}
	}

	@media (max-width: 520px) {
		.systems-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		input[type='range']::-webkit-slider-thumb,
		select {
			transition: none;
		}
	}
</style>
