---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const capabilities = [
	{
		title: 'One Touch, Every Room',
		description:
			'Lights, shades, climate, music, video and security respond as one, from a touch panel, your phone, your voice or a custom keypad placed exactly where your hand expects it.',
		imageId: 'solutions/control-keypad',
		imageAlt: 'A finger resting on a minimalist wall keypad beside a softly lit living room',
	},
	{
		title: 'Scenes That Fit Your Day',
		description:
			'Morning, evening, entertaining, away. A single tap sets the light, the temperature, the shades and the music, exactly the way you like them.',
		imageId: 'solutions/control-touch',
		imageAlt: 'Hands on a wall-mounted home control touchscreen showing lighting, climate and security',
	},
	{
		title: 'Technology That Disappears',
		description:
			'Powerful never needs to feel complicated. Equipment is concealed within the architecture, and every interface is kept clean, reliable and effortless to use.',
		imageId: 'solutions/control-great-room',
		imageAlt: 'A bright great room with floor-to-ceiling windows and a slim control panel on the wall',
	},
] as const;

const scenes = [
	{ title: 'Morning', description: 'Lights rise, shades open and the house is ready before you are.' },
	{ title: 'Entertaining', description: 'One touch sets light, music and climate for an evening with guests.' },
	{ title: 'Relaxing', description: 'The room softens, the shades lower and a favorite playlist begins.' },
	{ title: 'Away', description: 'Lights, climate and access settle into place the moment you leave.' },
];
---

<ServiceLayout
	title="Whole-Home Control Systems, Los Angeles"
	description="One elegant interface for lighting, climate, shades, entertainment and security. Custom Savant, Crestron and Control4 home automation for Los Angeles estates."
	heroImageId="solutions/control-wall-panel"
	heroAlt="A slim touch panel set into a warm plaster wall, opening onto a serene, light-filled living room"
	heroPosition="30% 50%"
	eyebrow="Smart Home Automation"
	heroTitle="Whole-Home Control. One Touch, Every Room."
	heroSubtitle="Lighting, climate, shades, entertainment and security, drawn into one quiet interface designed around the way you live."
	intro="A whole-home control system connects the lighting, climate, shades, music, video and security so they work as one, for homeowners who would rather live in the house than operate it. We design it on Savant, Crestron or Control4, then keep the technology itself out of sight."
	serviceName="Whole-Home Control Systems"
	serviceType="Home automation and control system integration"
	serviceKey="control-systems"
>
	<CapabilityList eyebrow="Intuitive Control" title="One elegant interface for the entire residence." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="Technology that becomes part of the way you live." scenes={scenes} />

	<CtaBanner slot="closing" />
</ServiceLayout>
