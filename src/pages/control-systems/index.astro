---
import { withBase } from '../../lib/paths.ts';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const capabilities = [
	{
		title: 'One Touch, Every Room',
		description: 'Control your entire home from a single elegant interface — lights, shades, climate, audio, video, and security respond instantly through touch panels, mobile apps, voice commands, or custom keypads designed around the way you live.',
		image: withBase('/images/solutions/control-systems/feature-1.webp'),
	},
	{
		title: 'Scenes That Fit Your Day',
		description: 'Create effortless moments with personalized scenes for morning, evening, entertaining, relaxing, or away mode. With one tap, your home adjusts the lights, sets the temperature, lowers the shades, and starts the music.',
		image: withBase('/images/solutions/control-systems/feature-2.webp'),
	},
	{
		title: 'Technology That Disappears',
		description: 'The best smart home systems are powerful without feeling complicated. We integrate advanced technology quietly into the architecture of your home, keeping every system clean, reliable, and easy to use.',
		image: withBase('/images/solutions/control-systems/feature-3.webp'),
	},
];

const scenes = [
	{ title: 'Morning', description: 'Lights rise, shades open and the home prepares itself as the day begins.' },
	{ title: 'Entertaining', description: 'One tap sets lighting, music and climate to the perfect atmosphere for guests.' },
	{ title: 'Relaxing', description: 'The room softens, shades lower and your favorite playlist begins automatically.' },
	{ title: 'Away', description: 'Lights, climate and access settle into place the moment you leave for the day.' },
];
---

<ServiceLayout
	title="Control Systems"
	description="Custom smart home control systems from PROJECT: automate — one elegant interface connecting lighting, climate, shades, entertainment and security."
	heroImage={withBase('/images/solutions/control-systems/hero.webp')}
	eyebrow="Smart Living, Simplified"
	heroTitle="One Touch, Every Room"
	heroSubtitle="Custom smart home automation systems that connect lighting, climate, shades, entertainment, security and control into one seamless experience."
>
	<CapabilityList eyebrow="Intuitive Control" title="Control your entire home from a single elegant interface." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="Technology that becomes part of the way you live." scenes={scenes} />

	<section class="section power-system">
		<div class="container">
			<SectionHeading eyebrow="Seamless Integration" title="Design Your Living Experience" subtitle="Intelligent technology, designed around your lifestyle." align="center" />
		</div>
	</section>

	<CtaBanner />
</ServiceLayout>
