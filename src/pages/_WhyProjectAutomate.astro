---
// Trust: the studio, its founder and four facts. The numbers are rendered at
// their final values and simply fade in: a count-up reads as a software
// dashboard, and it left "0+" in the HTML for crawlers and no-JS visitors.
// The brand row (_LogoMarquee) follows directly and shares this background,
// so the two read as one chapter.
//
// The quote slot from the copy deck is intentionally absent: it needs a real,
// attributed architect or client quote, and none has been supplied.
import { withBase } from '../lib/paths.ts';

const stats = [
	{ value: '17+', label: 'Years of expertise' },
	{ value: '400+', label: 'Residences integrated' },
	{ value: '6', label: 'Manufacturer certifications' },
	{ value: '24/7', label: 'Concierge support' },
];
---

<section class="why" data-why aria-labelledby="why-title">
	<div class="page why-grid">
		<div class="why-copy">
			<span class="eyebrow">Why PROJECT: automate</span>
			<h2 id="why-title">Seventeen years of<br />getting it right, quietly.</h2>
			<p class="why-lede">
				Led by founder Joshua Trevithick, our Manhattan Beach studio has integrated more than 400 Los
				Angeles residences. We are CEDIA and Home Technology Association certified.
			</p>

			<dl class="stats">
				{stats.map((stat, i) => (
					<div class="stat" style={`--stat-index:${i}`}>
						<dt>{stat.label}</dt>
						<dd>{stat.value}</dd>
					</div>
				))}
			</dl>

			<a class="text-link" href={withBase('/about-us/')}>
				Meet the studio
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>

		<figure class="why-portrait">
			<div class="why-portrait-frame">
				<img
					src={withBase('/images/about-us/founder-joshua-trevithick.webp')}
					alt="Joshua Trevithick, Founder and CEO of PROJECT: automate"
					width="562"
					height="839"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<figcaption>
				<strong>Joshua Trevithick</strong>
				<span>Founder &amp; CEO</span>
			</figcaption>
		</figure>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-why]');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (section && !reduce && 'IntersectionObserver' in window) {
		section.setAttribute('data-armed', '');
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					section.classList.add('is-visible');
					io.disconnect();
				});
			},
			{ threshold: 0.25 }
		);
		io.observe(section);
	}
</script>

<style>
	.why {
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		padding-block: clamp(4.5rem, 10vw, 8.5rem) clamp(3.5rem, 7vw, 5.5rem);
	}

	.why-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.why h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.why-lede {
		margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
		max-width: 34rem;
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	/* Label under the figure visually, but the label is the <dt> so a screen
	   reader hears "Years of expertise: 17+". */
	.stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(1.25rem, 2.5vw, 2rem);
		margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
		padding: 0;
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: var(--space-2);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
	}

	.stat dd {
		margin: 0;
		font-size: clamp(2rem, 3.4vw, 3rem);
		font-weight: var(--fw-medium);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-accent);
		font-variant-numeric: tabular-nums;
	}

	.stat dt {
		margin: 0;
		max-width: 16ch;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		letter-spacing: 0.01em;
		color: var(--color-text);
		transition: color var(--dur-fast) var(--ease-in-out-soft);
	}

	.text-link svg {
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.text-link:hover {
		color: var(--color-bronze-text);
	}

	.text-link:hover svg {
		transform: translateX(4px);
	}

	.why-portrait {
		margin: 0;
	}

	.why-portrait-frame {
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-2);
	}

	.why-portrait img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		/* Anchored to the top: the crop takes from the bottom of the frame, so
		   his face is kept at every column width. */
		object-fit: cover;
		object-position: top;
	}

	.why-portrait figcaption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		padding-top: var(--space-4);
	}

	.why-portrait strong {
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		color: var(--color-text);
	}

	.why-portrait figcaption span {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		/* Small type on cream-alt: the text bronze clears 4.5:1, the brand bronze doesn't. */
		color: var(--color-bronze-text);
	}

	/* One-time fade: copy first, figures in a light stagger, portrait last. */
	.why[data-armed] .why-copy > :not(.stats),
	.why[data-armed] .stat,
	.why[data-armed] .why-portrait {
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity 1000ms var(--ease-out-expo),
			transform 1000ms var(--ease-out-expo);
	}

	.why[data-armed] .stat {
		transition-delay: calc(200ms + var(--stat-index) * 90ms);
	}

	.why[data-armed] .why-copy > .text-link {
		transition-delay: 560ms;
	}

	.why[data-armed] .why-portrait {
		transition-delay: 150ms;
	}

	.why[data-armed].is-visible .why-copy > :not(.stats),
	.why[data-armed].is-visible .stat,
	.why[data-armed].is-visible .why-portrait {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 1100px) {
		.stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: var(--space-8);
		}
	}

	@media (max-width: 899px) {
		.why-grid {
			grid-template-columns: 1fr;
		}
		/* Portrait first on narrow screens — a face outpulls a statistic. */
		.why-portrait {
			order: -1;
			max-width: 26rem;
		}
		.why-portrait img {
			aspect-ratio: 5 / 4;
		}
	}

	@media (max-width: 599px) {
		.why-portrait {
			max-width: none;
		}
	}
</style>
