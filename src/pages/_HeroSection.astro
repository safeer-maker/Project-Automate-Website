---
// Desktop sources are re-encoded from /videos/Homepage/project-automate-hero-1080.mp4,
// mobile sources from /videos/Homepage/project-automate-hero-720.mp4 (both raw
// source clips, kept for reference/regeneration). Poster is a still pulled from
// the desktop clip at 3s.
//
// mp4/H.264 is listed before webm/VP9 in every <source> group on purpose: the
// browser plays whichever source it hits first that it supports, it doesn't
// benchmark them, and VP9 has much patchier hardware-decode support than H.264
// across GPUs. Listing webm first was causing software-decoded VP9 stutter on
// otherwise capable machines. Resolution is also capped below source res
// (1600px desktop / 960px mobile) with a hard bitrate ceiling (-maxrate/-bufsize,
// or -b:v as a ceiling in VP9's constrained-quality mode) so there are no bitrate
// spikes the decoder has to catch up on.
//
// To regenerate after swapping the clip:
//   ffmpeg -i <clip> -vf scale=1600:-2 -r 30 -c:v libx264 -preset slow -crf 26 \
//     -maxrate 1800k -bufsize 3600k -g 60 -keyint_min 60 -pix_fmt yuv420p -an \
//     -movflags +faststart public/videos/hero.mp4
//   ffmpeg -i <clip> -vf scale=1600:-2 -r 30 -c:v libvpx-vp9 -crf 34 -b:v 1400k \
//     -maxrate 1400k -bufsize 2800k -g 60 -keyint_min 60 -row-mt 1 -tile-columns 2 \
//     -pix_fmt yuv420p -an public/videos/hero.webm
//   (repeat at scale=960:-2 for hero-mobile.mp4 crf 28/maxrate 900k, and
//   hero-mobile.webm crf 37/b:v 700k)
import { withBase } from "../lib/paths.ts";
---

<section class="hero">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<video
			class="hero-video"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			poster={withBase("/images/home/hero/poster.webp")}
			aria-hidden="true"
			tabindex="-1"
		>
			<source
				media="(max-width: 700px)"
				src={withBase("/videos/hero-mobile.mp4")}
				type="video/mp4"
			/>
			<source
				media="(max-width: 700px)"
				src={withBase("/videos/hero-mobile.webm")}
				type="video/webm"
			/>
			<source src={withBase("/videos/hero.mp4")} type="video/mp4" />
			<source src={withBase("/videos/hero.webm")} type="video/webm" />
		</video>
	</div>

	<div class="hero-inner">
		<div class="hero-box">
			<h1 class="hero-title">
				<span>Tailored Luxury</span>
				<span>Technologies</span>
			</h1>
			<p class="hero-lede">
				<span>Lighting, climate, sound and security,</span>
				<span>designed to work as one, and to disappear.</span>
			</p>
			<div class="hero-actions">
				<a
					class="hero-btn hero-btn-primary"
					href={withBase("/schedule/")}>Book a Consultation</a
				>
			</div>
		</div>
	</div>

	<div class="hero-cue" aria-hidden="true">
		<span class="hero-cue-line"></span>
	</div>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>('.hero-video');
	if (video) {
		// Slightly under real time. Almost subliminal, but it stops the clip
		// feeling like stock footage.
		const settle = () => (video.playbackRate = 0.85);
		settle();
		// Some browsers reset playbackRate when the source finishes loading.
		video.addEventListener('loadeddata', settle);
	}
</script>

<style>
	.hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the video instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: 100vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	/* Measures the first ~80px of scroll so the sticky header knows when to
	   stop being transparent over the hero video, see Header.astro's script. */
	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		padding-bottom: clamp(4rem, 9vh, 6.5rem);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	/* The block sits right, but the type inside reads left-to-right like any
	   other English copy — a right-aligned ragged edge fought the reading order. */
	.hero-box {
		width: min(34rem, 100%);
		text-align: left;
	}

	.hero-title {
		margin: 0 0 var(--space-4);
		font-size: clamp(2rem, 3.9vw, 3.5rem);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: 0.01em;
		color: var(--color-text-on-dark);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
	}

	/* The 0.4s head start lets the video settle out of its poster before any
	   type moves, so the sequence reads video → words rather than both at once. */
	.hero-title span {
		display: block;
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
	}
	.hero-title span:nth-child(2) {
		animation-delay: 0.52s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.6em);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-lede {
		margin: 0 0 var(--space-6);
		font-size: clamp(1rem, 1.35vw, 1.1875rem);
		font-weight: var(--fw-regular);
		line-height: 1.55;
		color: var(--color-text-on-dark);
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.5);
		/* Trails the second headline line, which lands at 0.52s + 0.9s. */
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both;
	}

	.hero-lede span {
		display: block;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
		justify-content: flex-start;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.7rem 1.4rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		white-space: nowrap;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base);
	}

	.hero-btn-primary {
		background: var(--color-accent-hover);
		color: var(--color-white);
	}
	.hero-btn-primary:hover {
		background: var(--color-accent);
	}

	/* 100vh with no indication of more content below is a bounce risk. */
	.hero-cue {
		position: absolute;
		z-index: 1;
		bottom: clamp(1.25rem, 3vh, 2rem);
		left: 50%;
		translate: -50% 0;
		width: 1px;
		height: 56px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.22);
	}

	.hero-cue-line {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--color-accent-hover);
		transform-origin: top;
		animation: cue-draw 2s var(--ease-in-out-soft) 1.6s infinite;
	}

	@keyframes cue-draw {
		0% {
			transform: translateY(-100%);
		}
		45%,
		100% {
			transform: translateY(100%);
		}
	}

	@media (max-width: 700px) {
		.hero-inner {
			align-items: flex-start;
		}
		.hero-cue {
			display: none;
		}
		/* Forced line breaks stop earning their keep once the column is narrow
		   enough that each one wraps anyway. */
		.hero-lede span {
			display: inline;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title span,
		.hero-lede,
		.hero-cue-line {
			animation: none;
		}
	}
</style>
