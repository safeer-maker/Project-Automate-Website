---
import { withBase } from '../lib/paths.ts';
---

<section class="hero">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<video
			class="hero-video"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			poster={withBase('/images/home/hero/poster.webp')}
			aria-hidden="true"
			tabindex="-1"
		>
			<source src={withBase('/videos/hero.webm')} type="video/webm" />
			<source src={withBase('/videos/hero.mp4')} type="video/mp4" />
		</video>
	</div>

	<div class="hero-inner">
		<h1 class="hero-title">
			<span>Tailored</span> <span>Luxury</span> <span>Technologies</span>
		</h1>
		<p class="hero-lede">
			Lighting, climate, sound and security — designed to work as one, and to disappear.
		</p>
		<div class="hero-actions">
			<a class="hero-btn hero-btn-primary" href={withBase('/schedule/')}>Book a Consultation</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the video instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: 100vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	/* Measures the first ~80px of scroll so the sticky header knows when to
	   stop being transparent over the hero video, see Header.astro's script. */
	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		padding-bottom: clamp(4rem, 9vh, 6.5rem);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
	}

	.hero-title {
		margin: 0 0 var(--space-4);
		font-size: clamp(2rem, 3.9vw, 3.5rem);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: 0.01em;
		color: var(--color-text-on-dark);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
	}

	.hero-title span {
		display: inline-block;
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	.hero-title span:nth-child(2) {
		animation-delay: 0.12s;
	}
	.hero-title span:nth-child(3) {
		animation-delay: 0.24s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.6em);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-lede {
		margin: 0 0 var(--space-6);
		max-width: 34rem;
		font-size: clamp(1rem, 1.35vw, 1.1875rem);
		font-weight: var(--fw-regular);
		line-height: 1.55;
		color: var(--color-text-on-dark);
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.5);
		/* Trails the third headline word, which lands at 0.24s + 0.9s. */
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.42s both;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.7rem 1.4rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		white-space: nowrap;
		transition: background-color var(--transition-base), border-color var(--transition-base);
	}

	.hero-btn-primary {
		background: var(--color-accent-hover);
		color: var(--color-white);
	}
	.hero-btn-primary:hover {
		background: var(--color-accent);
	}

	@media (max-width: 700px) {
		.hero-inner {
			align-items: flex-start;
			text-align: left;
		}
		.hero-actions {
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title span,
		.hero-lede {
			animation: none;
		}
	}
</style>
