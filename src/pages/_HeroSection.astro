---
// Every hero encode (desktop, mobile and portrait) comes from the 1920x1080
// revised cut, media-src/videos/project-automate-hero-1080.mp4. Its 1280x720
// sibling, project-automate-hero-720.mp4, is the same cut, kept for reference
// only; the 1080 master is sharper at every output size. The master opens
// with a fade up from black and closes with a fade down; the encodes trim
// those off (-ss 0.6 -to 48.95) so the loop cuts cleanly and frame 0 is a
// real picture. The posters are each encode's exact first frame
// (ffmpeg -i hero.mp4 -frames:v 1 -c:v libwebp -quality 82): a poster from
// mid-clip followed by a fade from black read as the video "loading twice".
//
// mp4/H.264 is listed before webm/VP9 in every <source> group on purpose: the
// browser plays whichever source it hits first that it supports, it doesn't
// benchmark them, and VP9 has much patchier hardware-decode support than H.264
// across GPUs. Listing webm first was causing software-decoded VP9 stutter on
// otherwise capable machines. Resolution is also capped below source res
// (1600px desktop / 960px mobile) with a hard bitrate ceiling (-maxrate/-bufsize,
// or -b:v as a ceiling in VP9's constrained-quality mode) so there are no bitrate
// spikes the decoder has to catch up on.
//
// To regenerate after swapping the clip:
//   ffmpeg -ss <in> -to <out> -i <clip> -vf scale=1600:-2 -r 30 -c:v libx264 -preset slow -crf 26 \
//     -maxrate 1800k -bufsize 3600k -g 60 -keyint_min 60 -pix_fmt yuv420p -an \
//     -movflags +faststart public/videos/hero.mp4
//   ffmpeg -ss <in> -to <out> -i <clip> -vf scale=1600:-2 -r 30 -c:v libvpx-vp9 -crf 34 -b:v 1400k \
//     -maxrate 1400k -bufsize 2800k -g 60 -keyint_min 60 -row-mt 1 -tile-columns 2 \
//     -pix_fmt yuv420p -an public/videos/hero.webm
//   (repeat at scale=960:-2 for hero-mobile.mp4 crf 28/maxrate 900k, and
//   hero-mobile.webm crf 37/b:v 700k)
//
// Portrait phones get their own 9:16 crop (hero-portrait.*): cover-fitting the
// 16:9 mobile film into a portrait screen showed only ~250 source px across,
// a 4.5x upscale. The crop is the centre of the 1920x1080 master (the same
// framing phones saw before), at the same pixel count and bitrate caps:
//   -vf crop=608:1080:656:0,scale=540:960:flags=lanczos, then the mobile
//   x264/VP9 settings above. The 960x540 files stay for small landscape screens.
import { withBase } from "../lib/paths.ts";

const poster = withBase("/images/home/hero/poster.webp");
const posterMobile = withBase("/images/home/hero/poster-mobile.webp");
const posterPortrait = withBase("/images/home/hero/poster-portrait.webp");
const portraitPhone = "(max-width: 700px) and (orientation: portrait)";
---

<section class="hero" aria-labelledby="hero-title">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<!-- The still under the film is each encode's exact first frame (the
		     portrait crop starts on a different framing), so when the video
		     fades in over it nothing jumps. It's the page's LCP image, hence fetchpriority. The
		     video's own `poster` isn't used: it can't vary by breakpoint. -->
		<picture class="hero-poster">
			<source
				media={portraitPhone}
				srcset={posterPortrait}
				width="540"
				height="960"
			/>
			<source
				media="(max-width: 700px)"
				srcset={posterMobile}
				width="960"
				height="540"
			/>
			<img
				src={poster}
				alt=""
				width="1600"
				height="900"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		<!-- No autoplay attribute: the script starts playback once a few
		     seconds are buffered (see below). preload="none" in the markup so
		     reduced-motion visitors, who only ever see the still, don't download
		     the film; the inline script right after upgrades it for everyone
		     else during parse, so their fetch starts as early as before. -->
		<video
			class="hero-video"
			data-hero-video
			muted
			loop
			playsinline
			preload="none"
			aria-hidden="true"
			tabindex="-1"
		>
			<source
				media={portraitPhone}
				src={withBase("/videos/hero-portrait.mp4")}
				type="video/mp4"
			/>
			<source
				media={portraitPhone}
				src={withBase("/videos/hero-portrait.webm")}
				type="video/webm"
			/>
			<source
				media="(max-width: 700px)"
				src={withBase("/videos/hero-mobile.mp4")}
				type="video/mp4"
			/>
			<source
				media="(max-width: 700px)"
				src={withBase("/videos/hero-mobile.webm")}
				type="video/webm"
			/>
			<source src={withBase("/videos/hero.mp4")} type="video/mp4" />
			<source src={withBase("/videos/hero.webm")} type="video/webm" />
		</video>
		<script is:inline>
			{
				const v = document.querySelector("[data-hero-video]");
				if (
					v &&
					!matchMedia("(prefers-reduced-motion: reduce)").matches
				) {
					v.preload = "auto";
					v.load();
				}
			}
		</script>
		<span class="hero-scrim"></span>
	</div>

	<div class="hero-inner">
		<div class="hero-box">
			<!-- Each line sits in its own overflow mask so it can rise into view.
			     The literal space between them keeps the heading's text (and its
			     accessible name) "Technology for", not "Technologyfor". -->
			<h1 class="hero-title" id="hero-title">
				<span class="line"><span>Tailored Luxury Technology</span></span
				>
				{" "}
				<span class="line"><span>for Los Angeles Residences</span></span
				>
			</h1>
			<!--<p class="hero-lede">
				Lighting, climate, sound and security, designed to work as one, and to disappear.
			</p>-->
		</div>
		<!-- After the headline in the markup so screen readers and the tab order
		     meet the heading first; the grid places it bottom-left on screen. -->
		<div class="hero-actions" data-cookie-clear>
			<a class="hero-btn cta-lux cta-lux-beacon" href={withBase("/schedule/")} data-ghl-form-open
				>Request Your Complimentary Consultation</a
			>
			<!-- Lenis (anchors: true) glides this to the statement below. -->
			<a class="hero-link" href="#approach">
				<span>Discover the approach</span>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M8 3v10M4 9l4 4 4-4"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
		</div>
	</div>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");

	// No pause control, by client request. Reduced-motion visitors are the
	// ones who can't opt out any other way, so they only ever get the still.
	if (
		video &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches
	) {
		// Slightly under real time. Almost subliminal, but it stops the clip
		// feeling like stock footage.
		const settle = () => (video.playbackRate = 0.85);
		settle();
		// Some browsers reset playbackRate when the source finishes loading.
		video.addEventListener("loadeddata", settle);

		// The film fades in over its own first frame once it's genuinely
		// playing, so the swap from still to motion is invisible.
		video.addEventListener(
			"playing",
			() => video.classList.add("is-playing"),
			{ once: true },
		);

		let onScreen = true;

		const play = () => {
			if (!onScreen) return;
			// Autoplay refused (e.g. Low Power Mode): the still stays.
			video.play().catch(() => {});
		};

		// Autoplay used to start the instant the first frames arrived, then
		// freeze a second in to buffer and start again. Wait until ~3s is
		// buffered ahead (or the whole clip, or 6s have passed) before starting.
		let started = false;
		const bufferedAhead = () => {
			const ranges = video.buffered;
			for (let i = 0; i < ranges.length; i++) {
				if (ranges.start(i) <= video.currentTime + 0.1)
					return ranges.end(i) - video.currentTime;
			}
			return 0;
		};
		const startWhenReady = () => {
			if (started) return;
			const ahead = bufferedAhead();
			const whole =
				Number.isFinite(video.duration) &&
				ahead >= video.duration - 0.5;
			if (ahead >= 3 || whole) {
				started = true;
				play();
			}
		};
		video.addEventListener("progress", startWhenReady);
		video.addEventListener("canplaythrough", startWhenReady);
		startWhenReady();
		window.setTimeout(() => {
			if (!started) {
				started = true;
				play();
			}
		}, 6000);

		// No point decoding a film nobody can see.
		new IntersectionObserver(([entry]) => {
			onScreen = entry.isIntersecting;
			if (!onScreen) video.pause();
			else if (started) play();
		}).observe(video);
	}
</script>

<style>
	.hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the video instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: 100vh;
		/* Mobile browsers: size to the viewport with the URL bar showing, so
		   the CTA isn't hidden under it on first load. */
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	/* Measures the first ~80px of scroll so the sticky header knows when to
	   stop being transparent over the hero video, see Header.astro's script. */
	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-poster img,
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	/* Hidden until it is actually playing; the poster underneath is the same
	   frame, so the fade only ever reveals motion, never a different picture. */
	.hero-video {
		opacity: 0;
		transition: opacity 600ms var(--ease-in-out-soft);
	}

	.hero-video.is-playing {
		opacity: 1;
	}

	/* The film moves between bright aerial daylight and dusk, so the copy
	   can't rely on text-shadow alone. A low, warm-black falloff under the
	   copy plus a band behind the transparent header, nothing mid-frame. The
	   band holds ~0.55 across the header's own height (white nav over bright
	   sky was 2.6:1 at 0.42) and is gone by a quarter of the way down.
	   The falloff only has to cover the copy (~180px up from the bottom), so
	   it's gone by 40%: when it ran to 64% at 0.74 it dulled the lower half of
	   the film for contrast the copy didn't need (worst frame was ~8:1). */
	.hero-scrim {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(
				180deg,
				rgba(10, 10, 10, 0.62) 0%,
				rgba(10, 10, 10, 0.55) var(--header-height, 96px),
				rgba(10, 10, 10, 0) 26%
			),
			linear-gradient(
				0deg,
				rgba(10, 10, 10, 0.55) 0%,
				rgba(10, 10, 10, 0.28) max(20%, 12rem),
				rgba(10, 10, 10, 0) max(40%, 22rem)
			);
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		/* Not capped at the page width: past 1440 that left the headline up
		   to 240px short of the corner. The copy hugs the screen's gutter. */
		width: 100%;
		padding-inline: var(--page-gutter);
		padding-bottom: var(--hero-copy-bottom);
		/* Headline bottom-right, actions bottom-left. Stacked (headline over
		   actions) until there's room for both on one row. */
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		row-gap: var(--space-8);
	}

	/* Side by side, bottoms aligned: the actions take whatever width the
	   headline leaves and wrap the link under the button if they must. */
	@media (min-width: 901px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1fr) auto;
			column-gap: clamp(2rem, 5vw, 5rem);
			align-items: end;
		}
		.hero-box {
			grid-column: 2;
			grid-row: 1;
		}
		.hero-actions {
			grid-column: 1;
			grid-row: 1;
		}
	}

	/* Shrink-wrapped and set ragged-left, so every line ends flush on the
	   right gutter, in the corner, whatever size the type resolves to. */
	.hero-box {
		position: relative;
		justify-self: end;
		width: fit-content;
		max-width: 100%;
		text-align: right;
	}

	/* The copy lands on the white house and pool deck, where the low falloff
	   has all but faded. A soft pool of shade that travels with the copy,
	   rather than a heavier full-width band, keeps the rest of the frame
	   bright. Wide enough that its edge never reads as a shape. */
	.hero-box::before {
		content: "";
		position: absolute;
		inset: -9rem -5rem -5rem -12rem;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			closest-side,
			rgba(10, 10, 10, 0.55),
			rgba(10, 10, 10, 0.45) 55%,
			rgba(10, 10, 10, 0)
		);
	}

	.hero-title {
		margin: 0 0 var(--space-6);
		font-size: clamp(2.125rem, 3.6vw, 3.25rem);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: var(--color-text-on-dark);
	}

	/* The mask. Padding + matching negative margin gives descenders and the
	   soft shadow room inside the clip without changing the line spacing. */
	.hero-title .line {
		display: block;
		overflow: hidden;
		padding: 0.08em 0.4em 0.14em;
		margin: -0.08em -0.4em -0.14em;
	}

	/* The 0.4s head start lets the video settle out of its poster before any
	   type moves, so the sequence reads video → words rather than both at once. */
	.hero-title .line > span {
		display: block;
		text-shadow: 0 1px 14px rgba(0, 0, 0, 0.28);
		animation: mask-rise 0.9s var(--ease-out-expo) 0.4s both;
	}
	.hero-title .line:nth-of-type(2) > span {
		animation-delay: 0.52s;
	}

	@keyframes mask-rise {
		from {
			transform: translateY(105%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-lede {
		max-width: 34ch;
		/* Narrower than the headline: pushed to the box's right edge. */
		margin: 0 0 0 auto;
		font-size: clamp(1rem, 1.3vw, 1.1875rem);
		font-weight: var(--fw-regular);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.86);
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.4);
		text-wrap: pretty;
		/* Trails the second headline line, which lands at 0.52s + 0.9s. */
		animation: fade-in 1s var(--ease-out-expo) 0.75s both;
	}

	.hero-actions {
		justify-self: start;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-8);
		animation: fade-in 1s var(--ease-out-expo) 0.9s both;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-sm);
		/* White on the lighter gold was 3.25:1; the fill bronze clears 4.5. */
		background: var(--color-bronze-fill);
		color: var(--color-white);
		white-space: nowrap;
		transition: background-color var(--transition-base), transform var(--dur-base) var(--ease-out-expo),
			box-shadow var(--dur-base) var(--ease-out-expo);
	}
	.hero-btn:hover {
		background: var(--color-bronze-fill-hover);
	}

	/* Quiet by design: the consultation is the one action, this is a way to
	   keep reading. A faint hairline underline that brightens on hover. */
	.hero-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 44px;
		font-size: var(--text-sm);
		font-weight: var(--fw-medium);
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.86);
		/* Off the headline's shade pool, over the bare bottom falloff. */
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
		transition: color var(--dur-fast) ease;
	}

	.hero-link span {
		padding-bottom: 3px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.38);
		transition: border-color var(--dur-fast) ease;
	}

	.hero-link svg {
		width: 14px;
		height: 14px;
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.hero-link:hover {
		color: var(--color-white);
	}
	.hero-link:hover span {
		border-color: var(--color-accent-hover);
	}
	.hero-link:hover svg {
		transform: translateY(2px);
	}

	.hero-btn:focus-visible,
	.hero-link:focus-visible {
		outline: 2px solid var(--color-accent-hover);
		outline-offset: 4px;
	}

	@media (max-width: 700px) {
		/* On a tall phone the copy block climbs ~350px (about 42% of the
		   frame), over the bright white house, so the falloff holds ~0.45
		   up to the headline, then clears. The max() stops keep that true on
		   short phones too, where the same copy reaches higher up the frame.
		   It used to hold 0.65 to 62% and run to 90%, which left almost the
		   whole portrait film at a third of its brightness. */
		.hero-scrim {
			background:
				linear-gradient(
					180deg,
					rgba(10, 10, 10, 0.5) 0%,
					rgba(10, 10, 10, 0) 18%
				),
				linear-gradient(
					0deg,
					rgba(10, 10, 10, 0.62) 0%,
					rgba(10, 10, 10, 0.45) max(40%, 22rem),
					rgba(10, 10, 10, 0) max(62%, 32rem)
				);
		}
		/* One left-aligned column on a phone: a right-hand headline over a
		   left-hand button would zigzag down a 390px screen. */
		.hero-box {
			justify-self: start;
			text-align: left;
		}
		.hero-lede {
			margin-left: 0;
		}
		.hero-title {
			font-size: clamp(2rem, 8.6vw, 2.5rem);
		}
		/* No shade pool on a phone: the scrim above already sits under the
		   whole copy block. */
		.hero-box::before {
			display: none;
		}
		.hero-actions {
			gap: var(--space-3) var(--space-6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title .line > span,
		.hero-lede,
		.hero-actions {
			animation: none;
		}
		.hero-video {
			transition: none;
		}
	}
</style>
