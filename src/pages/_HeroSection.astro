---
import { withBase } from "../lib/paths.ts";
---

<section class="hero">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<video
			class="hero-video"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			poster={withBase("/images/home/hero/poster.webp")}
			aria-hidden="true"
			tabindex="-1"
		>
			<source src={withBase("/videos/hero.webm")} type="video/webm" />
			<source src={withBase("/videos/hero.mp4")} type="video/mp4" />
		</video>
	</div>

	<div class="hero-inner">
		<div class="hero-box">
			<h1 class="hero-title">
				<span>Tailored Luxury</span>
				<span>Technologies</span>
			</h1>
			<p class="hero-lede">
				<span>Lighting, climate, sound and security,</span>
				<span>designed to work as one, and to disappear.</span>
			</p>
			<div class="hero-actions">
				<a
					class="hero-btn hero-btn-primary"
					href={withBase("/schedule/")}>Book a Consultation</a
				>
			</div>
		</div>
	</div>

	<a class="hero-cue" href="#after-hero" aria-label="Scroll to content">
		<span class="hero-cue-line" aria-hidden="true"></span>
	</a>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>('.hero-video');
	if (video) {
		// Slightly under real time. Almost subliminal, but it stops the clip
		// feeling like stock footage.
		const settle = () => (video.playbackRate = 0.85);
		settle();
		// Some browsers reset playbackRate when the source finishes loading.
		video.addEventListener('loadeddata', settle);
	}
</script>

<style>
	.hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the video instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: 100vh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	/* Measures the first ~80px of scroll so the sticky header knows when to
	   stop being transparent over the hero video, see Header.astro's script. */
	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		padding-bottom: clamp(4rem, 9vh, 6.5rem);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	/* The block sits right, but the type inside reads left-to-right like any
	   other English copy — a right-aligned ragged edge fought the reading order. */
	.hero-box {
		width: min(34rem, 100%);
		text-align: left;
	}

	.hero-title {
		margin: 0 0 var(--space-4);
		font-size: clamp(2rem, 3.9vw, 3.5rem);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: 0.01em;
		color: var(--color-text-on-dark);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
	}

	.hero-title span {
		display: block;
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	.hero-title span:nth-child(2) {
		animation-delay: 0.12s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.6em);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-lede {
		margin: 0 0 var(--space-6);
		font-size: clamp(1rem, 1.35vw, 1.1875rem);
		font-weight: var(--fw-regular);
		line-height: 1.55;
		color: var(--color-text-on-dark);
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.5);
		/* Trails the second headline line, which lands at 0.12s + 0.9s. */
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
	}

	.hero-lede span {
		display: block;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
		justify-content: flex-start;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.7rem 1.4rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		white-space: nowrap;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base);
	}

	.hero-btn-primary {
		background: var(--color-accent-hover);
		color: var(--color-white);
	}
	.hero-btn-primary:hover {
		background: var(--color-accent);
	}

	@media (max-width: 700px) {
		.hero-inner {
			align-items: flex-start;
		}
		/* Forced line breaks stop earning their keep once the column is narrow
		   enough that each one wraps anyway. */
		.hero-lede span {
			display: inline;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title span,
		.hero-lede {
			animation: none;
		}
	}
</style>
