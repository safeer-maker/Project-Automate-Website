---
// Desktop sources are re-encoded from media-src/videos/project-automate-hero-1080.mp4,
// mobile sources from media-src/videos/project-automate-hero-720.mp4 (both raw
// source clips, kept for reference/regeneration). Both masters open with a
// fade up from black and close with a fade down; the encodes trim those off
// (-ss 0.5 -to 49.65 desktop, -ss 0.6 -to 48.95 mobile) so the loop cuts
// cleanly and frame 0 is a real picture. The posters are those exact first
// frames (ffmpeg -i hero.mp4 -frames:v 1): a poster from mid-clip followed by
// a fade from black read as the video "loading twice".
//
// mp4/H.264 is listed before webm/VP9 in every <source> group on purpose: the
// browser plays whichever source it hits first that it supports, it doesn't
// benchmark them, and VP9 has much patchier hardware-decode support than H.264
// across GPUs. Listing webm first was causing software-decoded VP9 stutter on
// otherwise capable machines. Resolution is also capped below source res
// (1600px desktop / 960px mobile) with a hard bitrate ceiling (-maxrate/-bufsize,
// or -b:v as a ceiling in VP9's constrained-quality mode) so there are no bitrate
// spikes the decoder has to catch up on.
//
// To regenerate after swapping the clip:
//   ffmpeg -ss <in> -to <out> -i <clip> -vf scale=1600:-2 -r 30 -c:v libx264 -preset slow -crf 26 \
//     -maxrate 1800k -bufsize 3600k -g 60 -keyint_min 60 -pix_fmt yuv420p -an \
//     -movflags +faststart public/videos/hero.mp4
//   ffmpeg -i <clip> -vf scale=1600:-2 -r 30 -c:v libvpx-vp9 -crf 34 -b:v 1400k \
//     -maxrate 1400k -bufsize 2800k -g 60 -keyint_min 60 -row-mt 1 -tile-columns 2 \
//     -pix_fmt yuv420p -an public/videos/hero.webm
//   (repeat at scale=960:-2 for hero-mobile.mp4 crf 28/maxrate 900k, and
//   hero-mobile.webm crf 37/b:v 700k)
//
// Portrait phones get their own 9:16 crop (hero-portrait.*): cover-fitting the
// 16:9 mobile film into a portrait screen showed only ~250 source px across,
// a 4.5x upscale. The crop is the centre of the 1920x1080 mobile master (the
// same framing phones saw before), at the same pixel count and bitrate caps:
//   -vf crop=608:1080:656:0,scale=540:960:flags=lanczos, then the mobile
//   x264/VP9 settings above. The 960x540 files stay for small landscape screens.
import { withBase } from "../lib/paths.ts";

const poster = withBase("/images/home/hero/poster.webp");
const posterMobile = withBase("/images/home/hero/poster-mobile.webp");
const posterPortrait = withBase("/images/home/hero/poster-portrait.webp");
const portraitPhone = "(max-width: 700px) and (orientation: portrait)";
---

<section class="hero" aria-labelledby="hero-title">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<!-- The still under the film is each clip's exact first frame (desktop
		     and mobile are different edits), so when the video fades in over it
		     nothing jumps. It's the page's LCP image, hence fetchpriority. The
		     video's own `poster` isn't used: it can't vary by breakpoint. -->
		<picture class="hero-poster">
			<source media={portraitPhone} srcset={posterPortrait} width="540" height="960" />
			<source media="(max-width: 700px)" srcset={posterMobile} width="960" height="540" />
			<img src={poster} alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
		</picture>
		<!-- No autoplay attribute: the script starts playback once a few
		     seconds are buffered (see below). preload="none" in the markup so
		     reduced-motion visitors, who only ever see the still, don't download
		     the film; the inline script right after upgrades it for everyone
		     else during parse, so their fetch starts as early as before. -->
		<video
			class="hero-video"
			data-hero-video
			muted
			loop
			playsinline
			preload="none"
			aria-hidden="true"
			tabindex="-1"
		>
			<source
				media={portraitPhone}
				src={withBase("/videos/hero-portrait.mp4")}
				type="video/mp4"
			/>
			<source
				media={portraitPhone}
				src={withBase("/videos/hero-portrait.webm")}
				type="video/webm"
			/>
			<source
				media="(max-width: 700px)"
				src={withBase("/videos/hero-mobile.mp4")}
				type="video/mp4"
			/>
			<source
				media="(max-width: 700px)"
				src={withBase("/videos/hero-mobile.webm")}
				type="video/webm"
			/>
			<source src={withBase("/videos/hero.mp4")} type="video/mp4" />
			<source src={withBase("/videos/hero.webm")} type="video/webm" />
		</video>
		<script is:inline>
			{
				const v = document.querySelector('[data-hero-video]');
				if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
					v.preload = 'auto';
					v.load();
				}
			}
		</script>
		<span class="hero-scrim"></span>
	</div>

	<div class="hero-inner">
		<div class="hero-box">
			<!-- The h1 already names Los Angeles and luxury; the eyebrow says
			     what the studio does and where it is instead of repeating them.
			     Short enough to stay on one line on a phone. The literal spaces
			     keep the phrases apart for screen readers (the gap is visual). -->
			<p class="hero-eyebrow">
				<span>Home Technology</span>{' '}
				<span class="hero-eyebrow-dot" aria-hidden="true">·</span>{' '}
				<span>Manhattan Beach</span>
			</p>
			<!-- Each line sits in its own overflow mask so it can rise into view.
			     The literal space between them keeps the heading's text (and its
			     accessible name) "Technology for", not "Technologyfor". -->
			<h1 class="hero-title" id="hero-title">
				<span class="line"><span>Tailored Luxury Technology</span></span>
				{" "}
				<span class="line"><span>for Los Angeles Residences</span></span>
			</h1>
			<p class="hero-lede">
				Lighting, climate, sound and security, designed to work as one, and to disappear.
			</p>
			<div class="hero-actions" data-cookie-clear>
				<a
					class="hero-btn"
					href={withBase("/schedule/")}
					data-ghl-form-open>Book a Private Consultation</a
				>
				<!-- Lenis (anchors: true) glides this to the statement below. -->
				<a class="hero-link" href="#approach">
					<span>Discover the approach</span>
					<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M8 3v10M4 9l4 4 4-4"
							stroke="currentColor"
							stroke-width="1.3"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>

	<!-- Moving backgrounds need a way to stop them (WCAG 2.2.2). Shown once
	     the script runs; it's the only control for the film. After the copy in
	     the markup so the tab order follows the reading order; it's absolutely
	     positioned, so nothing moves on screen. -->
	<button class="hero-toggle" type="button" data-hero-toggle data-cookie-clear aria-label="Pause background video" hidden>
		<svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
		<svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.8v8.4l6.6-4.2z" fill="currentColor" /></svg>
	</button>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');

	if (video && toggle) {
		// Slightly under real time. Almost subliminal, but it stops the clip
		// feeling like stock footage.
		const settle = () => (video.playbackRate = 0.85);
		settle();
		// Some browsers reset playbackRate when the source finishes loading.
		video.addEventListener('loadeddata', settle);

		// The film fades in over its own first frame once it's genuinely
		// playing, so the swap from still to motion is invisible.
		video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let userPaused = reduce;
		let onScreen = true;

		const syncToggle = () => {
			const paused = video.paused;
			toggle.classList.toggle('is-paused', paused);
			toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
		};
		video.addEventListener('play', syncToggle);
		video.addEventListener('pause', syncToggle);

		const play = () => {
			if (userPaused || !onScreen) return;
			video.play().catch(() => {
				// Autoplay refused (e.g. Low Power Mode): the still stays, and the
				// toggle offers play.
				syncToggle();
			});
		};

		// Autoplay used to start the instant the first frames arrived, then
		// freeze a second in to buffer and start again. Wait until ~3s is
		// buffered ahead (or the whole clip, or 6s have passed) before starting.
		let started = false;
		const bufferedAhead = () => {
			const ranges = video.buffered;
			for (let i = 0; i < ranges.length; i++) {
				if (ranges.start(i) <= video.currentTime + 0.1) return ranges.end(i) - video.currentTime;
			}
			return 0;
		};
		const startWhenReady = () => {
			if (started) return;
			const ahead = bufferedAhead();
			const whole = Number.isFinite(video.duration) && ahead >= video.duration - 0.5;
			if (ahead >= 3 || whole) {
				started = true;
				play();
			}
		};
		if (!reduce) {
			video.addEventListener('progress', startWhenReady);
			video.addEventListener('canplaythrough', startWhenReady);
			startWhenReady();
			window.setTimeout(() => {
				if (!started) {
					started = true;
					play();
				}
			}, 6000);
		}

		// No point decoding a film nobody can see.
		new IntersectionObserver(([entry]) => {
			onScreen = entry.isIntersecting;
			if (!onScreen) video.pause();
			else if (started) play();
		}).observe(video);

		toggle.addEventListener('click', () => {
			if (video.paused) {
				userPaused = false;
				started = true;
				// Reduced motion: the film was never fetched (preload="none").
				if (video.readyState === 0) {
					video.preload = 'auto';
					video.load();
				}
				play();
			} else {
				userPaused = true;
				video.pause();
			}
		});

		syncToggle();
		toggle.hidden = false;
	}
</script>

<style>
	.hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the video instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: 100vh;
		/* Mobile browsers: size to the viewport with the URL bar showing, so
		   the CTA isn't hidden under it on first load. */
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	/* Measures the first ~80px of scroll so the sticky header knows when to
	   stop being transparent over the hero video, see Header.astro's script. */
	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-poster img,
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	/* Hidden until it is actually playing; the poster underneath is the same
	   frame, so the fade only ever reveals motion, never a different picture. */
	.hero-video {
		opacity: 0;
		transition: opacity 600ms var(--ease-in-out-soft);
	}

	.hero-video.is-playing {
		opacity: 1;
	}

	.hero-toggle {
		position: absolute;
		z-index: 2;
		/* On the content grid's right edge, not the screen's: past the 1440
		   page width it drifted up to 200px outside the layout. */
		right: max(var(--page-gutter), calc((100% - var(--page-max)) / 2 + var(--page-gutter)));
		bottom: clamp(1.25rem, 3vh, 2rem);
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.35);
		border-radius: 50%;
		background: rgba(10, 10, 10, 0.25);
		color: var(--color-white);
		cursor: pointer;
		opacity: 0.7;
		transition:
			opacity var(--dur-fast) ease,
			border-color var(--dur-fast) ease,
			background-color var(--dur-fast) ease;
	}

	.hero-toggle:hover,
	.hero-toggle:focus-visible {
		opacity: 1;
		border-color: var(--color-accent-hover);
		background: rgba(10, 10, 10, 0.45);
	}

	.hero-toggle:focus-visible {
		outline: 2px solid var(--color-accent-hover);
		outline-offset: 3px;
	}

	.hero-toggle svg {
		width: 14px;
		height: 14px;
	}

	.hero-toggle .icon-play,
	.hero-toggle.is-paused .icon-pause {
		display: none;
	}

	.hero-toggle.is-paused .icon-play {
		display: block;
	}

	/* The film moves between bright aerial daylight and dusk, so the copy
	   can't rely on text-shadow alone. A low, warm-black falloff under the
	   copy plus a band behind the transparent header, nothing mid-frame. The
	   band holds ~0.55 across the header's own height (white nav over bright
	   sky was 2.6:1 at 0.42) and is gone by a quarter of the way down. */
	.hero-scrim {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(
				180deg,
				rgba(10, 10, 10, 0.62) 0%,
				rgba(10, 10, 10, 0.55) var(--header-height, 96px),
				rgba(10, 10, 10, 0) 26%
			),
			linear-gradient(0deg, rgba(10, 10, 10, 0.74) 0%, rgba(10, 10, 10, 0.4) 36%, rgba(10, 10, 10, 0) 64%);
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		padding-bottom: clamp(3.5rem, 10vh, 7rem);
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	/* The pause toggle shares the page gutter with "Discover the approach",
	   and on 720–900px-tall laptops 10vh left it only 10–23px under the
	   link's arrow. Always clear the toggle (its offset + 40px) by 1.5rem. */
	@media (min-width: 701px) {
		.hero-inner {
			padding-bottom: max(clamp(3.5rem, 10vh, 7rem), calc(clamp(1.25rem, 3vh, 2rem) + 40px + 1.5rem));
		}
	}

	/* The block sits right, but the type inside reads left-to-right like any
	   other English copy — a right-aligned ragged edge fought the reading order.
	   It shrink-wraps the headline so its right edge always lands on the page
	   gutter, whatever size the type resolves to. */
	.hero-box {
		position: relative;
		width: fit-content;
		max-width: 100%;
		text-align: left;
	}

	/* The copy lands on the white house and pool deck, where the low falloff
	   has all but faded. A soft pool of shade that travels with the copy,
	   rather than a heavier full-width band, keeps the rest of the frame
	   bright. Wide enough that its edge never reads as a shape. */
	.hero-box::before {
		content: '';
		position: absolute;
		inset: -9rem -5rem -5rem -12rem;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			closest-side,
			rgba(10, 10, 10, 0.55),
			rgba(10, 10, 10, 0.45) 55%,
			rgba(10, 10, 10, 0)
		);
	}

	/* A hairline leads the eyebrow in: the bronze of the brand without asking
	   bronze text to hold its own against a moving image. Full white, since
	   at 12px the eyebrow has no size to lean on. */
	.hero-eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
		margin: 0 0 var(--space-6);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-white);
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
		animation: fade-in 1s var(--ease-out-expo) 0.3s both;
	}

	/* If the line has to wrap it breaks between the two phrases, never
	   inside one. */
	.hero-eyebrow span {
		white-space: nowrap;
	}

	.hero-eyebrow-dot {
		color: var(--color-accent-hover);
	}

	.hero-eyebrow::before {
		content: '';
		flex: none;
		width: 2rem;
		height: 1px;
		background: var(--color-accent-hover);
	}

	.hero-title {
		margin: 0 0 var(--space-6);
		font-size: clamp(2.125rem, 3.6vw, 3.25rem);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: var(--color-text-on-dark);
	}

	/* The mask. Padding + matching negative margin gives descenders and the
	   soft shadow room inside the clip without changing the line spacing. */
	.hero-title .line {
		display: block;
		overflow: hidden;
		padding: 0.08em 0.4em 0.14em;
		margin: -0.08em -0.4em -0.14em;
	}

	/* The 0.4s head start lets the video settle out of its poster before any
	   type moves, so the sequence reads video → words rather than both at once. */
	.hero-title .line > span {
		display: block;
		text-shadow: 0 1px 14px rgba(0, 0, 0, 0.28);
		animation: mask-rise 0.9s var(--ease-out-expo) 0.4s both;
	}
	.hero-title .line:nth-of-type(2) > span {
		animation-delay: 0.52s;
	}

	@keyframes mask-rise {
		from {
			transform: translateY(105%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-lede {
		max-width: 34ch;
		margin: 0 0 var(--space-8);
		font-size: clamp(1rem, 1.3vw, 1.1875rem);
		font-weight: var(--fw-regular);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.86);
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.4);
		text-wrap: pretty;
		/* Trails the second headline line, which lands at 0.52s + 0.9s. */
		animation: fade-in 1s var(--ease-out-expo) 0.75s both;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-8);
		animation: fade-in 1s var(--ease-out-expo) 0.9s both;
	}

	.hero-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-sm);
		/* White on the lighter gold was 3.25:1; the fill bronze clears 4.5. */
		background: var(--color-bronze-fill);
		color: var(--color-white);
		white-space: nowrap;
		transition: background-color var(--transition-base);
	}
	.hero-btn:hover {
		background: var(--color-bronze-fill-hover);
	}

	/* Quiet by design: the consultation is the one action, this is a way to
	   keep reading. A faint hairline underline that brightens on hover. */
	.hero-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 44px;
		font-size: var(--text-sm);
		font-weight: var(--fw-medium);
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.86);
		transition: color var(--dur-fast) ease;
	}

	.hero-link span {
		padding-bottom: 3px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.38);
		transition: border-color var(--dur-fast) ease;
	}

	.hero-link svg {
		width: 14px;
		height: 14px;
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.hero-link:hover {
		color: var(--color-white);
	}
	.hero-link:hover span {
		border-color: var(--color-accent-hover);
	}
	.hero-link:hover svg {
		transform: translateY(2px);
	}

	.hero-btn:focus-visible,
	.hero-link:focus-visible {
		outline: 2px solid var(--color-accent-hover);
		outline-offset: 4px;
	}

	@media (max-width: 700px) {
		/* On a tall phone crop the copy climbs to ~60% of the frame, right
		   over the bright white house, so the falloff has to hold ~0.65
		   up to the eyebrow. The max() stops keep that true on short phones
		   too, where the same copy reaches higher up the frame. */
		.hero-scrim {
			background:
				linear-gradient(180deg, rgba(10, 10, 10, 0.5) 0%, rgba(10, 10, 10, 0) 18%),
				linear-gradient(
					0deg,
					rgba(10, 10, 10, 0.82) 0%,
					rgba(10, 10, 10, 0.65) max(62%, 36rem),
					rgba(10, 10, 10, 0) max(90%, 48rem)
				);
		}
		.hero-inner {
			align-items: flex-start;
		}
		.hero-title {
			font-size: clamp(2rem, 8.6vw, 2.5rem);
		}
		.hero-eyebrow {
			letter-spacing: 0.14em;
		}
		/* No lead-in hairline on a phone, and no shade pool: the scrim
		   above already sits under the whole copy block. */
		.hero-eyebrow::before,
		.hero-box::before {
			display: none;
		}
		.hero-actions {
			gap: var(--space-3) var(--space-6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-eyebrow,
		.hero-title .line > span,
		.hero-lede,
		.hero-actions {
			animation: none;
		}
		.hero-video {
			transition: none;
		}
	}
</style>
