---
import { withBase } from '../../lib/paths.ts';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const capabilities = [
	{
		title: 'Smart Entry Systems',
		description: 'See, speak, and grant access from anywhere. Modern entry solutions that combine convenience with advanced security.',
		image: withBase('/images/solutions/access-control-and-intercom/feature-1.webp'),
	},
	{
		title: 'Quiet, Connected Protection',
		description: 'Integrated surveillance, access control, and remote monitoring provide greater awareness without making the residence feel dominated by security equipment.',
		image: withBase('/images/solutions/access-control-and-intercom/feature-2.webp'),
	},
	{
		title: 'Manage Entry From Anywhere',
		description: 'View cameras, receive alerts, verify visitors, and manage entry points whether you are at home or away.',
		image: withBase('/images/solutions/access-control-and-intercom/feature-3.webp'),
	},
];

const scenes = [
	{ title: 'Arriving Home', description: 'Gates and doors recognize you and grant entry automatically as you approach.' },
	{ title: 'A Visitor Arrives', description: 'See and speak with visitors from your phone or a touch panel before granting access.' },
	{ title: 'Deliveries', description: 'Grant one-time or scheduled access to couriers and staff remotely, without leaving what you are doing.' },
	{ title: 'Away', description: 'Verify entry activity, review alerts, and secure every access point through one simple command.' },
];
---

<ServiceLayout
	title="Access Control and Intercom"
	description="Elegant access control and intercom systems from PROJECT: automate — gates, doors, cameras and mobile access in one seamless experience."
	heroImage={withBase('/images/solutions/access-control-and-intercom/hero.webp')}
	eyebrow="Modern Security"
	heroTitle="Access, Refined"
	heroSubtitle="Protect your residence with elegant access control and intercom systems designed for privacy, convenience, and complete confidence. PROJECT: automate integrates gates, doors, cameras, entry stations, and mobile access into one seamless experience for luxury Los Angeles homes."
>
	<CapabilityList eyebrow="Key Features" title="Designed for peace of mind — access control that feels effortless." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="Technology that becomes part of the way you live." scenes={scenes} />

	<CtaBanner />
</ServiceLayout>
