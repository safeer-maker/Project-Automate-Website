---
// Landing page for every GHL form ("On submit → redirect" to /thank-you/, with
// "add form values to the URL" switched off so no personal data reaches the
// query string). noindex, and kept out of the nav, footer and sitemap.
import PageLayout from '../../layouts/PageLayout.astro';
import ThankYouSection from './_ThankYouSection.astro';
import { ogImageUrl } from '../../lib/images.ts';
---

<PageLayout
	title="Consultation Request Received"
	description="Thank you for reaching out to PROJECT: automate. A member of our team will call you within one business day. Here is what happens next, and how to reach our Manhattan Beach studio in the meantime."
	image={ogImageUrl('solutions/landscape-path')}
	noindex
>
	<ThankYouSection />
</PageLayout>
