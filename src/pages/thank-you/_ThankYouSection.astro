---
// Everything a visitor sees after submitting a consultation request. The job of
// this page is reassurance: confirm straight away, say exactly what happens and
// when, show who they are dealing with, then offer calm onward reading. There is
// deliberately no form or "Contact us" CTA here: someone who has just contacted
// the studio should not be invited to do it twice.
//
// data-track attributes are hooks for a later cookieless analytics tool
// (e.g. Cloudflare Web Analytics). No GA or Meta pixels on this page.
import { withBase } from '../../lib/paths.ts';
import { siteInfo } from '../../data/site.ts';
import Picture from '../../components/ui/Picture.astro';
import { libraryEntry, type LibraryImageId } from '../../lib/images.ts';

// All timings must be confirmed by the client before launch.
const steps = [
	{
		title: 'A personal introduction',
		when: 'Within one business day',
		body: 'A senior specialist, not a call center, reviews your request and reaches you by phone or email, whichever you prefer.',
	},
	{
		title: 'Discovery conversation',
		when: 'Typically 30 to 45 minutes, at your convenience',
		body: 'We learn how you live: the rooms you gather in, the moments that matter, and what should simply disappear.',
	},
	{
		title: 'Walkthrough',
		when: 'On site or virtual, typically within two weeks',
		body: 'We walk the residence, or review plans with your architect or designer, noting sightlines, finishes and infrastructure.',
	},
	{
		title: 'Your design proposal',
		when: 'Typically two to three weeks after the walkthrough',
		body: 'A tailored system design and investment outline, presented in person and refined with you before anything is installed.',
	},
];

const helpful = [
	'Architectural or floor plans (PDF or CAD)',
	'Contact details for your architect, interior designer or builder',
	'Project stage and target completion or move-in date',
	'Systems already in place (Savant, Control4, Lutron, Crestron and so on)',
	'Priority rooms and your must-haves',
	'The best times and way to reach you',
];

// tel: links in E.164 so they dial correctly from outside the US too.
const phones = siteInfo.phones.map((display) => ({
	display,
	href: `tel:+1${display.replace(/\D/g, '')}`,
}));

// The HTA mark is white-on-transparent artwork, so it is rendered as a solid
// silhouette (see .ty-badge-mono) to stay visible on the cream background.
const badges = [
	{ src: '/images/badges/cedia-certified.webp', alt: 'CEDIA Smart Home CE Provider', width: 1182, height: 1182, mono: false },
	{ src: '/images/badges/cert-level-luxury.webp', alt: 'HTA Certified, Luxury level', width: 1853, height: 870, mono: false },
	{ src: '/images/badges/hta-design-partner.webp', alt: 'HTA Design Partner', width: 280, height: 40, mono: true },
];

const brands = ['Savant', 'Control4', 'Lutron', 'Crestron', 'Basalte', 'Josh.ai'];

// Break the street line before "Building…" so the suite number never wraps
// onto a line of its own in the narrow card column.
const addressLines = [
	...siteInfo.address.line1.split(/,?\s+(?=Building\b)/),
	siteInfo.address.line2,
];

// Onward reading. Images differ from the hero on purpose; one action per card.
const onward: {
	title: string;
	text: string;
	cta: string;
	href: string;
	track: string;
	image: LibraryImageId;
	alt: string;
}[] = [
	{
		title: 'Residences we’ve shaped',
		text: 'Malibu, Hidden Hills, Manhattan Beach. Homes where the technology recedes into the architecture.',
		cta: 'View the residences',
		href: withBase('/get-inspired/'),
		track: 'ty-onward-inspiration',
		image: 'residences/malibu-stone-court',
		alt: 'Modern residence at blue hour, its stone garden wall washed in warm light',
	},
	{
		title: 'How we work',
		text: 'Understand, Design, Integrate, Deliver, and the concierge care that follows.',
		cta: 'See the process',
		href: withBase('/#process'),
		track: 'ty-onward-process',
		image: 'process/design',
		alt: 'White architectural model of a modern home on a studio desk',
	},
	{
		title: 'Explore solutions',
		text: 'Lighting, cinema, shading and security, designed to work as one.',
		cta: 'Explore solutions',
		href: withBase('/control-systems/'),
		track: 'ty-onward-solutions',
		image: 'solutions/cinema-tiered',
		alt: 'Private cinema with tiered seating and warm step lighting',
	},
];

// `sizes` for photos under object-fit: cover, which render at whichever is
// larger of the box's width and its height times the photo's aspect. Sizing
// by box width alone picked renditions that were then upscaled.
const aspectOf = (id: LibraryImageId) => {
	const { width, height } = libraryEntry(id);
	return width / height;
};

// Hero: at least 90vh tall on desktop (92vh on phones), so its 2:1 photo
// renders ~180vh wide, wider than the screen on anything short of an
// ultra-wide monitor, and ~4x the screen width on a portrait phone.
const heroImage: LibraryImageId = 'solutions/landscape-path';
const heroAspect = aspectOf(heroImage);
const heroSizes = [
	`(max-width: 700px) ${Math.round(92 * heroAspect)}vh`,
	`(min-aspect-ratio: ${Math.round(90 * heroAspect)}/100) 100vw`,
	`${Math.round(90 * heroAspect)}vh`,
].join(', ');

// Onward cards: 4:5 portrait boxes on desktop (~29vw, 420px at the cap),
// 3:2 full width below 800px.
const tileSizes = (id: LibraryImageId) => {
	const aspect = aspectOf(id);
	const mobile = Math.max(1, (2 / 3) * aspect).toFixed(2);
	return [
		`(max-width: 799px) calc((100vw - 2.5rem) * ${mobile})`,
		`(max-width: 1440px) ${Math.round(29 * 1.25 * aspect)}vw`,
		`${Math.round(420 * 1.25 * aspect)}px`,
	].join(', ');
};
---

<!-- data-ghl-no-preload: the visitor has just submitted, so GhlFormModal skips
     warming the popup form in the background (it still loads on intent). -->
<div class="ty" data-ty data-ghl-no-preload>
	<!-- 1. Hero: confirmation first, before anything else loads the eye. -->
	<section class="ty-hero" aria-labelledby="ty-title">
		<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
		<div class="ty-hero-media">
			<Picture
				id={heroImage}
				alt="Lit stone stepping path leading to the glowing entry of a modern residence at dusk"
				sizes={heroSizes}
				priority
			/>
		</div>
		<div class="ty-hero-scrim" aria-hidden="true"></div>

		<div class="ty-hero-inner">
			<div class="ty-hero-copy">
				<svg class="ty-check" viewBox="0 0 48 48" fill="none" aria-hidden="true">
					<circle class="ty-check-ring" cx="24" cy="24" r="23" pathLength="1" />
					<path class="ty-check-mark" d="M15.5 24.5l5.75 5.75L32.5 19" pathLength="1" />
				</svg>
				<p class="eyebrow ty-rise" style="--d: 250ms">Consultation request received</p>
				<h1 id="ty-title" class="ty-rise" style="--d: 330ms">
					<span>Thank you.</span>
					<span>Your residence is in considered hands.</span>
				</h1>
				<p class="ty-hero-lede ty-rise" style="--d: 410ms">
					Your request has reached our design studio in Manhattan&nbsp;Beach. A senior specialist will
					contact you personally within one business day.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. What happens next -->
	<section class="ty-next" id="next" aria-labelledby="ty-next-title">
		<div class="page">
			<header class="ty-head" data-reveal>
				<div>
					<p class="eyebrow">What happens next</p>
					<h2 id="ty-next-title">From first conversation to a considered design</h2>
				</div>
				<p class="ty-head-intro">
					Four steps, taken at your pace. Nothing is installed until the design is right for you and your
					home.
				</p>
			</header>

			<ol class="ty-steps" data-reveal>
				{steps.map((step, i) => (
					<li class="ty-step" style={`--i: ${i}`}>
						<span class="ty-step-node" aria-hidden="true"></span>
						{i < steps.length - 1 && <span class="ty-step-line" aria-hidden="true"></span>}
						<div class="ty-step-head">
							<span class="ty-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<h3>{step.title}</h3>
							<p class="ty-step-when">{step.when}</p>
						</div>
						<p class="ty-step-body">{step.body}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- 3. Before we speak -->
	<section class="ty-prep" aria-labelledby="ty-prep-title">
		<div class="page ty-prep-grid">
			<div class="ty-prep-intro" data-reveal>
				<p class="eyebrow">Before we speak</p>
				<h2 id="ty-prep-title"><span>A few things that help,</span> <span>if you have them</span></h2>
				<p>
					If any of these are to hand, they let our first conversation go further. Share them whenever it
					suits you, by email or on the call.
				</p>
			</div>

			<div class="ty-prep-list" data-reveal>
				<ul class="ty-checklist">
					{helpful.map((item) => (
						<li>
							<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
								<path d="M4.5 10.5l3.5 3.5 7.5-8" />
							</svg>
							<span>{item}</span>
						</li>
					))}
				</ul>
				<p class="ty-prep-note">None of this is required. We’re glad to begin with a conversation.</p>
			</div>
		</div>
	</section>

	<!-- 4. Direct line -->
	<section class="ty-direct" aria-labelledby="ty-direct-title">
		<div class="page">
			<div class="ty-card" data-reveal>
				<div class="ty-card-intro">
					<p class="eyebrow">Direct line</p>
					<h2 id="ty-direct-title">Prefer to speak now?</h2>
					<p>
						Our Manhattan Beach studio is glad to take your call. Mention your consultation request and we will
						pick up where you left off.
					</p>
				</div>

				<dl class="ty-contact">
					<div class="ty-contact-row">
						<dt>Call the studio</dt>
						<dd class="ty-phones">
							{phones.map((phone, i) => (
								<a
									class:list={['ty-phone', { 'ty-phone-primary': i === 0 }]}
									href={phone.href}
									data-track="ty-call"
								>
									<span class="visually-hidden">Call </span>
									<span class="ty-phone-number">{phone.display}</span>
									{i === 0 && (
										<span class="ty-phone-action" aria-hidden="true">
											Call
											<svg viewBox="0 0 16 16" fill="none">
												<path d="M1 8h13M9 3l5 5-5 5" />
											</svg>
										</span>
									)}
								</a>
							))}
						</dd>
					</div>
					<div class="ty-contact-row">
						<dt>Email</dt>
						<dd>
							<a class="ty-email" href={`mailto:${siteInfo.email}`} data-track="ty-email">{siteInfo.email}</a>
						</dd>
					</div>
					<div class="ty-contact-row">
						<dt>Studio</dt>
						<dd>
							<address>
								{addressLines.map((line) => <span>{line}</span>)}
							</address>
						</dd>
					</div>
				</dl>

				<div class="ty-partner">
					<p>Architect, designer or builder?</p>
					<a href={withBase('/design-partners/')} data-track="ty-partner">
						Explore our Design Partner <span class="ty-nowrap">program<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M1 8h13M9 3l5 5-5 5" />
							</svg></span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. Trust strip: static on purpose, no marquee. -->
	<section class="ty-trust" aria-label="Credentials and platforms">
		<div class="page">
			<div class="ty-trust-row" data-reveal>
				<p class="ty-trust-stats">
					<span class="ty-trust-stat"><strong>17+</strong> years</span>
					<span class="ty-trust-sep" aria-hidden="true"></span>
					<span class="ty-trust-stat"><strong>400+</strong> residences integrated</span>
				</p>
				<ul class="ty-badges">
					{badges.map((badge) => (
						<li class:list={['ty-badge', { 'ty-badge-mono': badge.mono }]}>
							<img
								src={withBase(badge.src)}
								alt={badge.alt}
								width={badge.width}
								height={badge.height}
								loading="lazy"
								decoding="async"
							/>
						</li>
					))}
				</ul>
			</div>
			<div class="ty-brands" data-reveal>
				<p class="ty-brands-label">Integrated with</p>
				<ul>
					{brands.map((brand) => <li>{brand}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<!-- 6. While you wait -->
	<section class="ty-onward" aria-labelledby="ty-onward-title">
		<div class="page">
			<header class="ty-head" data-reveal>
				<div>
					<p class="eyebrow">While you wait</p>
					<h2 id="ty-onward-title">Explore at your leisure</h2>
				</div>
				<p class="ty-head-intro">A few places to begin, should you like to know us a little better first.</p>
			</header>

			<ul class="ty-tiles" data-reveal>
				{onward.map((card, i) => (
					<li style={`--i: ${i}`}>
						<a class="ty-tile" href={card.href} data-track={card.track}>
							<div class="ty-tile-media">
								<Picture id={card.image} alt={card.alt} sizes={tileSizes(card.image)} />
							</div>
							<h3>{card.title}</h3>
							<p>{card.text}</p>
							<span class="ty-tile-cta">
								{card.cta}
								<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
									<path d="M1 8h13M9 3l5 5-5 5" />
								</svg>
							</span>
						</a>
					</li>
				))}
			</ul>

			<!-- 7. Quiet close: a text link, no buttons. -->
			<div class="ty-close" data-reveal>
				<a href={withBase('/')} data-track="ty-home">
					<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d="M15 8H2M7 3L2 8l5 5" />
					</svg>
					Return to home
				</a>
			</div>
		</div>
	</section>
</div>

<script>
	// One-time reveals for everything below the hero. Content is only hidden once
	// this script has run (data-motion="on"), so it never stays invisible if JS
	// fails, and reduced-motion visitors simply get the static page.
	const root = document.querySelector<HTMLElement>('[data-ty]');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (root && !reduce && 'IntersectionObserver' in window) {
		root.dataset.motion = 'on';
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-in');
					io.unobserve(entry.target);
				});
			},
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.12 }
		);
		root.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
	}
</script>

<style>
	/* ---------- Shared ---------- */
	.ty h2 {
		margin: 0;
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.ty svg path,
	.ty svg circle {
		stroke: currentColor;
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ty-head {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: var(--space-8) clamp(2rem, 6vw, 6rem);
		align-items: end;
		margin-bottom: clamp(3rem, 6vw, 5.5rem);
	}

	.ty-head h2 {
		max-width: 18ch;
	}

	.ty-head-intro {
		margin: 0;
		font-size: var(--text-body-lg);
		line-height: 1.65;
		max-width: 30rem;
	}

	/* ---------- 1. Hero ---------- */
	.ty-hero {
		position: relative;
		/* Tucks the hero up behind the sticky header so a transparent header
		   reveals the photograph instead of the cream page background. */
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: max(90vh, 600px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		isolation: isolate;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	/* Measures the first ~80px of scroll so the sticky header knows when to
	   stop being transparent, see Header.astro's script. */
	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.ty-hero-media {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	/* The entry door sits just left of centre; anchoring there keeps it in frame
	   from the 16:9 desktop crop down to a tall phone crop. */
	.ty-hero-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 46% 50%;
		animation: ty-settle 1600ms var(--ease-out-expo) both;
	}

	@keyframes ty-settle {
		from {
			transform: scale(1.04);
		}
		to {
			transform: none;
		}
	}

	/* Charcoal from the bottom-left, where the copy sits, clearing towards the
	   lit doorway. The top band keeps the transparent header legible. */
	.ty-hero-scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(180deg, rgba(10, 10, 10, 0.5) 0%, rgba(10, 10, 10, 0) 22%),
			linear-gradient(0deg, rgba(16, 16, 16, 0.55) 0%, rgba(16, 16, 16, 0) 45%),
			linear-gradient(90deg, rgba(22, 22, 22, 0.78) 0%, rgba(22, 22, 22, 0.5) 38%, rgba(22, 22, 22, 0) 68%);
	}

	.ty-hero-inner {
		width: 100%;
		max-width: var(--page-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		padding-top: calc(var(--header-height, 96px) + var(--space-16));
		padding-bottom: clamp(4rem, 11vh, 7.5rem);
	}

	.ty-hero-copy {
		max-width: 46rem;
	}

	.ty-check {
		width: clamp(40px, 3.4vw, 48px);
		height: auto;
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
		color: var(--color-accent-hover);
		overflow: visible;
	}

	.ty-check .ty-check-ring {
		stroke-width: 1;
		/* Start the stroke at twelve o'clock rather than three. */
		transform: rotate(-90deg);
		transform-origin: center;
		transform-box: fill-box;
		stroke-dasharray: 1;
		animation: ty-draw 650ms var(--ease-out-expo) 150ms both;
	}

	.ty-check .ty-check-mark {
		stroke-width: 1.5;
		stroke-dasharray: 1;
		animation: ty-draw 450ms var(--ease-out-expo) 600ms both;
	}

	@keyframes ty-draw {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	/* Gold lifted towards white: plain gold over the dusk photograph was
	   ~4:1, too little for small caps. */
	.ty-hero .eyebrow {
		display: block;
		margin: 0 0 var(--space-4);
		color: color-mix(in srgb, var(--color-gold-light) 68%, var(--color-white));
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
	}

	.ty-hero h1 {
		margin: 0 0 var(--space-6);
		font-size: clamp(2.25rem, 4.2vw, 3.75rem);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.02em;
		color: var(--color-text-on-dark);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
	}

	.ty-hero h1 span {
		display: block;
		text-wrap: balance;
	}

	.ty-hero-lede {
		margin: 0;
		max-width: 34rem;
		font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.88);
		text-shadow: 0 1px 16px rgba(0, 0, 0, 0.45);
	}

	/* Eyebrow, headline and lede follow each other 80ms apart. */
	.ty-rise {
		animation: ty-rise var(--dur-slow) var(--ease-out-expo) var(--d, 0ms) both;
	}

	@keyframes ty-rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* ---------- 2. What happens next ---------- */
	.ty-next {
		padding-block: clamp(5rem, 10vw, 9rem);
	}

	.ty-steps {
		--steps-gap: clamp(1.75rem, 3vw, 3rem);
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		/* Four shared rows (number, title, timing, body) so every column's
		   timing and body start on the same line, however the titles wrap. */
		grid-template-rows: repeat(4, auto);
		column-gap: var(--steps-gap);
	}

	/* A neutral track under the bronze connectors, running on past the last
	   node: the relationship continues after the proposal. */
	.ty-steps::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--color-border);
	}

	.ty-step {
		position: relative;
		display: grid;
		grid-row: span 4;
		grid-template-rows: subgrid;
		row-gap: 0;
		align-content: start;
		padding-top: var(--space-12);
	}

	.ty-step-head {
		display: contents;
	}

	.ty-step-node {
		position: absolute;
		top: -4px;
		left: 0;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: 1px solid var(--color-accent);
		background: var(--color-bg);
	}

	/* The last node is filled: the proposal is where this sequence lands. */
	.ty-step:last-child .ty-step-node {
		background: var(--color-accent);
	}

	/* Bronze hairline from this node to the next one. */
	.ty-step-line {
		position: absolute;
		top: 0;
		left: 13px;
		width: calc(100% + var(--steps-gap) - 17px);
		height: 1px;
		background: var(--color-accent);
		transform-origin: left center;
	}

	.ty-step-num {
		display: block;
		margin-bottom: var(--space-4);
		font-size: var(--text-sm);
