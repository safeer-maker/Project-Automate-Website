---
// Copy wraps naturally inside the measure below. An earlier version hard-coded
// four "display lines", but they were wider than the measure and wrapped again,
// which orphaned single words onto their own line.
const statement =
	'We create intelligent living environments where comfort, control and design work seamlessly as one, enhancing everyday life with clarity, simplicity, and precision.';

const words = statement.split(' ');
---

<section class="statement">
	<div class="page">
		<span class="eyebrow">Our Approach</span>
		<h2 data-reveal>
			{words.map((word) => (
				<span class="word">{word}&nbsp;</span>
			))}
		</h2>
	</div>
</section>

<script>
	const heading = document.querySelector<HTMLElement>('.statement [data-reveal]');

	if (heading) {
		const words = [...heading.querySelectorAll<HTMLElement>('.word')];
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (!reduce) {
			const DIM = 0.14;
			// How many words sit mid-fade at the leading edge. 1 would light each
			// word like a switch; a few words wide reads as a sweep.
			const FEATHER = 4;

			// Reveal runs between the heading's top passing 85% of the viewport
			// and reaching 30% — a little over half a screen of scrolling, so the
			// sentence finishes while it is still comfortably in view.
			const START = 0.85;
			const END = 0.3;

			let queued = false;

			const update = () => {
				queued = false;
				const top = heading.getBoundingClientRect().top;
				const vh = window.innerHeight;
				const raw = (vh * START - top) / (vh * START - vh * END);
				const progress = Math.min(1, Math.max(0, raw));
				const edge = progress * (words.length + FEATHER);

				words.forEach((word, i) => {
					const t = Math.min(1, Math.max(0, (edge - i) / FEATHER));
					word.style.opacity = String(DIM + (1 - DIM) * t);
				});
			};

			const onScroll = () => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(update);
			};

			update();
			window.addEventListener('resize', onScroll);

			// Only listen to scroll while the statement is near the viewport.
			const io = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						window.addEventListener('scroll', onScroll, { passive: true });
						update();
					} else {
						window.removeEventListener('scroll', onScroll);
					}
				},
				{ rootMargin: '100px 0px' }
			);
			io.observe(heading);
		}
	}
</script>

<style>
	.statement {
		background: var(--color-bg);
		padding-block: clamp(5rem, 12vw, 10rem);
	}

	.statement h2 {
		margin: 0;
		font-size: var(--text-display-sm);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--color-text);
		max-width: 32ch;
		text-wrap: balance;
	}

	.word {
		display: inline-block;
	}

	/* Without JS the sentence stays fully readable; the script dims it and then
	   drives opacity from scroll position. */
	@media (prefers-reduced-motion: reduce) {
		.word {
			opacity: 1 !important;
		}
	}
</style>
