---
// The belief line, directly under the hero. Copy wraps naturally inside the
// measure below. An earlier version hard-coded four "display lines", but they
// were wider than the measure and wrapped again, which orphaned single words
// onto their own line. id="approach" is the hero's "Discover the approach"
// target.
const statement =
	'A great home does not ask to be operated. Light, climate, sound and security simply respond, then step quietly out of sight.';

const words = statement.split(' ');
---

<section class="statement" id="approach" aria-labelledby="approach-title">
	<div class="page">
		<span class="eyebrow">Our Approach</span>
		<h2 id="approach-title" data-reveal>
			{words.map((word) => (
				<span class="word">{word}&nbsp;</span>
			))}
		</h2>
	</div>
</section>

<script>
	const heading = document.querySelector<HTMLElement>('.statement [data-reveal]');

	if (heading) {
		const words = [...heading.querySelectorAll<HTMLElement>('.word')];
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (!reduce) {
			const DIM = 0.14;
			// How many words sit mid-fade at the leading edge. 1 would light each
			// word like a switch; a few words wide reads as a sweep.
			const FEATHER = 4;

			// Anchored to the heading entering the viewport, not to an arbitrary
			// fraction of it. Progress is 0 when the heading's top edge is level
			// with the bottom of the screen — i.e. the instant the first word
			// becomes visible — and 1 once its bottom edge has risen to 65%.
			// Keying the start to 85% instead meant the sweep was already part-way
			// through by the time the sentence was actually on screen.
			const END_AT = 0.65;

			let queued = false;

			const update = () => {
				queued = false;
				const rect = heading.getBoundingClientRect();
				const vh = window.innerHeight;
				const start = vh;
				const end = vh * END_AT - rect.height;
				const span = start - end;
				const raw = span > 0 ? (start - rect.top) / span : 1;
				const progress = Math.min(1, Math.max(0, raw));
				const edge = progress * (words.length + FEATHER);

				words.forEach((word, i) => {
					const t = Math.min(1, Math.max(0, (edge - i) / FEATHER));
					word.style.opacity = String(DIM + (1 - DIM) * t);
				});
			};

			const onScroll = () => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(update);
			};

			update();
			window.addEventListener('resize', onScroll);

			// Only listen to scroll while the statement is near the viewport.
			const io = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						window.addEventListener('scroll', onScroll, { passive: true });
						update();
					} else {
						window.removeEventListener('scroll', onScroll);
					}
				},
				{ rootMargin: '100px 0px' }
			);
			io.observe(heading);
		}
	}
</script>

<style>
	.statement {
		background: var(--color-bg);
		padding-block: clamp(5rem, 12vw, 10rem);
		/* Landing from the hero's "Discover the approach": clears the sticky
		   header by a comfortable margin at every width. */
		scroll-margin-top: calc(var(--header-height, 96px) * 0.5);
	}

	.statement h2 {
		margin: 0;
		font-size: var(--text-display-sm);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--color-text);
		max-width: 32ch;
		text-wrap: balance;
	}

	.word {
		display: inline-block;
	}

	/* Without JS the sentence stays fully readable; the script dims it and then
	   drives opacity from scroll position. */
	@media (prefers-reduced-motion: reduce) {
		.word {
			opacity: 1 !important;
		}
	}
</style>
