---
import { withBase } from '../../lib/paths.ts';
import { siteInfo } from '../../data/site.ts';
import GhlForm from '../../components/ghl/GhlForm.astro';

// The HTA Design Partner mark is white-on-transparent, so it sits on a dark chip.
const badges = [
	{ src: withBase('/images/badges/17-years-badge.webp'), alt: '17+ years in business', width: 785, height: 932 },
	{ src: withBase('/images/badges/cedia-certified.webp'), alt: 'CEDIA Smart Home Certified Expert Provider', width: 1182, height: 1182 },
	{ src: withBase('/images/badges/cert-level-luxury.webp'), alt: 'HTA Certified, Luxury level', width: 1853, height: 870 },
	{ src: withBase('/images/badges/hta-design-partner.webp'), alt: 'HTA Design Partner', width: 280, height: 40, dark: true },
];

const steps = [
	'Share your residence, your design team and your timeline.',
	'A senior specialist reviews the details and replies personally.',
	'Together we plan the systems that suit the way you live.',
];

const [phone] = siteInfo.phones;
const tel = (value: string) => `tel:${value.replace(/[^\d+]/g, '')}`;
---

<section class="schedule">
	<div class="container schedule-grid">
		<div class="schedule-info">
			<span class="eyebrow">Private Consultation</span>
			<h1>Begin With a Private Consultation</h1>
			<p class="lede">
				Share a little about your residence and choose a time that suits you. A senior
				specialist will review the details personally and help you plan the right systems for
				your home.
			</p>

			<ol class="steps">
				{steps.map((step, i) => (
					<li>
						<span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
						{step}
					</li>
				))}
			</ol>

			<dl class="contact">
				<div>
					<dt>Studio</dt>
					<dd><a href={tel(phone)}>{phone}</a></dd>
				</div>
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></dd>
				</div>
				<div>
					<dt>Visit</dt>
					<dd>{siteInfo.address.line1}<br />{siteInfo.address.line2}</dd>
				</div>
			</dl>

			<ul class="badges">
				{badges.map((badge) => (
					<li class:list={['badge', { 'badge--dark': badge.dark }]}>
						<img src={badge.src} alt={badge.alt} width={badge.width} height={badge.height} loading="lazy" decoding="async" />
					</li>
				))}
			</ul>
		</div>

		<div class="schedule-form">
			{/* Keeps the outline h1 → h2 → h3: the footer's column headings are h3s. */}
			<h2 class="visually-hidden">Consultation request form</h2>
			<GhlForm primary />
		</div>
	</div>
</section>

<style>
	.schedule {
		padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4.5rem, 10vw, 8rem);
	}

	.schedule-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	/* The form is ~1200px tall; on screens tall enough to show the whole
	   introduction, it stays in view beside the form. */
	@media (min-width: 961px) and (min-height: 1000px) {
		.schedule-info {
			position: sticky;
			top: calc(var(--header-height, 96px) + var(--space-8));
		}
	}

	.schedule-info h1 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.lede {
		max-width: 32rem;
		margin-bottom: var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
	}

	.steps {
		margin-bottom: var(--space-8);
	}

	.steps li {
		display: flex;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-top: 1px solid var(--color-border);
		font-size: var(--text-base);
		line-height: 1.55;
		color: var(--color-text);
	}

	.steps li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.steps span {
		flex: none;
		width: 1.75rem;
		padding-top: 0.2em;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.contact {
		display: grid;
		gap: var(--space-3);
		margin: 0 0 var(--space-8);
	}

	.contact div {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: var(--space-4);
	}

	.contact dt {
		padding-top: 0.2em;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.contact dd {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	.contact a {
		transition: color var(--dur-fast) ease;
	}

	.contact a:hover,
	.contact a:focus-visible {
		color: var(--color-accent);
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 72px;
		height: 72px;
		padding: var(--space-2);
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
	}

	.badge--dark {
		width: 120px;
		background: var(--color-charcoal);
		border-color: var(--color-charcoal);
	}

	.badge img {
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	@media (max-width: 960px) {
		.schedule-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
