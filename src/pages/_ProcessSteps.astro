---
// How we work: an auto-advancing stepper. Nothing here is tied to the scroll:
// the section scrolls like any other, and once it is in view the steps play
// on their own, DWELL_MS each, while a bronze rail fills beside the active one
// to show the time left on it. Any step can be clicked, and pointing at or
// focusing the stepper holds it on the current step. Reduced-motion visitors
// get the same stepper without the autoplay. Before the script runs (or
// without it) it is a plain stacked list with every step and photograph shown.
import Picture from '../components/ui/Picture.astro';
import { withBase } from '../lib/paths.ts';
import type { LibraryImageId } from '../lib/images.ts';

// Long enough to read the longest description twice over at a calm pace.
const DWELL_MS = 7000;

const steps: { title: string; description: string; image: LibraryImageId; alt: string }[] = [
	{
		title: 'Understand',
		description:
			'We begin with how you live: the rooms you gather in, the moments that matter, and what should simply disappear.',
		image: 'process/understand',
		alt: 'Homeowners and a designer reviewing material samples and plans at a kitchen table',
	},
	{
		title: 'Design',
		description:
			'Every system is planned around the architecture and interiors, in step with your architect and designer, down to each keypad and sightline.',
		image: 'process/design',
		alt: 'White architectural model of a modern house on a desk beside drawings',
	},
	{
		title: 'Integrate',
		description: 'Installed, connected and programmed with precision, and with minimal visual impact.',
		image: 'process/integrate',
		alt: 'A technician at work in a landscaped garden at dusk, path lights glowing',
	},
	{
		title: 'Deliver',
		description:
			'We commission every scene, walk you through the home and hand over complete documentation. Our concierge team then stays on to care for it.',
		image: 'process/deliver',
		alt: 'A finished residence glowing at dusk at the end of a palm-lined drive',
	},
];

// Stacked: full width on phones, half the grid from 600px. Stepper (≥900px):
// the right-hand column, 1/2 of the page below 1200px and 7/12 above.
const mediaSizes =
	'(max-width: 599px) calc(100vw - 2.5rem), (max-width: 1199px) 46vw, (min-width: 1440px) 800px, 56vw';
---

<section
	class="process"
	id="process"
	data-process
	data-dwell={DWELL_MS}
	style={`--dwell:${DWELL_MS}ms`}
	aria-labelledby="process-title"
>
	<div class="page">
		<header class="process-intro">
			<h2 id="process-title">From vision to<br />effortless living.</h2>
			<p>
				Four considered steps and one team, from first conversation to the day you move in and
				beyond.
			</p>
		</header>

		<div class="process-body">
			<div class="process-list">
				<ol class="steps">
					{steps.map((step, i) => (
						<li class:list={['step', { 'is-active': i === 0 }]} data-step={i}>
							<div class="step-head">
								<span class="rail" aria-hidden="true"><span class="rail-fill" /></span>
								<h3 class="step-title">
									<button type="button" class="step-btn">
										<span class="num">{String(i + 1).padStart(2, '0')}</span>
										<span class="title">{step.title}</span>
									</button>
								</h3>
								<p class="desc"><span>{step.description}</span></p>
							</div>
							<figure class="step-media">
								<Picture id={step.image} alt={step.alt} sizes={mediaSizes} />
							</figure>
						</li>
					))}
				</ol>

				<a class="text-link" href={withBase('/technology-support-membership/')}>
					About concierge care
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			</div>

			{/* Sizes the photograph slot; every step's photo sits over it. */}
			<div class="process-frame" aria-hidden="true"></div>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-process]');

	if (section) {
		const body = section.querySelector<HTMLElement>('.process-body')!;
		const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
		const buttons = steps.map((step) => step.querySelector<HTMLButtonElement>('.step-btn')!);
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

		let active = 0;
		let inView = false;
		let hovered = false;
		let focused = false;

		const setActive = (index: number) => {
			active = (index + steps.length) % steps.length;
			steps.forEach((step, i) => {
				step.classList.toggle('is-active', i === active);
				if (i === active) buttons[i].setAttribute('aria-current', 'step');
				else buttons[i].removeAttribute('aria-current');
			});
		};

		// The timer is the rail itself: its fill is a CSS animation of --dwell,
		// and when it ends the next step takes over. Pausing the animation
		// pauses the timer, so the two can never disagree.
		const syncPlayback = () => {
			const playing = inView && !hovered && !focused && !reduce.matches && !document.hidden;
			section.classList.toggle('is-playing', playing);
		};

		steps.forEach((step) => {
			step.querySelector('.rail-fill')!.addEventListener('animationend', () => {
				if (step.classList.contains('is-active')) setActive(active + 1);
			});
		});

		buttons.forEach((button, i) => {
			button.addEventListener('click', () => {
				if (i === active) return;
				setActive(i);
			});
		});

		// Hold on the current step while the visitor is reading or using it.
		// Mouse only: a tap fires pointerenter too, and would freeze the
		// stepper on touch screens until the next tap elsewhere.
		body.addEventListener('pointerenter', (event) => {
			if (event.pointerType !== 'mouse') return;
			hovered = true;
			syncPlayback();
		});
		body.addEventListener('pointerleave', () => {
			hovered = false;
			syncPlayback();
		});
		body.addEventListener('focusin', (event) => {
			// Only keyboard focus holds it; a mouse click focuses the button too.
			focused = (event.target as HTMLElement).matches(':focus-visible');
			syncPlayback();
		});
		body.addEventListener('focusout', (event) => {
			if (body.contains(event.relatedTarget as Node | null)) return;
			focused = false;
			syncPlayback();
		});

		// Only play while most of the stepper is on screen, so a visitor
		// arriving at it always starts from a step with its full time ahead.
		new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				syncPlayback();
			},
			{ threshold: 0.45 }
		).observe(body);

		document.addEventListener('visibilitychange', syncPlayback);
		reduce.addEventListener('change', syncPlayback);

		section.classList.add('is-stepper');
		setActive(0);
		syncPlayback();
	}
</script>

<style>
	/* ---------- Stacked (default: before the script runs) ---------- */

	.process {
		position: relative;
		background: var(--color-bg);
		padding-block: var(--section-pad);
		/* /#process lands with the heading clear of the sticky header. */
		scroll-margin-top: var(--header-height, 96px);
		--gap: clamp(2rem, 5vw, 4.5rem);
		--rail-inset: clamp(1.25rem, 2vw, 1.75rem);
	}

	/* Headline and its line stacked together, so they read as one thought. */
	.process-intro {
		margin-bottom: clamp(3rem, 7vw, 5rem);
	}

	.process-intro h2 {
		margin: 0;
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.process-intro p {
		margin: var(--space-4) 0 0;
		max-width: 30rem;
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(3rem, 6vw, 4rem) clamp(1.25rem, 3vw, 2.5rem);
	}

	.step {
		display: flex;
		flex-direction: column;
	}

	.step-head {
		position: relative;
	}

	.step-title {
		margin: 0;
	}

	.step-btn {
		display: flex;
		align-items: baseline;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		width: 100%;
		padding: var(--space-4) 0 var(--space-3);
		background: none;
		border: 0;
		text-align: left;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}

	.step-btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
		border-radius: 2px;
	}

	.num {
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.14em;
		font-variant-numeric: tabular-nums;
		color: var(--color-bronze-text);
	}

	.title {
		font-size: var(--text-step);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: var(--color-text);
	}

	.desc {
		display: grid;
		grid-template-rows: 1fr;
		margin: 0;
		max-width: 32rem;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	.desc > span {
		overflow: hidden;
		min-height: 0;
	}

	.rail {
		display: none;
	}

	/* Photograph above its step when stacked; it carries more than the words. */
	.step-media {
		order: -1;
		position: relative;
		margin: 0;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-2);
	}

	.step-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.process-frame {
		display: none;
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		margin-top: clamp(2.5rem, 6vw, 3.5rem);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		letter-spacing: 0.01em;
		color: var(--color-text);
		transition: color var(--dur-fast) var(--ease-in-out-soft);
	}

	.text-link svg {
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	/* Text bronze: the brand bronze is 4.2:1 on cream at this size. */
	.text-link:hover {
		color: var(--color-bronze-text);
	}

	.text-link:hover svg {
		transform: translateX(4px);
	}

	@media (max-width: 599px) {
		.steps {
			grid-template-columns: 1fr;
		}
	}

	/* ---------- Stepper (script adds .is-stepper) ---------- */

	/* One photograph slot over a vertical list on phones and tablets; side by
	   side from 900px. The frame sizes the slot and every step's photo is laid
	   over it at the same width and ratio, so swapping steps never changes the
	   section's height by more than the difference between two descriptions. */
	.process.is-stepper .process-body {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		row-gap: clamp(1.5rem, 4vw, 2.5rem);
		--ratio: 3 / 2;
		--media-w: 100%;
	}

	.process.is-stepper .process-frame {
		display: block;
		grid-row: 1;
		aspect-ratio: var(--ratio);
	}

	.process.is-stepper .steps {
		display: block;
	}

	.process.is-stepper .step-head {
		padding-left: var(--rail-inset);
	}

	/* The rail: a hairline beside each step, and on the active one a bronze
	   fill that runs for --dwell. That animation is the autoplay timer (the
	   script listens for its end), so it only runs while .is-playing. */
	.process.is-stepper .rail {
		display: block;
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-border);
		overflow: hidden;
	}

	.process.is-stepper .rail-fill {
		position: absolute;
		inset: 0;
		background: var(--color-accent);
		transform: scaleY(0);
		transform-origin: top;
	}

	.process.is-stepper .step.is-active .rail-fill {
		animation: rail-fill var(--dwell) linear forwards;
		animation-play-state: paused;
	}

	.process.is-playing .step.is-active .rail-fill {
		animation-play-state: running;
	}

	@keyframes rail-fill {
		to {
			transform: scaleY(1);
		}
	}

	.process.is-stepper .step-btn {
		padding-block: clamp(0.75rem, 1.6vw, 1.05rem);
	}

	/* Inactive steps recede by colour, not opacity: fading the title to
	   0.38 left it at 2.4:1. The muted brown still reads (6:1) while the
	   bronze rail and the opened description carry the active step. */
	.process.is-stepper .title {
		color: var(--color-text-muted);
		transition: color var(--dur-base) var(--ease-in-out-soft);
	}

	.process.is-stepper .step-btn:hover .title,
	.process.is-stepper .step.is-active .title {
		color: var(--color-text);
	}

	/* Collapsed until active; 0fr → 1fr animates a wrapping paragraph without
	   hard-coding its height. */
	.process.is-stepper .desc {
		grid-template-rows: 0fr;
		opacity: 0;
		font-size: var(--text-body-lg);
		max-width: 30rem;
		transition:
			grid-template-rows 700ms var(--ease-out-expo),
			opacity 700ms var(--ease-out-expo),
			padding-bottom 700ms var(--ease-out-expo);
	}

	.process.is-stepper .step.is-active .desc {
		grid-template-rows: 1fr;
		opacity: 1;
		padding-bottom: clamp(0.75rem, 1.6vw, 1.05rem);
	}

	.process.is-stepper .text-link {
		margin-top: clamp(1.5rem, 4vw, 2.5rem);
		margin-left: var(--rail-inset);
	}

	/* Every photograph is laid over the frame, one on top of the other; the
	   active one fades up and settles. Positioned against .process-body (the
	   <li> and list stay unpositioned) so each image can live beside its own
	   step in the markup. Only the incoming photograph fades; the outgoing one
	   holds at full opacity underneath for the length of the fade, then drops.
	   Fading both at once left ~25% of the cream page showing through
	   mid-crossfade, a milky wash on every step change (same technique as
	   DayAtHome). */
	.process.is-stepper .step-media {
		position: absolute;
		top: 0;
		right: 0;
		width: var(--media-w);
		aspect-ratio: var(--ratio);
		opacity: 0;
		transition: opacity 0s linear 900ms;
	}

	.process.is-stepper .step-media :global(img) {
		transform: scale(1.05);
		transition: transform 1600ms var(--ease-out-expo);
	}

	.process.is-stepper .step.is-active .step-media {
		opacity: 1;
		z-index: 1;
		transition: opacity 900ms var(--ease-in-out-soft);
	}

	.process.is-stepper .step.is-active .step-media :global(img) {
		transform: scale(1);
	}

	@media (min-width: 900px) {
		.process.is-stepper .process-body {
			grid-template-columns: minmax(0, var(--col-a)) minmax(0, var(--col-b));
			column-gap: var(--gap);
			align-items: start;
			--col-a: 1fr;
			--col-b: 1fr;
			--ratio: 4 / 3;
			/* The frame's column: what's left after the gap, at col-b's share. */
			--media-w: calc((100% - var(--gap)) * var(--share));
			--share: 0.5;
		}

		.process.is-stepper .process-list {
			grid-column: 1;
			grid-row: 1;
		}

		.process.is-stepper .process-frame {
			grid-column: 2;
		}
	}

	@media (min-width: 1200px) {
		.process.is-stepper .process-body {
			--col-a: 5fr;
			--col-b: 7fr;
			--share: calc(7 / 12);
			--ratio: 3 / 2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		/* No autoplay (the script never adds .is-playing): the active step
		   shows a full rail, and only the decorative movement goes. */
		.process.is-stepper .step.is-active .rail-fill {
			animation: none;
			transform: none;
		}
		.process.is-stepper .desc,
		.process.is-stepper .title {
			transition: none;
		}
		.process.is-stepper .step-media {
			transition: opacity 0s linear 200ms;
		}
		.process.is-stepper .step.is-active .step-media {
			transition: opacity 200ms linear;
		}
		.process.is-stepper .step-media :global(img),
		.process.is-stepper .step.is-active .step-media :global(img) {
			transform: none;
			transition: none;
		}
	}
</style>
