---
// How we work: an auto-advancing stepper laid out as an editorial spread.
// The headline and the steps share one column whose top and bottom edges
// line up with the photograph beside it, and the photograph runs off the
// right edge of the screen. Nothing is tied to the scroll: once the spread
// is in view the steps play on their own, DWELL_MS each, while a bronze rail
// fills beside the active one to show its time left. Each new photograph
// wipes in from the bleed edge and slowly settles for the rest of its step;
// the large numeral on it ties it back to the list. Any step can be clicked,
// and pointing at or keyboard-focusing the spread holds it. Reduced-motion
// visitors get the same stepper without the autoplay or the movement. Before
// the script runs (or without it) every description is open and the first
// photograph shows.
//
// The four photographs run from daylight to dusk (a kitchen table, the
// studio, the garden as the lights come on, the finished home lit at night),
// so the set reads as one evening arriving rather than four stock frames.
import Picture from '../components/ui/Picture.astro';
import { withBase } from '../lib/paths.ts';
import type { LibraryImageId } from '../lib/images.ts';

// Long enough to read the longest description twice over at a calm pace.
const DWELL_MS = 7000;

const steps: {
	title: string;
	description: string;
	image: LibraryImageId;
	alt: string;
	// object-position for the spread's squarer crop of a 3:2 photograph.
	focus?: string;
}[] = [
	{
		title: 'Understand',
		description:
			'We begin with how you live: the rooms you gather in, the moments that matter, and what should simply disappear.',
		image: 'process/understand',
		alt: 'Homeowners and a designer reviewing material samples and plans at a kitchen table',
		focus: '50% 60%',
	},
	{
		title: 'Design',
		description:
			'Every system is planned around the architecture and interiors, in step with your architect and designer, down to each keypad and sightline.',
		image: 'process/design',
		alt: 'White architectural model of a modern house on a desk beside drawings',
		focus: '55% 50%',
	},
	{
		title: 'Integrate',
		description: 'Installed, connected and programmed with precision, and with minimal visual impact.',
		image: 'process/integrate',
		alt: 'A technician at work in a landscaped garden at dusk, path lights glowing',
		focus: '40% 50%',
	},
	{
		title: 'Deliver',
		description:
			'We commission every scene, walk you through the home and hand over complete documentation. Our concierge team then stays on to care for it.',
		image: 'process/deliver',
		alt: 'A finished residence glowing at dusk at the end of a palm-lined drive',
		focus: '50% 55%',
	},
];

const pad = (n: number) => String(n).padStart(2, '0');

// Phones/tablets: the page width. Spread (≥900px): the 7/12 column plus the
// bleed into the right gutter, ~820px at 1440 and half the screen beyond.
const mediaSizes = '(max-width: 899px) calc(100vw - 2.5rem), (min-width: 1440px) calc(50vw + 100px), 62vw';
---

<section
	class="process"
	id="process"
	data-process
	style={`--dwell:${DWELL_MS}ms`}
	aria-labelledby="process-title"
>
	<div class="page">
		<div class="process-layout">
			<header class="process-intro">
				<h2 id="process-title">From vision to<br />effortless living.</h2>
				<p>
					Four considered steps and one team, from first conversation to the day you move in and
					beyond.
				</p>
			</header>

			<div class="process-stage">
				{steps.map((step, i) => (
					<figure class:list={['stage-media', { 'is-active': i === 0 }]} data-media={i} style={step.focus && `--focus:${step.focus}`}>
						<Picture id={step.image} alt={step.alt} sizes={mediaSizes} />
					</figure>
				))}
				<div class="stage-count" aria-hidden="true">
					<span class="count-nums">
						{steps.map((_, i) => (
							<span class:list={['count-num', { 'is-active': i === 0 }]} data-count={i}>{pad(i + 1)}</span>
						))}
					</span>
					<span class="count-total">/ {pad(steps.length)}</span>
				</div>
			</div>

			<div class="process-list">
				<ol class="steps">
					{steps.map((step, i) => (
						<li class:list={['step', { 'is-active': i === 0 }]} data-step={i}>
							<span class="rail" aria-hidden="true"><span class="rail-fill" /></span>
							<h3 class="step-title">
								<button type="button" class="step-btn">
									<span class="num">{pad(i + 1)}</span>
									<span class="title">{step.title}</span>
								</button>
							</h3>
							<p class="desc"><span>{step.description}</span></p>
						</li>
					))}
				</ol>

				<a class="text-link" href={withBase('/technology-support-membership/')}>
					About concierge care
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-process]');

	if (section) {
		const layout = section.querySelector<HTMLElement>('.process-layout')!;
		const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
		const media = [...section.querySelectorAll<HTMLElement>('[data-media]')];
		const counts = [...section.querySelectorAll<HTMLElement>('[data-count]')];
		const buttons = steps.map((step) => step.querySelector<HTMLButtonElement>('.step-btn')!);
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

		let active = 0;
		let inView = false;
		let hovered = false;
		let focused = false;

		const setActive = (index: number) => {
			active = (index + steps.length) % steps.length;
			[steps, media, counts].forEach((group) =>
				group.forEach((el, i) => el.classList.toggle('is-active', i === active))
			);
			buttons.forEach((button, i) => {
				if (i === active) button.setAttribute('aria-current', 'step');
				else button.removeAttribute('aria-current');
			});
		};

		// The timer is the rail itself: its fill is a CSS animation of --dwell,
		// and when it ends the next step takes over. Pausing the animation
		// pauses the timer, so the two can never disagree.
		const syncPlayback = () => {
			const playing = inView && !hovered && !focused && !reduce.matches && !document.hidden;
			section.classList.toggle('is-playing', playing);
		};

		steps.forEach((step) => {
			step.querySelector('.rail-fill')!.addEventListener('animationend', () => {
				if (step.classList.contains('is-active')) setActive(active + 1);
			});
		});

		buttons.forEach((button, i) => {
			button.addEventListener('click', () => {
				if (i !== active) setActive(i);
			});
		});

		// Hold on the current step while the visitor is reading or using it.
		// Mouse only: a tap fires pointerenter too, and would freeze the
		// stepper on touch screens until the next tap elsewhere.
		layout.addEventListener('pointerenter', (event) => {
			if (event.pointerType !== 'mouse') return;
			hovered = true;
			syncPlayback();
		});
		layout.addEventListener('pointerleave', () => {
			hovered = false;
			syncPlayback();
		});
		layout.addEventListener('focusin', (event) => {
			// Only keyboard focus holds it; a mouse click focuses the button too.
			focused = (event.target as HTMLElement).matches(':focus-visible');
			syncPlayback();
		});
		layout.addEventListener('focusout', (event) => {
			if (layout.contains(event.relatedTarget as Node | null)) return;
			focused = false;
			syncPlayback();
		});

		// Only play while most of the spread is on screen, so a visitor
		// arriving at it always starts from a step with its full time ahead.
		new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				syncPlayback();
			},
			{ threshold: 0.45 }
		).observe(layout);

		document.addEventListener('visibilitychange', syncPlayback);
		reduce.addEventListener('change', syncPlayback);

		section.classList.add('is-stepper');
		setActive(0);
		syncPlayback();
	}
</script>

<style>
	.process {
		position: relative;
		background: var(--color-bg);
		padding-block: var(--section-pad);
		/* The photograph bleeds into the right gutter; clip (not hidden) so
		   the section never scrolls sideways and sticky elsewhere still works. */
		overflow-x: clip;
		/* /#process lands with the heading clear of the sticky header. */
		scroll-margin-top: var(--header-height, 96px);
		--gap: clamp(2rem, 5vw, 5rem);
		--rail-inset: clamp(1.25rem, 2vw, 1.75rem);
		--wipe: 1100ms;
	}

	/* ---------- Layout ---------- */

	/* Phones and tablets: headline, photograph, steps, one column. */
	.process-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'intro' 'stage' 'list';
		row-gap: clamp(2rem, 6vw, 3rem);
	}

	.process-intro {
		grid-area: intro;
	}

	.process-stage {
		grid-area: stage;
	}

	.process-list {
		grid-area: list;
	}

	/* From 900px: an editorial spread. The headline opens the left column and
	   the steps close it, so the column's top and bottom edges are the
	   photograph's; the photograph spans both rows and runs off the screen's
	   right edge (past the page cap on wide screens too). */
	@media (min-width: 900px) {
		.process-layout {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			grid-template-rows: auto 1fr;
			grid-template-areas: 'intro stage' 'list stage';
			column-gap: var(--gap);
			row-gap: clamp(2.5rem, 5vh, 4rem);
		}

		.process-list {
			align-self: end;
		}

		.process-stage {
			/* Tall enough to hold the column, never taller than the screen
			   below the header, so the whole spread is seen at once. */
			min-height: clamp(520px, min(48vw, calc(100vh - var(--header-height, 96px) - 5rem)), 800px);
			margin-right: calc(-1 * (var(--page-gutter) + max(0px, (100vw - var(--page-max)) / 2)));
			border-radius: var(--radius-md) 0 0 var(--radius-md);
		}
	}

	@media (min-width: 900px) and (max-width: 1199px) {
		.process-layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	/* ---------- Headline ---------- */

	.process-intro h2 {
		margin: 0;
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.process-intro p {
		margin: var(--space-4) 0 0;
		max-width: 30rem;
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	/* ---------- Photograph ---------- */

	.process-stage {
		position: relative;
		aspect-ratio: 5 / 4;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-2);
		/* Its own layer, so the wipe and the slow zoom stay on the GPU. */
		isolation: isolate;
	}

	@media (min-width: 900px) {
		.process-stage {
			aspect-ratio: auto;
		}
	}

	/* Only the active photograph is shown before the script runs. With it,
	   the incoming one wipes in from the bleed edge over the outgoing one,
	   which holds at full strength underneath until it is covered, so there
	   is never a flash of the cream page between two photographs. */
	.stage-media {
		position: absolute;
		inset: 0;
		margin: 0;
		clip-path: inset(0 0 0 100%);
		transition: clip-path 0s linear var(--wipe);
	}

	.stage-media.is-active {
		z-index: 1;
		clip-path: inset(0);
		transition: clip-path var(--wipe) var(--ease-out-expo);
	}

	.stage-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--focus, 50% 50%);
		/* Reset only once the photograph is fully covered. */
		transform: scale(1.12);
		transition: transform 0s linear var(--wipe);
	}

	/* The slow settle runs for the whole step, so the frame is never still
	   while the rail is filling. */
	.process.is-stepper .stage-media.is-active :global(img) {
		transform: scale(1);
		transition: transform calc(var(--dwell) + var(--wipe)) cubic-bezier(0.2, 0.6, 0.3, 1);
	}

	/* Before the script: no zoom to settle from. */
	.process:not(.is-stepper) .stage-media :global(img) {
		transform: none;
	}

	/* A soft scrim at the foot of the photograph for the numeral. */
	.process-stage::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 45%;
		z-index: 2;
		background: linear-gradient(to top, rgb(20 17 14 / 0.55), rgb(20 17 14 / 0));
		pointer-events: none;
	}

	/* The step's numeral, large on the photograph: what ties the picture to
	   the list beside it. Each numeral rises into place as its step begins. */
	.stage-count {
		position: absolute;
		left: clamp(1.25rem, 3vw, 2.5rem);
		bottom: clamp(1rem, 2.5vw, 2rem);
		z-index: 3;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		color: var(--color-white);
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.count-nums {
		display: grid;
		overflow: hidden;
		font-size: clamp(3.5rem, 7vw, 6.5rem);
		font-weight: var(--fw-medium);
		letter-spacing: -0.03em;
	}

	.count-num {
		grid-area: 1 / 1;
		opacity: 0;
		transform: translateY(60%);
		transition:
			opacity 500ms var(--ease-in-out-soft),
			transform 900ms var(--ease-out-expo);
	}

	.count-num.is-active {
		opacity: 1;
		transform: none;
		transition-delay: 150ms;
	}

	.count-total {
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		letter-spacing: 0.08em;
		opacity: 0.8;
	}

	/* ---------- Steps ---------- */

	.steps {
		display: block;
	}

	.step {
		position: relative;
		padding-left: var(--rail-inset);
	}

	.step-title {
		margin: 0;
	}

	.step-btn {
		display: flex;
		align-items: baseline;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		width: 100%;
		padding: clamp(0.75rem, 1.6vw, 1.05rem) 0;
		background: none;
		border: 0;
		text-align: left;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}

	.step-btn:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
		border-radius: 2px;
	}

	.num {
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.14em;
		font-variant-numeric: tabular-nums;
		color: var(--color-bronze-text);
	}

	.title {
		font-size: var(--text-step);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: var(--color-text);
	}

	.desc {
		display: grid;
		grid-template-rows: 1fr;
		margin: 0;
		max-width: 30rem;
		padding-bottom: clamp(0.75rem, 1.6vw, 1.05rem);
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	.desc > span {
		overflow: hidden;
		min-height: 0;
	}

	/* The rail: a hairline beside each step, and on the active one a bronze
	   fill that runs for --dwell. That animation is the autoplay timer (the
	   script listens for its end), so it only runs while .is-playing. */
	.rail {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-border);
		overflow: hidden;
	}

	.rail-fill {
		position: absolute;
		inset: 0;
		background: var(--color-accent);
		transform: scaleY(0);
		transform-origin: top;
	}

	.process.is-stepper .step.is-active .rail-fill {
		animation: rail-fill var(--dwell) linear forwards;
		animation-play-state: paused;
	}

	.process.is-playing .step.is-active .rail-fill {
		animation-play-state: running;
	}

	@keyframes rail-fill {
		to {
			transform: scaleY(1);
		}
	}

	/* Inactive steps recede by colour, not opacity: fading the title to
	   0.38 left it at 2.4:1. The muted brown still reads (6:1) while the
	   bronze rail and the opened description carry the active step. */
	.process.is-stepper .title {
		color: var(--color-text-muted);
		transition: color var(--dur-base) var(--ease-in-out-soft);
	}

	.process.is-stepper .step-btn:hover .title,
	.process.is-stepper .step.is-active .title {
		color: var(--color-text);
	}

	/* Collapsed until active; 0fr → 1fr animates a wrapping paragraph without
	   hard-coding its height. */
	.process.is-stepper .desc {
		grid-template-rows: 0fr;
		opacity: 0;
		padding-bottom: 0;
		transition:
			grid-template-rows 700ms var(--ease-out-expo),
			opacity 700ms var(--ease-out-expo),
			padding-bottom 700ms var(--ease-out-expo);
	}

	.process.is-stepper .step.is-active .desc {
		grid-template-rows: 1fr;
		opacity: 1;
		padding-bottom: clamp(0.75rem, 1.6vw, 1.05rem);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		margin-top: clamp(1.5rem, 4vw, 2.5rem);
		margin-left: var(--rail-inset);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		letter-spacing: 0.01em;
		color: var(--color-text);
		transition: color var(--dur-fast) var(--ease-in-out-soft);
	}

	.text-link svg {
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	/* Text bronze: the brand bronze is 4.2:1 on cream at this size. */
	.text-link:hover {
		color: var(--color-bronze-text);
	}

	.text-link:hover svg {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		/* No autoplay (the script never adds .is-playing): the active step
		   shows a full rail. Photographs cross-fade instead of wiping, with
		   no zoom; the numeral swaps in place. */
		.process.is-stepper .step.is-active .rail-fill {
			animation: none;
			transform: none;
		}
		.process.is-stepper .desc,
		.process.is-stepper .title {
			transition: none;
		}
		.stage-media {
			clip-path: none;
			opacity: 0;
			transition: opacity 0s linear 200ms;
		}
		.stage-media.is-active {
			clip-path: none;
			opacity: 1;
			transition: opacity 200ms linear;
		}
		.stage-media :global(img),
		.process.is-stepper .stage-media.is-active :global(img) {
			transform: none;
			transition: none;
		}
		.count-num,
		.count-num.is-active {
			transform: none;
			transition: opacity 200ms linear;
		}
	}
</style>
