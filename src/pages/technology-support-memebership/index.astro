---
import PageLayout from '../../layouts/PageLayout.astro';
import FeatureList from '../../components/brands/FeatureList.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import HeroSection from './_HeroSection.astro';
import PlansSection from './_PlansSection.astro';
import HowItWorksSection from './_HowItWorksSection.astro';
import FaqSection from './_FaqSection.astro';

const benefits = [
	{ title: '01 — Priority Support', description: 'Move ahead in the queue when your system.' },
	{ title: '02 — Faster response', description: 'Get dependable help with clearly defined.' },
	{ title: '03 — Remote assist', description: 'Resolve many issues quickly without wait.' },
	{ title: '04 — Ongoing care', description: 'Keep your technology performing reliably after install.' },
];
---

<PageLayout
	title="Technology Support Membership"
	description="Choose a PROJECT: automate membership plan that keeps your home technology running smoothly with responsive remote assistance, priority service, and expert support whenever you need it."
>
	<HeroSection />

	<FeatureList eyebrow="Why Become a Member" title="Support that goes beyond a service call" features={benefits} />

	<PlansSection />

	<HowItWorksSection />

	<FaqSection />

	<CtaBanner />
</PageLayout>
