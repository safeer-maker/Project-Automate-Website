---
import SectionHeading from '../../components/ui/SectionHeading.astro';

const steps = [
	{ number: '1', title: 'Contact us', description: 'Reach our support team by phone or email.' },
	{ number: '2', title: 'Remote assistance', description: 'We diagnose and resolve issues whenever possible.' },
	{ number: '3', title: 'On-Site support', description: 'A technician is scheduled when hands-on help is needed.' },
];
---

<section class="section how-it-works">
	<div class="container">
		<SectionHeading eyebrow="How Support Works" title="Help is always within reach" align="center" />
		<ol class="steps">
			{steps.map((step) => (
				<li>
					<span class="step-number">{step.number}</span>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-8);
	}

	.steps li {
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-4);
	}

	.step-number {
		display: inline-block;
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}

	.steps h3 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-2);
	}

	.steps p {
		margin: 0;
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
