---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const capabilities = [
	{
		title: 'Automated Window Treatments',
		description: 'Enjoy effortless control of natural light throughout your home. Raise, lower or adjust individual shades — or every window at once — from your phone, keypad, touch panel or voice assistant.',
		image: '/images/solutions/motorized-shades-and-drapery/feature-1.webp',
	},
	{
		title: 'Motorized Drapery',
		description: 'Motorized drapery adds softness, elegance and functionality to living rooms, bedrooms, dining spaces and media rooms. Hidden tracks and whisper-quiet motors create smooth, graceful movement while preserving the clean aesthetic of your interiors.',
		image: '/images/solutions/motorized-shades-and-drapery/feature-2.jpeg',
	},
	{
		title: 'Smarter Living',
		description: 'Automatically adjust shades throughout the day to reduce glare, protect furnishings, improve privacy and help maintain comfortable indoor temperatures — no daily adjustments required.',
		image: '/images/solutions/motorized-shades-and-drapery/feature-3.png',
	},
];

const scenes = [
	{ title: 'Morning', description: 'Shades rise gently with the sunrise, letting in soft natural light on your schedule.' },
	{ title: 'Midday', description: 'Automated adjustments reduce glare and UV exposure while protecting furnishings from fading.' },
	{ title: 'Evening', description: 'Drapery and shades close together for privacy, all from one touch or a voice command.' },
	{ title: 'Away', description: 'Scheduled movement keeps your home comfortable and looking lived-in, even when you are not there.' },
];
---

<ServiceLayout
	title="Motorized Shades and Drapery"
	description="Motorized shades and drapery from PROJECT: automate — smart window treatments that balance light, privacy and energy efficiency in one elegant, whisper-quiet solution."
	heroImage="/images/solutions/motorized-shades-and-drapery/hero.webp"
	eyebrow="Smart Window Treatments"
	heroTitle="Smart Window Treatments, Designed For Modern Living"
	heroSubtitle="Motorized shades bring together convenience, comfort, privacy and energy efficiency in one elegant solution. Adjust instantly with a remote, mobile app, voice assistant or automated schedules."
>
	<CapabilityList eyebrow="Beautifully Balanced Light and Privacy" title="One system. Every experience connected." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="Comfort that changes with the day." scenes={scenes} />

	<section class="section power-system">
		<div class="container">
			<SectionHeading eyebrow="A Softer Way To Live" title="Design Your Living Experience" subtitle="Intelligent technology, designed around your lifestyle." align="center" />
		</div>
	</section>

	<CtaBanner />
</ServiceLayout>
