---
// Two auto-scrolling logo strips: brands we've installed (left→right) and
// certifications (right→left). Backgrounds have been stripped from every
// logo on the design side, so they sit directly on the section's cream
// background rather than in cards.
import { withBase } from '../lib/paths.ts';

const vendors = [
	{ name: 'Savant', logo: '/images/vendors/savant.png' },
	{ name: 'Control4', logo: '/images/vendors/control4.png' },
	{ name: 'Lutron', logo: '/images/vendors/lutron.png' },
	{ name: 'Crestron', logo: '/images/vendors/crestron.png' },
	{ name: 'Josh.ai', logo: '/images/vendors/josh-ai.webp' },
	{ name: 'Alarm.com', logo: '/images/vendors/alarm-com.png' },
	{ name: 'Qolsys', logo: '/images/vendors/qolsys.png' },
	{ name: 'Ruckus', logo: '/images/vendors/ruckus.png' },
	{ name: 'Sophos', logo: '/images/vendors/sophos.png' },
	{ name: 'eero', logo: '/images/vendors/eero.webp' },
	{ name: 'Rega', logo: '/images/vendors/rega.webp' },
	{ name: 'Coastal Source', logo: '/images/vendors/coastal-source.png' },
];

const certifications = [
	{ name: 'CEDIA Certified', logo: '/images/badges/cedia-certified.webp' },
	{ name: 'HTA Design Partner', logo: '/images/badges/hta-design-partner.webp' },
	{ name: 'Cert Level Luxury', logo: '/images/badges/cert-level-luxury.webp' },
];

// A marquee half has to be wider than the viewport or the loop shows a gap.
// Three certifications aren't enough, so the set is repeated up to a floor.
const repeatToFill = <T,>(items: T[], minimum: number): T[] =>
	Array.from({ length: Math.ceil(minimum / items.length) }, () => items).flat();

const vendorRow = repeatToFill(vendors, 10);
const certificationRow = repeatToFill(certifications, 10);
---

<section class="marquee-section">
	<div class="marquee-row" data-direction="ltr">
		<div class="marquee-track">
			{[...vendorRow, ...vendorRow].map((item) => (
				<span class="marquee-item">
					<img src={withBase(item.logo)} alt={item.name} decoding="async" />
				</span>
			))}
		</div>
	</div>

	<div class="marquee-row" data-direction="rtl">
		<div class="marquee-track">
			{[...certificationRow, ...certificationRow].map((item) => (
				<span class="marquee-item is-certification">
					<img src={withBase(item.logo)} alt={item.name} decoding="async" />
				</span>
			))}
		</div>
	</div>
</section>

<style>
	.marquee-section {
		background: var(--color-surface-2);
		border-block: 1px solid var(--color-border);
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 5vw, 3.5rem);
	}

	.marquee-row {
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent 0%,
			black 8%,
			black 92%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0%,
			black 8%,
			black 92%,
			transparent 100%
		);
	}

	/* Spacing lives on the items as margin, never as `gap` on the track. A
	   track of 2N items has 2N-1 gaps, so its midpoint falls half a gap short
	   of where the duplicate half actually starts, and the -50% loop jumps by
	   that half gap every cycle. Equal margins make every item advance the
	   same distance, so 50% is exactly one half. */
	.marquee-track {
		display: flex;
		align-items: center;
		width: max-content;
		will-change: transform;
	}

	.marquee-row[data-direction='ltr'] .marquee-track {
		animation: scroll-ltr 36s linear infinite;
	}

	.marquee-row[data-direction='rtl'] .marquee-track {
		animation: scroll-rtl 30s linear infinite;
	}

	/* Logo aspect ratios run from 1.6 to 8.2, so each sits in a fixed box and
	   contains within it — wide wordmarks cap on width, squat marks on height,
	   which keeps them optically the same size rather than mathematically. */
	.marquee-item {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(130px, 14vw, 200px);
		height: clamp(48px, 5vw, 72px);
		margin-inline: clamp(1.5rem, 3vw, 2.75rem);
	}

	.marquee-item.is-certification {
		width: clamp(110px, 11vw, 160px);
		height: clamp(56px, 6vw, 84px);
	}

	.marquee-item img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	@keyframes scroll-ltr {
		from {
			transform: translateX(-50%);
		}
		to {
			transform: translateX(0%);
		}
	}

	@keyframes scroll-rtl {
		from {
			transform: translateX(0%);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}
</style>
