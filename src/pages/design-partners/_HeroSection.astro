---
import { withBase } from '../../lib/paths.ts';
import Picture from '../../components/ui/Picture.astro';
import Button from '../../components/ui/Button.astro';
---

<section class="dp-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<span class="eyebrow">Partner With Purpose</span>
			<h1>The Technology Partner to Los Angeles Architects and Designers</h1>
			<p class="hero-lede">
				We help curate your client’s technology systems for the perfect aesthetic goal:
				coordinated early, concealed in the architecture, and handed over cleanly.
			</p>
			<div class="hero-actions">
				<Button href={withBase('/schedule/')} data-ghl-form-open variant="primary" size="lg">Schedule a Lunch &amp; Learn</Button>
				<a class="hero-link" href="#partners">Who we partner with</a>
			</div>
		</div>
		<figure class="hero-media">
			<Picture
				id="process/design-collaboration"
				alt="Hands over architectural plans beside a scale model of a house"
				sizes="(max-width: 900px) 100vw, 46vw"
				priority
			/>
		</figure>
	</div>
</section>

<style>
	.dp-hero {
		padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 9vw, 7rem);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.hero-copy > * {
		animation: dp-rise 1100ms var(--ease-out-expo) both;
	}
	.hero-copy > :nth-child(2) {
		animation-delay: 90ms;
	}
	.hero-copy > :nth-child(3) {
		animation-delay: 180ms;
	}
	.hero-copy > :nth-child(4) {
		animation-delay: 270ms;
	}

	.hero-copy h1 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.hero-lede {
		max-width: 34rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-8);
	}

	.hero-link {
		padding-bottom: var(--space-1);
		border-bottom: 1px solid currentColor;
		font-weight: var(--fw-medium);
		color: var(--color-accent);
		transition: color var(--dur-fast) ease;
	}

	.hero-link:hover,
	.hero-link:focus-visible {
		color: var(--color-accent-hover);
	}

	.hero-media {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-md);
		aspect-ratio: 4 / 5;
		background: var(--color-surface);
	}

	.hero-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 40% 50%;
		animation: dp-settle 2400ms var(--ease-out-expo) both;
	}

	@keyframes dp-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes dp-settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero-media {
			aspect-ratio: 3 / 2;
		}
	}

	@media (max-width: 600px) {
		.hero-actions :global(.btn) {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-copy > *,
		.hero-media :global(img) {
			animation: none;
		}
	}
</style>
