---
import { withBase } from '../../lib/paths.ts';

const certifications = [
	'Cedia Certified',
	'Automation Programmer Certification',
	'Lutron Motorized Shades Certified',
	'Coastal Source Landscape Audio & Lighting Certified',
	'Sophos Certified',
	'Alarm.com Certified',
	'Home Technology Association Certified',
	'Crestron Certified',
	'Lutron Homeworks Certified',
	'Josh.ai Certified',
	'Eero Certified',
	'Qolsys Certified',
	'Control4 Authorized Gold Dealer',
	'Savant Certified',
	'Ruckus Certified',
	'KNC Certified',
	'Rega Certified',
];

// The HTA Design Partner mark is white-on-transparent, so it sits on a dark chip.
const badges = [
	{ src: withBase('/images/badges/17-years-badge.webp'), alt: '17+ years in business', width: 785, height: 932 },
	{ src: withBase('/images/badges/cedia-certified.webp'), alt: 'CEDIA Smart Home Certified Expert Provider', width: 1182, height: 1182 },
	{ src: withBase('/images/badges/cert-level-luxury.webp'), alt: 'HTA Certified, Luxury level', width: 1853, height: 870 },
	{ src: withBase('/images/badges/hta-design-partner.webp'), alt: 'HTA Design Partner', width: 280, height: 40, dark: true },
];
---

<section class="credentials" aria-labelledby="credentials-heading">
	<div class="container">
		<div class="credentials-grid">
			<div class="credentials-head">
				<span class="eyebrow">Credentials That Set the Standard</span>
				<h2 id="credentials-heading">Certified. Authorized. Trusted.</h2>
				<p>
					PROJECT: automate maintains professional certifications, authorized dealer status, and
					advanced training across the industry's leading smart home, automation, networking,
					security, lighting, shading, and audio platforms. These credentials reflect our
					commitment to expert design, proper installation, and a higher standard of service.
				</p>
			</div>
			<ul class="badges">
				{badges.map((badge) => (
					<li class:list={['badge', { 'badge--dark': badge.dark }]}>
						<img src={badge.src} alt={badge.alt} width={badge.width} height={badge.height} loading="lazy" decoding="async" />
					</li>
				))}
			</ul>
		</div>

		<ul class="cert-list" aria-label="Certifications">
			{certifications.map((cert) => (
				<li>{cert}</li>
			))}
		</ul>
	</div>
</section>

<style>
	.credentials {
		padding-block: clamp(4.5rem, 10vw, 8rem);
	}

	.credentials-grid {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
		margin-bottom: clamp(3rem, 6vw, 4.5rem);
	}

	.credentials-head h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.credentials-head p {
		margin: 0;
		max-width: 38rem;
		line-height: 1.75;
	}

	/* Fixed-height chips, each as wide as its badge needs: the HTA Design
	   Partner mark is a wide strip, the others are near-square. */
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.badge {
		display: flex;
		align-items: center;
		justify-content: center;
		height: clamp(72px, 7vw, 96px);
		padding: var(--space-3) var(--space-4);
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
	}

	.badge--dark {
		padding-inline: var(--space-6);
		background: var(--color-charcoal);
		border-color: var(--color-charcoal);
	}

	.badge img {
		width: auto;
		height: 100%;
		max-width: 160px;
		object-fit: contain;
	}

	.badge--dark img {
		width: clamp(120px, 12vw, 160px);
		height: auto;
	}

	/* A quiet multi-column index rather than a wall of pills. */
	.cert-list {
		columns: 3 16rem;
		column-gap: clamp(1.5rem, 3vw, 3rem);
		border-top: 1px solid var(--color-text);
		padding-top: var(--space-4);
	}

	.cert-list li {
		break-inside: avoid;
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border);
		font-size: var(--text-sm);
		font-weight: var(--fw-medium);
		color: var(--color-text);
	}

	@media (max-width: 900px) {
		.credentials-grid {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}
	}
</style>
