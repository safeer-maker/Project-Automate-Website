---
import { withBase } from '../../lib/paths.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import FeatureList from '../../components/brands/FeatureList.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import HeroSection from './_HeroSection.astro';
import ProgramSection from './_ProgramSection.astro';
import CredentialsSection from './_CredentialsSection.astro';
import ClosingSection from './_ClosingSection.astro';

const partners = [
	{
		title: 'Architects',
		description:
			'From concept through construction, we help translate technology requirements into the architectural plan — not bolt it on after the fact.',
		image: withBase('/images/design-partners/design-partners-architects.webp'),
	},
	{
		title: 'Design Build Firms',
		description:
			'One coordinated technology scope from design development through final walkthrough, so trades stay aligned and timelines stay intact.',
		image: withBase('/images/design-partners/design-partners-design-build-firms.webp'),
	},
	{
		title: 'Interior Designers',
		description: 'Every keypad, panel, and speaker is placed to support the design — never to compete with it.',
		image: withBase('/images/design-partners/design-partners-interior-designers.webp'),
	},
	{
		title: 'General Contractors',
		description:
			'Coordinated rough-in and trim schedules that keep low-voltage work moving in step with the rest of the site.',
		image: withBase('/images/design-partners/design-partners-general-contractors.webp'),
	},
];

const education = [
	{
		title: 'CEU Courses',
		description:
			'Gain access to award-winning CEU courses that allow qualified professionals to become licensed and nationally accredited in residential technology.',
	},
	{
		title: 'Custom Courses',
		description:
			'Take part in our own custom-tailored courses, giving you knowledge of the common problems smart home installers and dealers deal with every day.',
	},
];
---

<PageLayout
	title="Design Partners"
	description="PROJECT: automate's Design Partner Program — CEDIA-certified technology integration for architects, interior designers, general contractors, and design-build firms, backed by 17+ industry certifications."
>
	<HeroSection />

	<CapabilityList eyebrow="Who We Partner With" title="Seamless from concept through completion." items={partners} />

	<ProgramSection />

	<CredentialsSection />

	<FeatureList eyebrow="For Design Professionals" title="Continuing education, built in." features={education} />

	<ClosingSection />

	<CtaBanner />
</PageLayout>
