---
// Selected Residences, the proof chapter. One feature and two companions,
// captioned beneath the photograph rather than over it so the architecture
// leads. Names, places and years are the client's own copy (the same three
// appear on /get-inspired/). Scope lines are left off on purpose until the
// client confirms them. The cards are figures, not links: there are no case
// studies for these three yet, and each card used to open the top of a
// generic page that shows them with less than this. The single "View the
// portfolio" link below is the way on. Make them links again once each has
// a page of its own.
import Picture from '../components/ui/Picture.astro';
import { withBase } from '../lib/paths.ts';
import type { LibraryImageId } from '../lib/images.ts';

type Residence = {
	name: string;
	place: string;
	year: string;
	image: LibraryImageId;
	alt: string;
	/** Crop focus for the tall feature frame; the companions keep centre. */
	focus?: string;
};

const residences: Residence[] = [
	{
		name: 'Oceanfront Villa',
		place: 'Malibu',
		year: '2025',
		image: 'residences/malibu-cliffside',
		alt: 'Infinity pool and terraces lit at sunset above the ocean',
		focus: '58% 50%',
	},
	{
		name: 'Marazul Estate',
		place: 'Hidden Hills',
		year: '2024',
		image: 'residences/hidden-hills-pool',
		alt: 'Glass-walled pavilion and pool softly lit at dusk',
	},
	{
		name: 'Alpine Retreat',
		place: 'Manhattan Beach',
		year: '2023',
		image: 'residences/manhattan-beach',
		alt: 'Lit garden path leading to a coastal house at sunset',
	},
];

// The feature takes ~62% of the row on desktop, the companions ~36%. The
// feature frame, though, is taller than the photo's 1.82:1, so object-fit
// cover renders it ~1.7x the frame's height wide (~1350px at 1440, ~95vw
// below), not the column's width. Sizing by the column picked a rendition
// that got upscaled 1.3–1.7x (the same fix as DayAtHome's shotSizes).
const sizes = {
	feature: '(max-width: 899px) calc(100vw - 2.5rem), (min-width: 1440px) 1350px, 95vw',
	companion: '(max-width: 599px) calc(100vw - 2.5rem), (max-width: 899px) 50vw, (min-width: 1440px) 460px, 34vw',
};
---

<section class="residences" aria-labelledby="residences-title">
	<div class="page">
		<header class="residences-head">
			<div>
				<span class="eyebrow">Selected Residences</span>
				<h2 id="residences-title">Homes we have shaped.</h2>
			</div>
			<p>
				From the Malibu coast to the South Bay, each residence is designed around how its owners
				live, then made to disappear into the architecture.
			</p>
		</header>

		<ul class="residences-grid" data-residences>
			{residences.map((residence, i) => (
				<li
					class:list={['residence', { 'residence--feature': i === 0 }]}
					style={`--i:${i}${residence.focus ? `;--focus:${residence.focus}` : ''}`}
				>
					<figure class="residence-card">
						<div class="residence-media">
							<Picture
								id={residence.image}
								alt={residence.alt}
								sizes={i === 0 ? sizes.feature : sizes.companion}
							/>
						</div>
						<figcaption class="residence-caption">
							<!-- Real spaces around the hidden dot, so it reads
							     "Malibu 2025", not "Malibu2025". -->
							<span class="residence-place">
								{residence.place}{' '}<span class="dot" aria-hidden="true">·</span>{' '}{residence.year}
							</span>
							<h3 class="residence-name">{residence.name}</h3>
						</figcaption>
					</figure>
				</li>
			))}
		</ul>

		<div class="residences-foot">
			<a class="text-link" href={withBase('/success-stories/')}>
				View the portfolio
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.residences {
		background: var(--color-surface);
		padding-block: clamp(4.5rem, 10vw, 8.5rem);
	}

	/* Heading left, the short intro sitting on its baseline to the right —
	   the magazine opener rather than a centred block. */
	.residences-head {
		display: grid;
		grid-template-columns: minmax(0, 1.72fr) minmax(0, 1fr);
		column-gap: clamp(1.25rem, 2.6vw, 2.5rem);
		row-gap: var(--space-6);
		align-items: end;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.residences-head h2 {
		margin: 0;
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		/* No one-word last line ("Homes we have / shaped.") on phones. */
		text-wrap: balance;
	}

	.residences-head p {
		margin: 0;
		max-width: 26rem;
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	/* Feature spans both rows and takes whatever height the two companions
	   set, so the photographs square off top and bottom at every width. */
	.residences-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.72fr) minmax(0, 1fr);
		grid-template-rows: auto auto;
		column-gap: clamp(1.25rem, 2.6vw, 2.5rem);
		row-gap: clamp(2rem, 3.6vw, 3rem);
	}

	.residence--feature {
		grid-row: 1 / span 2;
	}

	.residence-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		margin: 0;
	}

	.residence-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		border-radius: var(--radius-md);
		background: var(--color-cream-deep);
	}

	.residence--feature .residence-media {
		flex: 1;
		min-height: 0;
		aspect-ratio: auto;
	}

	.residence-media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--focus, 50% 50%);
		transition: transform 1600ms var(--ease-out-expo);
	}

	.residence-caption {
		padding-top: clamp(1rem, 1.6vw, 1.35rem);
	}

	.residence-place {
		display: block;
		margin-bottom: var(--space-2);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	/* No margin: the real spaces either side give the same ~0.35em gap the
	   margin used to (measured within 0.2px). */
	.dot {
		color: var(--color-accent);
	}

	/* One size for all three: equal caption heights are what let the feature
	   and the lower companion photograph finish on the same line. */
	.residence-name {
		margin: 0;
		font-size: clamp(1.375rem, 1.9vw, 1.75rem);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: var(--color-text);
	}

	.residences-foot {
		display: grid;
		grid-template-columns: minmax(0, 1.72fr) minmax(0, 1fr);
		column-gap: clamp(1.25rem, 2.6vw, 2.5rem);
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.residences-foot .text-link {
		grid-column: 2;
		justify-self: start;
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		letter-spacing: 0.01em;
		color: var(--color-text);
		transition: color var(--dur-fast) var(--ease-in-out-soft);
	}

	.text-link svg {
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	/* Text bronze: the brand bronze is 4.0:1 on cream-alt at this size. */
	.text-link:hover {
		color: var(--color-bronze-text);
	}

	.text-link:hover svg {
		transform: translateX(4px);
	}

	/* One-time reveal: the frame fades up and the photograph settles from
	   1.06 to rest. Armed by the script, so without it nothing is hidden. */
	.residences-grid[data-armed] .residence-media {
		opacity: 0;
		transition: opacity 1000ms var(--ease-out-expo);
		transition-delay: calc(var(--i) * 140ms);
	}

	.residences-grid[data-armed] .residence-media :global(img) {
		transform: scale(1.06);
		transition-delay: calc(var(--i) * 140ms);
	}

	.residences-grid[data-armed] .residence-caption {
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity 900ms var(--ease-out-expo),
			transform 900ms var(--ease-out-expo);
		transition-delay: calc(var(--i) * 140ms + 200ms);
	}

	.residences-grid[data-armed] .residence.is-visible .residence-media {
		opacity: 1;
	}

	.residences-grid[data-armed] .residence.is-visible .residence-media :global(img) {
		transform: scale(1);
	}

	.residences-grid[data-armed] .residence.is-visible .residence-caption {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 899px) {
		.residences-head,
		.residences-foot {
			grid-template-columns: 1fr;
		}
		.residences-foot .text-link {
			grid-column: 1;
		}
		.residences-grid {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto;
		}
		.residence--feature {
			grid-row: auto;
			grid-column: 1 / -1;
		}
		.residence--feature .residence-media {
			flex: none;
			aspect-ratio: 16 / 10;
		}
		.residence-media :global(img) {
			object-position: 50% 50%;
		}
	}

	@media (max-width: 599px) {
		.residences-grid {
			grid-template-columns: 1fr;
			row-gap: var(--space-12);
		}
		.residence--feature .residence-media {
			aspect-ratio: 4 / 3;
		}
		.residence-media {
			aspect-ratio: 4 / 3;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.residences-grid[data-armed] .residence-media,
		.residences-grid[data-armed] .residence-caption {
			opacity: 1;
			transform: none;
			transition: none;
		}
		.residence-media :global(img),
		.residences-grid[data-armed] .residence-media :global(img) {
			transform: none;
			transition: none;
		}
	}
</style>

<script>
	const grid = document.querySelector<HTMLElement>('[data-residences]');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (grid && !reduce && 'IntersectionObserver' in window) {
		const cards = [...grid.querySelectorAll<HTMLElement>('.residence')];
		grid.setAttribute('data-armed', '');

		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const card = entry.target as HTMLElement;
					card.classList.add('is-visible');
					io.unobserve(card);
				});
			},
			{ threshold: 0.2 }
		);
		cards.forEach((card) => io.observe(card));
	}
</script>
