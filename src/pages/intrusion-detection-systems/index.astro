---
// Intrusion Detection: the sensor layer of the Security & Access family. This
// page stays with what the sensors cover, arming and alerts; the system as a
// whole is explained on /security-systems/.
import { withBase } from '../../lib/paths.ts';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

// The sensors first (what is installed), then what they do for you.
const capabilities = [
	{
		title: 'Precise Sensors',
		description:
			'Motion detectors, glass-break sensors and perimeter controls, placed with care so they cover every approach and stay out of sight.',
		image: withBase('/images/solutions/intrusion-detection-systems/feature-2.webp'),
		imageAlt: 'Slim security keypad beside a glass door in a bright modern home',
	},
	{
		title: 'Instant Alerts',
		description: 'The moment a sensor is triggered, a real-time notification reaches the device you prefer.',
		image: withBase('/images/solutions/intrusion-detection-systems/feature-1.webp'),
		imageAlt: 'Phone showing an intrusion alert with quick actions for cameras and the alarm',
	},
	{
		title: 'Arm and Manage From Anywhere',
		description: 'Arm, disarm, monitor and manage the whole system remotely, from anywhere, at any hour.',
		image: withBase('/images/solutions/intrusion-detection-systems/feature-3.webp'),
		imageAlt: 'Wall-mounted security panel showing camera views and system status',
	},
];

const scenes = [
	{ title: 'Arming', description: 'One touch arms every sensor across the property, confirmed instantly on your device.' },
	{ title: 'Perimeter Breach', description: 'A glass-break sensor detects the unexpected and sends an instant alert to your preferred device.' },
	{ title: 'Away', description: 'Remote management keeps the system in your hands, wherever you are.' },
	{ title: 'Return Home', description: 'Motion sensors register your arrival at the door, and disarming is a single touch away.' },
];
---

<ServiceLayout
	title="Home Intrusion Detection, Los Angeles"
	description="Perimeter and interior intrusion detection for Los Angeles estates: motion, glass-break and perimeter sensors with instant alerts, invisible until needed."
	heroImageId="solutions/security-smart-lock"
	serviceName="Home Intrusion Detection"
	serviceType="Residential intrusion detection system design and installation"
	eyebrow="Intrusion Detection"
	heroTitle="Intrusion Detection, Invisible Until Needed"
	heroSubtitle="An additional layer of protection that detects unauthorized access swiftly and accurately, and stays out of sight the rest of the time."
	intro="Intrusion detection is the sensor layer of estate security: motion, glass-break and perimeter sensors that cover every approach to a Los Angeles residence. The best are the ones you forget are there. They rest through ordinary life, and act the moment something is wrong."
	serviceKey="intrusion-detection-systems"
>
	<CapabilityList eyebrow="What's Included" title="Precise sensors and instant alerts, adapted to any property." items={capabilities} />

	<DailyExperience
		eyebrow="Daily Experience"
		title="Always ready, rarely noticed."
		scenes={scenes}
		imageId="residences/palm-drive-estate"
		imageAlt="A modern residence glowing at the end of a palm-lined drive at dusk"
	/>

	<CtaBanner slot="closing" />
</ServiceLayout>
