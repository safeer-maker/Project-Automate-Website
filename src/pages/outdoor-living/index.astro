---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const capabilities = [
	{
		title: 'Sound That Blends Into the Environment',
		description: 'Enjoy clear, balanced music throughout patios, gardens, pools and entertaining areas without visually distracting equipment. We carefully position landscape speakers and subwoofers to create even coverage across the property.',
		image: '/images/solutions/outdoor-living/feature-1.webp',
	},
	{
		title: 'Entertainment Beyond the Living Room',
		description: 'Bring movies, sports and television into your outdoor spaces with displays designed for exterior environments — weather-resistant televisions, audio, networking and intuitive control in one complete experience.',
		image: '/images/solutions/outdoor-living/feature-2.webp',
	},
	{
		title: 'Set the Mood With a Single Touch',
		description: 'Create the right atmosphere for dining, relaxing, entertaining, or securing the property after dark. Intelligent lighting scenes coordinate architectural, landscape, pathway, pool and accent lighting throughout the outdoor environment.',
		image: '/images/solutions/outdoor-living/feature-3.webp',
	},
];

const scenes = [
	{ title: 'Dining', description: 'Warm accent lighting and gentle background music set the table for an evening outside.' },
	{ title: 'Entertaining', description: 'Landscape lighting, audio and the outdoor display come together with a single touch.' },
	{ title: 'Relaxing', description: 'Pathway and pool lighting soften as the music settles into an easy evening mood.' },
	{ title: 'After Dark', description: 'Landscape and security lighting take over automatically to secure the property overnight.' },
];
---

<ServiceLayout
	title="Outdoor Living"
	description="Integrated outdoor technology from PROJECT: automate — landscape audio, entertainment and lighting control for patios, pools, gardens and terraces across Los Angeles."
	heroImage="/images/solutions/outdoor-living/hero.webp"
	eyebrow="Outdoor Living, Beautifully Connected"
	heroTitle="Outdoor Spaces Designed to Feel as Connected as Your Home"
	heroSubtitle="Extend comfort, entertainment, lighting and control beyond the walls of your home — for patios, pools, gardens, terraces and entertaining spaces."
>
	<CapabilityList eyebrow="Landscape Audio & Video" title="Technology woven into the landscape, never in the way of it." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="An outdoor environment that adapts to every moment." scenes={scenes} />

	<section class="section power-system">
		<div class="container">
			<SectionHeading eyebrow="Outdoor Lighting Control" title="Design Your Living Experience" subtitle="Partner with PROJECT: automate to create an outdoor technology system designed around your home, landscape and lifestyle." align="center" />
		</div>
	</section>

	<CtaBanner />
</ServiceLayout>
