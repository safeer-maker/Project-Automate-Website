---
// Scroll-scrubbed frame sequence: the landscape lighting comes up as you scroll
// into the section. Frames were extracted from
// media-src/videos/Landscapre_lighting_video.mp4 — every 4th frame of a 5s 60fps
// clip, scaled to 1280 and encoded as WebP q72 (75 frames, ~3.7MB).
//
// To regenerate after swapping the clip:
//   ffmpeg -i <clip> -vf "select='not(mod(n\,4))',scale=1280:-2" -vsync 0 \
//     -c:v libwebp -quality 72 -compression_level 6 \
//     public/images/home/technical-silence/frame-%03d.webp
//
// Portrait phones get the lit final frame (n=296, i.e. frame-075) as a native
// 608x1080 centre crop of the 1080p master instead of the 1280x720 frame
// cover-fitted and upscaled ~3.4x:
//   ffmpeg -i <clip> -vf "select='eq(n\,296)',crop=608:1080:656:0" -vsync 0 -frames:v 1 \
//     -c:v libwebp -quality 75 -compression_level 6 .../still-portrait.webp
import { withBase } from '../lib/paths.ts';

const FRAME_COUNT = 75;
const framePath = (n: number) =>
	withBase(`/images/home/technical-silence/frame-${String(n).padStart(3, '0')}.webp`);
const stillPortrait = withBase('/images/home/technical-silence/still-portrait.webp');
---

<section
	class="silence"
	data-silence
	data-frames={FRAME_COUNT}
	data-src={framePath(0)}
	data-still-portrait={stillPortrait}
>
	<div class="silence-stage">
		<div class="silence-media">
			<canvas data-canvas width="1280" height="720" aria-hidden="true"></canvas>
			<div class="silence-scrim"></div>
		</div>

		<div class="page silence-copy">
			<span class="eyebrow">Our Philosophy</span>
			<h2>Technical Silence.</h2>
			<p>
				The finest technology is the kind you never notice. It works quietly in the background and
				leaves only comfort, clarity and calm.
			</p>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-silence]');
	const canvas = section?.querySelector<HTMLCanvasElement>('[data-canvas]');

	if (section && canvas) {
		const total = Number(section.dataset.frames);
		const base = section.dataset.src!.replace(/frame-\d+\.webp$/, '');
		const ctx = canvas.getContext('2d');

		// Deliberately not gated on prefers-reduced-motion. The camera in this
		// clip is static — nothing travels across the screen, only the light
		// level changes — so the scrub is a cross-fade rather than motion, which
		// is the kind of change reduced-motion is meant to permit. Gating it here
		// silently disabled the whole effect for anyone who had turned Windows
		// animation effects off.
		//
		// 75 frames is ~3.7MB, though, so phones and metered connections still
		// get the final lit frame as a still.
		const connection = (navigator as any).connection;
		const lightweight =
			window.matchMedia('(max-width: 700px)').matches || connection?.saveData === true;

		const src = (n: number) => `${base}frame-${String(n).padStart(3, '0')}.webp`;

		// Nothing here is needed at first paint, so nothing is requested at parse
		// time: fetching all 75 frames up front took the bandwidth the hero film
		// needed (it started ~1.8–3.8s later) and pushed back window.load, which
		// the popup form's preload waits for. Each loader runs once, on whichever
		// comes first: its settle condition, or the section drawing near.
		const once = (fn: () => void) => {
			let done = false;
			return () => {
				if (done) return;
				done = true;
				fn();
			};
		};
		const whenLoaded = (fn: () => void) => {
			if (document.readyState === 'complete') fn();
			else window.addEventListener('load', fn, { once: true });
		};
		const whenNear = (fn: () => void, rootMargin: string) => {
			const near = new IntersectionObserver(
				([entry]) => {
					if (!entry.isIntersecting) return;
					near.disconnect();
					fn();
				},
				{ rootMargin }
			);
			near.observe(section);
		};

		// Fraction of the pinned travel spent scrubbing; see render(). With the
		// section at 320vh (220vh pinned), that is ~150vh of scrub and ~70vh of
		// hold on the lit frame.
		const SCRUB_END = 0.68;

		const draw = (image: CanvasImageSource, next?: CanvasImageSource, blend = 0) => {
			if (!ctx) return;
			ctx.globalAlpha = 1;
			ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
			if (next && blend > 0) {
				ctx.globalAlpha = blend;
				ctx.drawImage(next, 0, 0, canvas.width, canvas.height);
				ctx.globalAlpha = 1;
			}
			section.classList.add('is-ready');
		};

		if (lightweight) {
			// Portrait phones get a native portrait crop of the lit frame; small
			// landscape screens and Save-Data desktops keep the 16:9 frame.
			const portrait = window.matchMedia('(max-width: 700px) and (orientation: portrait)').matches;
			const still = new Image();
			still.decoding = 'async';
			still.onload = () => {
				// draw() stretches the image to the canvas bitmap, so the bitmap
				// takes the still's own size (object-fit: cover then crops it).
				canvas.width = still.naturalWidth;
				canvas.height = still.naturalHeight;
				draw(still);
			};
			const load = once(() => {
				still.src = portrait ? section.dataset.stillPortrait! : src(total);
			});
			whenLoaded(load);
			whenNear(load, '50% 0px');
			section.classList.add('is-lit');
		} else {
			const frames: HTMLImageElement[] = [];

			for (let i = 1; i <= total; i++) {
				const img = new Image();
				img.decoding = 'async';
				// Repaint (coalesced to one per frame) whenever any frame lands, not
				// just the first: on a slow connection a visitor can reach the hold
				// before the sequence has loaded, and without this the canvas stayed
				// on a half-lit stand-in frame until they scrolled again. onload is
				// always async, so `queued`/`render` below are initialised by then.
				img.onload = () => {
					if (!queued) {
						queued = true;
						requestAnimationFrame(render);
					}
				};
				frames[i - 1] = img;
			}

			// Coarse to fine, a few at a time: the lit hold frame first, then
			// every 8th, 4th and 2nd frame, then the rest. render() already
			// stands in the nearest loaded frame, so the scrub is usable early.
			const order: number[] = [total];
			for (const step of [8, 4, 2, 1]) {
				for (let n = 1; n < total; n += step) if (!order.includes(n)) order.push(n);
			}
			const MAX_IN_FLIGHT = 4;
			let next = 0;
			let inFlight = 0;
			const pump = () => {
				while (inFlight < MAX_IN_FLIGHT && next < order.length) {
					const n = order[next++];
					const img = frames[n - 1];
					inFlight++;
					const settle = () => {
						inFlight--;
						pump();
					};
					img.addEventListener('load', settle, { once: true });
					img.addEventListener('error', settle, { once: true });
					img.src = src(n);
				}
			};
			const startFrames = once(pump);

			// Start once the hero film is playing AND the page has loaded (new
			// Image() requests hold the load event, so starting before it would
			// delay it again). The timeout covers reduced-motion visitors, whose
			// film never plays, and a film that never gets going.
			const film = document.querySelector<HTMLVideoElement>('[data-hero-video]');
			let filmReady = !film || film.classList.contains('is-playing');
			let pageLoaded = document.readyState === 'complete';
			const maybeStart = () => {
				if (filmReady && pageLoaded) startFrames();
			};
			if (!filmReady && film) {
				const ready = () => {
					filmReady = true;
					maybeStart();
				};
				film.addEventListener('playing', ready, { once: true });
				window.setTimeout(ready, 6000);
			}
			whenLoaded(() => {
				pageLoaded = true;
				maybeStart();
			});
			// A fast scroller shouldn't arrive to an empty sequence.
			whenNear(startFrames, '25% 0px');

			const nearestLoaded = (i: number) => {
				for (let d = 0; d < total; d++) {
					const before = frames[i - d];
					if (before?.complete && before.naturalWidth) return before;
					const after = frames[i + d];
					if (after?.complete && after.naturalWidth) return after;
				}
				return null;
			};

			let queued = false;

			const render = () => {
				queued = false;
				const rect = section.getBoundingClientRect();
				const vh = window.innerHeight;
				// The section is taller than the screen and its inner stage is
				// sticky, so it stays pinned while you scroll through it. Progress
				// runs 0 → 1 across exactly that pinned distance, which guarantees
				// every frame is seen before the page moves on.
				const travel = section.offsetHeight - vh;
				const raw = travel > 0 ? -rect.top / travel : 1;
				// The frames play out over the first SCRUB_END of the pinned
				// distance; the rest holds the fully lit final frame on screen so
				// the scene can land before the page scrolls on. Without the hold
				// the last frame and the release happened on the same pixel.
				const progress = Math.min(1, Math.max(0, raw / SCRUB_END));
				section.classList.toggle('is-lit', progress >= 1);

				const exact = progress * (total - 1);
				const i = Math.floor(exact);
				const blend = exact - i;

				const current = frames[i]?.complete && frames[i].naturalWidth ? frames[i] : nearestLoaded(i);
				if (!current) return;

				// Crossfading adjacent frames matters here: the camera is static
				// and only the light level changes, so blending reads as a
				// continuous ramp rather than 75 discrete steps.
				const upcoming = frames[i + 1];
				const next = upcoming?.complete && upcoming.naturalWidth ? upcoming : undefined;
				draw(current, next, blend);
			};

			const onScroll = () => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(render);
			};

			window.addEventListener('resize', onScroll);

			const io = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						window.addEventListener('scroll', onScroll, { passive: true });
						render();
					} else {
						window.removeEventListener('scroll', onScroll);
					}
				},
				{ rootMargin: '150% 0px' }
			);
			io.observe(section);

			render();
		}
	}
</script>

<style>
	/* Taller than the screen so the sticky stage inside stays pinned while the
	   frame sequence plays out, then holds. 220vh of pinned travel: ~150vh
	   scrubs the 75 frames (~18px of scroll per frame), the last ~70vh holds
	   the lit frame — see SCRUB_END in the script. */
	.silence {
		position: relative;
		height: 320vh;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	.silence-stage {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.silence-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.silence canvas {
		width: 100%;
		height: 100%;
		/* object-fit applies to canvas as a replaced element, so the 1280x720
		   bitmap (or the phone still, which resizes it) fills any viewport
		   without distorting. */
		object-fit: cover;
		opacity: 0;
		transition: opacity var(--dur-slow) var(--ease-in-out-soft);
	}

	.silence.is-ready canvas {
		opacity: 1;
	}

	/* The clip is dark up top but the lit driveway gets bright in the lower
	   half, which is where the paragraph sits. */
	.silence-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(10, 10, 10, 0.4) 0%,
			rgba(10, 10, 10, 0.25) 40%,
			rgba(10, 10, 10, 0.6) 100%
		);
	}

	.silence-copy {
		position: relative;
		z-index: 1;
		width: 100%;
	}

	/* The paragraph lands on the brightest part of the lit facade (the arch
	   and windows), where the scrim is at its lightest. A soft pool of shade
	   that travels with the copy, as behind the hero's, rather than a heavier
	   full-frame scrim that would dull the payoff. Centred on the ~34rem text
	   block and wide enough that its edge never reads as a shape. */
	.silence-copy::before {
		content: '';
		position: absolute;
		z-index: -1;
		top: -6rem;
		bottom: -6rem;
		left: calc(var(--page-gutter) - 8rem);
		width: 50rem;
		pointer-events: none;
		background: radial-gradient(
			closest-side,
			rgba(10, 10, 10, 0.55),
			rgba(10, 10, 10, 0.4) 55%,
			rgba(10, 10, 10, 0)
		);
	}

	/* Was --text-display-xl (160px), which was nearly three times every other
	   heading on the page and read as a different site. Matched to the section
	   headings elsewhere. */
	.silence h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.015em;
		color: var(--color-text-on-dark);
		text-shadow: 0 2px 40px rgba(0, 0, 0, 0.5);
	}

	/* Sits under the heading rather than pushed out to the right margin. Full
	   white: at 0.7 over the lit stucco it fell below 3:1 in places. */
	.silence p {
		margin: 0;
		max-width: 34rem;
		font-size: var(--text-body-lg);
		line-height: 1.6;
		color: var(--color-text-on-dark);
		text-shadow: 0 1px 20px rgba(0, 0, 0, 0.6);
		transition:
			opacity var(--dur-slow) var(--ease-out-expo),
			transform var(--dur-slow) var(--ease-out-expo);
	}

	/* The line lands once the lights are fully up, the payoff for the scrub.
	   Keyed to .is-ready so the copy is never hidden if the script never runs. */
	.silence.is-ready:not(.is-lit) p {
		opacity: 0;
		transform: translateY(0.75rem);
	}

	/* The light scrub stays (it's a cross-fade, see the script), but the copy
	   shouldn't travel: a short fade only. */
	@media (prefers-reduced-motion: reduce) {
		.silence p {
			transition: opacity 200ms linear;
		}
		.silence.is-ready:not(.is-lit) p {
			transform: none;
		}
	}

	@media (max-width: 700px) {
		/* The still is shown instead of the sequence here, so there is nothing
		   to pin and the extra scroll height would just be dead space. */
		.silence {
			height: auto;
		}
		.silence-stage {
			position: static;
			height: auto;
			min-height: 100vh;
			padding-block: clamp(4rem, 9vw, 7.5rem);
		}
		/* The copy spans the phone's width, so the pool centres on the screen. */
		.silence-copy::before {
			left: -4rem;
			right: -4rem;
			width: auto;
		}
	}
</style>
