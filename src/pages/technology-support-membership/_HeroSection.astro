---
// Full-bleed photographic hero, matching the solution pages (ServiceLayout):
// it tucks up behind the sticky header, which stays transparent until the
// 80px sentinel scrolls away.
import { siteInfo } from '../../data/site.ts';
import Picture from '../../components/ui/Picture.astro';
import Button from '../../components/ui/Button.astro';

const studioPhone = siteInfo.phones[0];
---

<section class="membership-hero">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<Picture id="process/deliver" alt="" sizes="100vw" class="hero-bg" priority />
	</div>
	<div class="hero-overlay" aria-hidden="true"></div>
	<div class="container hero-content">
		<span class="eyebrow hero-eyebrow">Technology Support Membership</span>
		<h1>Concierge Care for Your Home Technology</h1>
		<p class="hero-subtitle">
			Your home was designed to feel effortless. Membership keeps it that way, with 24/7 support, guaranteed response
			times and priority service from the PROJECT: automate team.
		</p>
		<div class="hero-actions">
			<Button href="#membership" variant="primary" size="lg">Explore Membership Plans</Button>
			<a class="hero-phone" href={`tel:${studioPhone.replace(/[^\d+]/g, '')}`}>
				<span>or speak with the team</span>
				{studioPhone}
			</a>
		</div>
	</div>
</section>

<style>
	.membership-hero {
		position: relative;
		margin-top: calc(-1 * var(--header-height, 96px));
		min-height: clamp(560px, 88svh, 960px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
	}

	.hero-media :global(.hero-bg) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Keeps the lit entry in frame on narrow screens. */
		object-position: 55% 60%;
		animation: hero-settle 2400ms var(--ease-out-expo) both;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		/* This photo is brighter than the solution heroes (lit palms behind the
		   copy), so a side veil joins the usual top and bottom fall-off. */
		background:
			linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0) 26%),
			linear-gradient(90deg, rgba(10, 10, 10, 0.5) 0%, rgba(10, 10, 10, 0) 62%),
			linear-gradient(0deg, rgba(10, 10, 10, 0.88) 0%, rgba(10, 10, 10, 0.52) 40%, rgba(10, 10, 10, 0) 74%);
	}

	.hero-content {
		position: relative;
		padding-block: calc(var(--header-height, 96px) + var(--space-16)) clamp(3rem, 8vw, 6.5rem);
	}

	.hero-content > * {
		animation: hero-rise 1100ms var(--ease-out-expo) both;
	}
	.hero-content > :nth-child(2) {
		animation-delay: 90ms;
	}
	.hero-content > :nth-child(3) {
		animation-delay: 180ms;
	}
	.hero-content > :nth-child(4) {
		animation-delay: 270ms;
	}

	.hero-eyebrow {
		color: var(--color-gold-light);
		margin-bottom: var(--space-4);
	}

	h1 {
		max-width: 18ch;
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text-on-dark);
		text-wrap: balance;
	}

	.hero-subtitle {
		max-width: 36rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-text-on-dark-muted);
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-8);
	}

	.hero-phone {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		color: var(--color-text-on-dark);
		transition: color var(--dur-fast) ease;
	}

	.hero-phone span {
		font-size: var(--text-xs);
		font-weight: var(--fw-regular);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
	}

	.hero-phone:hover {
		color: var(--color-gold-light);
	}

	@keyframes hero-settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 600px) {
		.membership-hero {
			min-height: clamp(540px, 86svh, 760px);
		}
		/* On a phone the copy climbs over the lit palms, so the fall-off reaches higher. */
		.hero-overlay {
			background:
				linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0) 22%),
				linear-gradient(0deg, rgba(10, 10, 10, 0.9) 0%, rgba(10, 10, 10, 0.64) 52%, rgba(10, 10, 10, 0.12) 82%);
		}
		.hero-content {
			padding-bottom: var(--space-12);
		}
		h1 {
			margin-bottom: var(--space-4);
		}
		.hero-subtitle {
			font-size: var(--text-base);
			margin-bottom: var(--space-6);
		}
		.hero-actions :global(.btn) {
			width: 100%;
		}
		.hero-phone {
			flex-direction: row;
			align-items: baseline;
			gap: var(--space-2);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media :global(.hero-bg),
		.hero-content > * {
			animation: none;
		}
	}
</style>
