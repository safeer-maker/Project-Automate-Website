---
const steps = [
	{ title: 'Reach the team', description: 'Call or email our support team, day or night. Every plan includes 24/7 Basic Support.' },
	{ title: 'Resolved remotely', description: 'We diagnose the issue and resolve it remotely whenever possible.' },
	{ title: 'On-site, when needed', description: 'When hands-on care is required, a technician is scheduled to your home.' },
];
---

<section class="section how-it-works" aria-labelledby="how-heading">
	<div class="container">
		<div class="how-head">
			<span class="eyebrow">How Support Works</span>
			<h2 id="how-heading">Help is always within reach.</h2>
		</div>
		<ol class="steps">
			{steps.map((step, i) => (
				<li>
					<span class="step-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<h3>{step.title}</h3>
					<p>{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.how-it-works {
		padding-block: clamp(4.5rem, 10vw, 8rem);
	}

	.how-head {
		max-width: 40rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.how-head h2 {
		margin: 0;
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-8) clamp(1.5rem, 3vw, 3rem);
	}

	.steps li {
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.step-number {
		display: block;
		margin-bottom: var(--space-6);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		color: var(--color-bronze-text);
		font-variant-numeric: tabular-nums;
	}

	.steps h3 {
		margin-bottom: var(--space-3);
		font-size: var(--text-2xl);
		font-weight: var(--fw-medium);
		line-height: 1.25;
		letter-spacing: -0.005em;
	}

	.steps p {
		margin: 0;
		max-width: 30ch;
		line-height: 1.65;
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}

		.step-number {
			margin-bottom: var(--space-3);
		}

		.steps p {
			max-width: none;
		}
	}
</style>
