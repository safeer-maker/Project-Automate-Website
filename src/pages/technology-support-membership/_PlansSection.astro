---
import { withBase } from '../../lib/paths.ts';
import Button from '../../components/ui/Button.astro';
import { plans } from './_data.ts';
---

<section class="plans" id="membership" aria-labelledby="plans-heading">
	<div class="container">
		<div class="plans-head">
			<span class="eyebrow">Membership Plans</span>
			<h2 id="plans-heading">Choose your level of care.</h2>
			<p>
				From business-hours care to 24/7/365 support with same-day advanced response, there is a membership for every
				home. Choose the one that suits yours, and we will take it from there.
			</p>
		</div>

		<div class="plan-grid">
			{plans.map((plan) => (
				<article class:list={['plan-card', { featured: plan.featured }]} aria-labelledby={`plan-${plan.price}`}>
					<div class="plan-top">
						<h3 id={`plan-${plan.price}`}>{plan.name}</h3>
						<p class="price">
							<span class="amount">${plan.price}</span>
							<span class="cadence">per month</span>
						</p>
					</div>
					<p class="plan-description">{plan.description}</p>
					<ul class="plan-features">
						{plan.features.map((f) => <li>{f}</li>)}
					</ul>
					<Button
						href={withBase('/schedule/')}
						data-ghl-form-open
						variant={plan.featured ? 'primary' : 'outline'}
						size="lg"
						class="plan-cta"
					>
						Request {plan.name}
					</Button>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.plans {
		/* Lands the #membership anchor below the sticky header. */
		scroll-margin-top: var(--header-height, 96px);
		background: var(--color-surface);
		padding-block: clamp(4.5rem, 10vw, 8rem);
	}

	.plans-head {
		max-width: 44rem;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.plans-head h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.plans-head p {
		margin: 0;
		font-size: var(--text-body-lg);
		line-height: 1.7;
		text-wrap: pretty;
	}

	.plan-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: stretch;
	}

	.plan-card {
		display: flex;
		flex-direction: column;
		padding: clamp(1.75rem, 4vw, 3rem);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	/* The fuller plan is set in the dark palette used for the site's closing
	   moments, so the two read as distinct levels without a badge. */
	.plan-card.featured {
		background: var(--color-charcoal);
		border-color: var(--color-charcoal);
		color: var(--color-text-on-dark);
	}

	.plan-top {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2) var(--space-6);
		padding-bottom: var(--space-6);
		margin-bottom: var(--space-6);
		border-bottom: 1px solid var(--color-border);
	}

	.featured .plan-top {
		border-color: var(--color-border-on-dark);
	}

	.plan-card h3 {
		margin: 0;
		font-size: var(--text-tile);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.price {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		margin: 0;
		color: var(--color-text);
	}

	.featured .price {
		color: var(--color-text-on-dark);
	}

	.amount {
		font-size: var(--text-display-sm);
		font-weight: var(--fw-medium);
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.cadence {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.featured .cadence,
	.featured .plan-description,
	.featured .plan-features li {
		color: var(--color-text-on-dark-muted);
	}

	.plan-description {
		margin-bottom: var(--space-8);
		line-height: 1.7;
	}

	.plan-features {
		flex-grow: 1;
		margin-bottom: var(--space-8);
	}

	.plan-features li {
		position: relative;
		padding: var(--space-3) 0 var(--space-3) var(--space-8);
		border-top: 1px solid var(--color-border);
		font-size: var(--text-sm);
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.featured .plan-features li {
		border-color: var(--color-border-on-dark);
	}

	/* A short bronze rule stands in for a bullet. */
	.plan-features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: calc(var(--space-3) + 0.72em);
		width: 14px;
		height: 1px;
		background: var(--color-accent);
	}

	.featured .plan-features li::before {
		background: var(--color-gold-light);
	}

	.plan-card :global(.plan-cta) {
		align-self: flex-start;
	}

	@media (max-width: 900px) {
		.plan-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 600px) {
		.plan-card :global(.plan-cta) {
			align-self: stretch;
			white-space: normal;
		}
	}
</style>
