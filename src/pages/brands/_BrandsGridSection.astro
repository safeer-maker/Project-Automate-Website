---
import { withBase } from '../../lib/paths.ts';
import SectionHeading from '../../components/ui/SectionHeading.astro';

const brands = [
	{ name: 'Savant', logo: withBase('/images/brands/logos/savant.svg'), href: withBase('/brands/savant-2/') },
	{ name: 'Control4', logo: withBase('/images/brands/logos/control4.webp'), href: withBase('/brands/control4/') },
	{ name: 'Lutron', logo: withBase('/images/brands/logos/lutron.webp'), href: withBase('/brands/lutron-2/') },
	{ name: 'Crestron', logo: withBase('/images/brands/logos/crestron.webp'), href: withBase('/brands/crestron/') },
	{ name: 'Basalte', logo: withBase('/images/brands/logos/basalte.webp'), href: withBase('/brands/basalte/') },
	{ name: 'Josh.ai', logo: withBase('/images/brands/logos/josh-ai.svg'), href: withBase('/brands/josh-ai-2/') },
];
---

<section class="section">
	<div class="container">
		<SectionHeading
			eyebrow="Brands"
			title="Best-in-Class Technology Partners"
			subtitle="We design and install systems built on the industry's most trusted smart home platforms."
			align="center"
		/>

		<div class="grid">
			{brands.map((brand) => (
				<a class="brand-card" href={brand.href}>
					<img src={brand.logo} alt={`${brand.name} logo`} loading="lazy" />
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-6);
	}

	.brand-card {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-12) var(--space-8);
		transition: border-color var(--transition-base), transform var(--transition-base);
	}

	.brand-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-4px);
	}

	.brand-card img {
		max-height: 60px;
		width: auto;
	}

	@media (max-width: 700px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
