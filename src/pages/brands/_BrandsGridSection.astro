---
import { withBase } from '../../lib/paths.ts';

// One line per platform, drawn from each brand page — what it is best at,
// not a feature list. Logos are the transparent wordmarks where they exist
// (the /brands/logos Control4 file is a dealer badge, and Basalte has only a
// keypad icon), so Basalte is set as a text wordmark instead.
const brands: { name: string; logo?: string; square?: boolean; href: string; line: string }[] = [
	{
		name: 'Savant',
		logo: withBase('/images/brands/logos/savant.svg'),
		href: withBase('/brands/savant/'),
		line: 'Personal scenes for every member of the household, on one elegant app.',
	},
	{
		name: 'Control4',
		logo: withBase('/images/vendors/control4.png'),
		href: withBase('/brands/control4/'),
		line: 'Lighting, entertainment, shades and security, unified room by room.',
	},
	{
		name: 'Lutron',
		logo: withBase('/images/vendors/lutron.png'),
		href: withBase('/brands/lutron/'),
		line: 'HomeWorks lighting, Ketra tunable light and whisper-quiet shading.',
	},
	{
		name: 'Crestron',
		logo: withBase('/images/brands/logos/crestron.webp'),
		// Square file on a white ground: sized up so the mark itself reads at scale.
		square: true,
		href: withBase('/brands/crestron/'),
		line: 'Enterprise-grade reliability for the most demanding estates.',
	},
	{
		name: 'Basalte',
		href: withBase('/brands/basalte/'),
		line: 'Belgian-crafted keypads and touch surfaces, specified like fine hardware.',
	},
	{
		name: 'Josh.ai',
		logo: withBase('/images/brands/logos/josh-ai.svg'),
		href: withBase('/brands/josh-ai/'),
		line: 'Private, natural voice control that understands the home around it.',
	},
];
---

<section class="brands-intro">
	<div class="container intro-grid">
		<div class="intro-head">
			<span class="eyebrow">Platforms We Integrate</span>
			<h1>The World’s Finest Control Platforms, Expertly Integrated</h1>
		</div>
		<div class="intro-copy">
			<p class="intro-lede">
				We design with Savant, Control4, Lutron, Crestron, Basalte and Josh.ai, and recommend
				the one that suits how you live, not the logo.
			</p>
			<p>
				Whichever platform sits at the heart of your residence, it is specified, programmed
				and cared for by the same team, and made to disappear into the architecture.
			</p>
		</div>
	</div>
</section>

<section class="brands" aria-label="Brand partners">
	<div class="container">
		<ul class="grid" data-brand-grid>
			{brands.map((brand, i) => (
				<li style={`--i: ${i % 3}`}>
					<a class="brand-card" href={brand.href}>
						<span class="logo-panel">
							{brand.logo ? (
								<img class:list={{ 'is-square': brand.square }} src={brand.logo} alt="" loading="lazy" decoding="async" />
							) : (
								<span class="wordmark" aria-hidden="true">{brand.name.toLowerCase()}</span>
							)}
						</span>
						<span class="brand-meta">
							<span class="brand-name">
								{brand.name}
								<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<span class="brand-line">{brand.line}</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<script>
	// Cards rise once as the grid enters, then stay put.
	const grid = document.querySelector<HTMLElement>('[data-brand-grid]');
	if (grid) {
		const items = grid.querySelectorAll<HTMLElement>(':scope > li');
		if (!('IntersectionObserver' in window)) {
			items.forEach((item) => item.classList.add('is-revealed'));
		} else {
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-revealed');
						io.unobserve(entry.target);
					});
				},
				{ rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
			);
			items.forEach((item) => io.observe(item));
		}
	}
</script>

<style>
	.brands-intro {
		padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 6vw, 5rem);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
	}

	.intro-head h1 {
		margin: 0;
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.intro-copy p {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.7;
		max-width: 34rem;
	}

	.intro-copy .intro-lede {
		margin-bottom: var(--space-4);
		font-size: var(--text-body-lg);
		color: var(--color-text);
	}

	.brands {
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.25rem, 2.5vw, 2rem);
	}

	.brand-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-top: 1px solid var(--color-text);
		padding-top: var(--space-6);
	}

	.logo-panel {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 9;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		transition: border-color var(--dur-base) var(--ease-out-expo);
	}

	.logo-panel img {
		max-width: 52%;
		max-height: 34%;
		width: auto;
		height: auto;
		object-fit: contain;
		/* Quiet by default; the brand's own colour returns on hover. */
		filter: grayscale(1);
		opacity: 0.78;
		transition:
			filter var(--dur-base) ease,
			opacity var(--dur-base) ease;
	}

	/* Its ground is off-white; a touch of brightness lifts it to the panel's
	   pure white so no box shows around the mark. */
	.logo-panel img.is-square {
		width: 44%;
		max-width: none;
		max-height: none;
		filter: grayscale(1) brightness(1.08);
	}

	/* Basalte's own mark is a lowercase, widely spaced wordmark. */
	.wordmark {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: var(--fw-medium);
		letter-spacing: 0.32em;
		margin-right: -0.32em;
		color: var(--color-charcoal-2);
		opacity: 0.8;
		transition: opacity var(--dur-base) ease;
	}

	.brand-card:hover .wordmark,
	.brand-card:focus-visible .wordmark {
		opacity: 1;
	}

	.brand-meta {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-top: var(--space-6);
	}

	.brand-name {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		font-size: var(--text-xl);
		font-weight: var(--fw-medium);
		line-height: 1.3;
		color: var(--color-text);
		transition: color var(--dur-fast) ease;
	}

	.arrow {
		flex: none;
		width: 22px;
		height: 22px;
		color: var(--color-accent);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.brand-line {
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--color-text-muted);
		max-width: 30rem;
	}

	.brand-card:hover .logo-panel,
	.brand-card:focus-visible .logo-panel {
		border-color: var(--color-accent);
	}

	.brand-card:hover .logo-panel img,
	.brand-card:focus-visible .logo-panel img {
		filter: none;
		opacity: 1;
	}

	.brand-card:hover .logo-panel img.is-square,
	.brand-card:focus-visible .logo-panel img.is-square {
		filter: brightness(1.08);
	}

	.brand-card:hover .brand-name,
	.brand-card:focus-visible .brand-name {
		/* 20px on cream is small type: the text bronze keeps it above 4.5:1. */
		color: var(--color-bronze-text);
	}

	.brand-card:hover .arrow,
	.brand-card:focus-visible .arrow {
		transform: translateX(6px);
	}

	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		.grid > li {
			opacity: 0;
			transform: translateY(20px);
			transition:
				opacity 900ms var(--ease-out-expo),
				transform 900ms var(--ease-out-expo);
			transition-delay: calc(var(--i, 0) * 110ms);
		}

		.grid > li.is-revealed {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 1000px) {
		.intro-grid {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-8);
		}
		.grid > li {
			transition-delay: 0ms;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-panel,
		.logo-panel img,
		.arrow {
			transition: none;
		}
	}
</style>
