---
import { withBase } from '../../../lib/paths.ts';
import BrandLayout from '../../../layouts/BrandLayout.astro';
import FeatureList from '../../../components/brands/FeatureList.astro';
import DailyExperience from '../../../components/brands/DailyExperience.astro';
import CtaBanner from '../../../components/ui/CtaBanner.astro';
import FeaturedInstallSection from './_FeaturedInstallSection.astro';

const features = [
	{
		title: 'Intelligent Lighting',
		description: 'Create personalized lighting scenes for every activity and occasion, powered by Ketra, HomeWorks, and RadioRA 3.',
	},
	{
		title: 'Automated Shading',
		description: 'Control daylight, privacy, and comfort automatically throughout the day with motorized shading.',
	},
	{
		title: 'Elegant Controls',
		description: 'Beautiful keypads and intuitive controls complement any interior.',
	},
	{
		title: 'Seamless Integration',
		description: 'Works alongside leading smart home platforms for a fully connected experience.',
	},
];

const scenes = [
	{
		title: 'Morning',
		description: 'Wake naturally as lights brighten gradually and shades welcome the morning sun.',
	},
	{
		title: 'Dining',
		description: 'Create a warm, inviting atmosphere with one personalized lighting scene.',
	},
	{
		title: 'Cinema',
		description: 'Lights dim automatically while shades close for the perfect viewing experience.',
	},
	{
		title: 'Evening',
		description: 'Relax with soft lighting and complete privacy, all activated with a single touch.',
	},
];
---

<BrandLayout
	brandName="Lutron"
	seoTitle="Lutron HomeWorks & Ketra Integrator, LA"
	logo={withBase('/images/vendors/lutron.png')}
	heroImage={withBase('/images/brands/lutron-2/hero.webp')}
	heroTitle="Lutron: Beautiful Light, Intelligent Living"
	heroSubtitle="Lutron transforms lighting and automated shading into a seamless experience, enhancing comfort, architecture, and everyday living through elegant control."
	description="Lutron HomeWorks lighting control, Ketra tunable light and motorized shading, designed and programmed for Los Angeles residences by a seasoned Lutron team."
>
	<FeatureList eyebrow="Why Lutron" title="Precision lighting with effortless control." features={features} />

	<DailyExperience eyebrow="Daily Experience" title="Light that changes with every moment." scenes={scenes} />

	<FeaturedInstallSection />

	<CtaBanner />
</BrandLayout>
