---
import { withBase } from '../../../lib/paths.ts';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
---

<section class="section featured-install">
	<div class="container">
		<SectionHeading
			eyebrow="Featured Savant Installation"
			title="Personalized intelligence throughout a luxury residence."
			align="center"
		/>
		<img src={withBase('/images/brands/savant/scene-entertaining.webp')} alt="Savant-powered luxury living space" loading="lazy" />
	</div>
</section>

<style>
	.featured-install img {
		width: 100%;
		border-radius: var(--radius-lg);
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
</style>
