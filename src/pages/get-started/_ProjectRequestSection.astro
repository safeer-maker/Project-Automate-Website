---
import { withBase } from '../../lib/paths.ts';
import { siteInfo } from '../../data/site.ts';
import GhlForm from '../../components/ghl/GhlForm.astro';

const notes = [
	{ title: 'Your residence', text: 'New build, renovation or an existing home, and roughly where it is.' },
	{ title: 'Your design team', text: 'Architect, interior designer and builder, if they are already in place.' },
	{ title: 'Your timeline', text: 'Where the project stands today, and when you hope to move in.' },
];

const [phone] = siteInfo.phones;
---

<section class="request">
	<div class="container request-grid">
		<div class="request-info">
			<span class="eyebrow">Get Started</span>
			<h1>Begin Your Home Technology Project</h1>
			<p class="lede">
				Share a few details and we will review your plans, then follow up personally to arrange a
				private design consultation.
			</p>

			<h2 class="notes-heading">Helpful to include</h2>
			<ul class="notes">
				{notes.map((note) => (
					<li>
						<strong>{note.title}</strong>
						<span>{note.text}</span>
					</li>
				))}
			</ul>

			<p class="aside">
				Prefer to talk it through? Call the studio on{' '}
				<a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a>. Architect or designer?{' '}
				<a href={withBase('/design-partners/')}>Explore the Design Partner program</a>.
			</p>
		</div>

		<div class="request-form">
			<GhlForm primary />
		</div>
	</div>
</section>

<style>
	.request {
		padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4.5rem, 10vw, 8rem);
	}

	.request-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	/* On screens tall enough to show the whole introduction, it stays in view
	   beside the ~1200px form. */
	@media (min-width: 961px) and (min-height: 900px) {
		.request-info {
			position: sticky;
			top: calc(var(--header-height, 96px) + var(--space-8));
		}
	}

	.request-info h1 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.lede {
		max-width: 32rem;
		margin-bottom: var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
	}

	.notes-heading {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.notes {
		margin-bottom: var(--space-8);
	}

	.notes li {
		display: grid;
		gap: var(--space-1);
		padding-block: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.notes li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.notes strong {
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		color: var(--color-text);
	}

	.notes span {
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.aside {
		margin: 0;
		max-width: 32rem;
		font-size: var(--text-sm);
		line-height: 1.7;
	}

	.aside a {
		color: var(--color-accent);
		border-bottom: 1px solid currentColor;
		transition: color var(--dur-fast) ease;
	}

	.aside a:hover,
	.aside a:focus-visible {
		color: var(--color-accent-hover);
	}

	@media (max-width: 960px) {
		.request-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
