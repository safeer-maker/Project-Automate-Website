---
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GhlForm from '../../components/ghl/GhlForm.astro';
---

<section class="section">
	<div class="container form-wrap">
		<SectionHeading eyebrow="Get Started" title="Submit Your Project Request" subtitle="Share a few details and our team will follow up to schedule your private consultation." />

		<GhlForm />
	</div>
</section>

<style>
	.form-wrap {
		max-width: 780px;
		padding-block: var(--space-8) var(--space-24);
	}
</style>
