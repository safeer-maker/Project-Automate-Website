---
// Hub hero: the ultra-wide stone estate at dusk, full bleed behind the
// headline, in the same language as the service heroes it leads to.
import Picture from '../../components/ui/Picture.astro';
import Button from '../../components/ui/Button.astro';
import { withBase } from '../../lib/paths.ts';
import { libraryEntry, type LibraryImageId } from '../../lib/images.ts';
import { siteInfo } from '../../data/site.ts';

const HERO_IMAGE: LibraryImageId = 'residences/stone-estate-wide';

/**
 * The photo is object-fit: cover in a hero whose height is a clamp() on the
 * viewport height, and at 2.67:1 it renders wider than the screen almost
 * everywhere, so sizes="100vw" would pick a rendition far too small. These
 * bands mirror the .hub-hero min-height rules below (keep them in step), after
 * ServiceLayout's coverSizes(): for each band, `sizes` gives the rendered
 * width (hero height x photo aspect) wherever that exceeds the viewport.
 */
const HERO_BANDS = [
	{ media: '(max-width: 600px)', maxViewportWidth: 600, minPx: 520, vh: 80, maxPx: 700 },
	{ media: '', maxViewportWidth: Infinity, minPx: 560, vh: 84, maxPx: 900 },
];

function coverSizes(aspect: number): string {
	const out: string[] = [];
	for (const { media, maxViewportWidth, minPx, vh, maxPx } of HERO_BANDS) {
		const when = (query: string) => (media ? `${media} and ${query}` : query);
		const pinned: [string, number][] = [
			[`(max-height: ${Math.floor((minPx * 100) / vh)}px)`, minPx],
			[`(min-height: ${Math.ceil((maxPx * 100) / vh)}px)`, maxPx],
		];
		for (const [heightQuery, heightPx] of pinned) {
			const coverWidth = Math.ceil(heightPx * aspect);
			if (coverWidth >= maxViewportWidth) out.push(`${when(heightQuery)} ${coverWidth}px`);
			else out.push(`${when(heightQuery)} and (max-width: ${coverWidth}px) ${coverWidth}px`, `${when(heightQuery)} 100vw`);
		}
		out.push(`${when(`(max-aspect-ratio: ${Math.round(vh * aspect * 10)}/1000)`)} ${(vh * aspect).toFixed(1)}vh`);
		if (media) out.push(`${media} 100vw`);
	}
	out.push('100vw');
	return out.join(', ');
}

const { width, height } = libraryEntry(HERO_IMAGE);
const heroSizes = coverSizes(width / height);

const studioPhone = siteInfo.phones[0];
---

<section class="hub-hero">
	<div class="scroll-sentinel" data-hero-sentinel aria-hidden="true"></div>
	<div class="hero-media">
		<Picture
			id={HERO_IMAGE}
			alt="A limestone residence at dusk, its facade and gardens softly uplit"
			sizes={heroSizes}
			class="hero-bg"
			priority
		/>
	</div>
	<div class="hero-overlay" aria-hidden="true"></div>
	<div class="container hero-content">
		{/* Each half holds together, so a narrow screen breaks the line at the dot. */}
		<span class="eyebrow hero-eyebrow"><span>Luxury Home Technology</span> · <span>Los Angeles</span></span>
		<h1>One home, every system, designed as one.</h1>
		<p class="hero-subtitle">
			Lighting and shading, climate, private cinema, audio, outdoor living and security, planned together by one
			team, and cared for by the same team after handover.
		</p>
		<div class="hero-actions">
			<Button href={withBase('/schedule/')} data-ghl-form-open variant="primary" size="lg">Book a Private Consultation</Button>
			<a class="hero-phone" href={`tel:${studioPhone.replace(/[^\d+]/g, '')}`}>
				<span>or call the studio</span>
				{studioPhone}
			</a>
		</div>
	</div>
</section>

<style>
	.hub-hero {
		position: relative;
		/* Tucks up behind the sticky header, which turns transparent over it. */
		margin-top: calc(-1 * var(--header-height, 96px));
		/* Mirrored in HERO_BANDS (frontmatter) for `sizes`. */
		min-height: clamp(560px, 84svh, 900px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-black);
		color: var(--color-text-on-dark);
	}

	.scroll-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 80px;
		pointer-events: none;
	}

	.hero-media {
		position: absolute;
		inset: 0;
	}

	.hero-media :global(.hero-bg) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* The entry sits just left of centre; keep it in frame on narrow screens. */
		object-position: 46% 50%;
		animation: hero-settle 2400ms var(--ease-out-expo) both;
	}

	/* Same veil as the service heroes: light at the top for the header, deeper
	   at the bottom and from the left where the headline sits. */
	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0) 26%),
			linear-gradient(90deg, rgba(10, 10, 10, 0.6) 0%, rgba(10, 10, 10, 0.22) 50%, rgba(10, 10, 10, 0) 74%),
			linear-gradient(0deg, rgba(10, 10, 10, 0.88) 0%, rgba(10, 10, 10, 0.5) 40%, rgba(10, 10, 10, 0) 74%);
	}

	.hero-content {
		position: relative;
		padding-block: calc(var(--header-height, 96px) + var(--space-16)) clamp(3rem, 8vw, 6.5rem);
	}

	.hero-content > * {
		animation: hero-rise 1100ms var(--ease-out-expo) both;
	}
	.hero-content > :nth-child(2) {
		animation-delay: 90ms;
	}
	.hero-content > :nth-child(3) {
		animation-delay: 180ms;
	}
	.hero-content > :nth-child(4) {
		animation-delay: 270ms;
	}

	/* Lifted from the brand gold so the small caps clear 4.5:1 over the photo. */
	.hero-eyebrow {
		color: color-mix(in srgb, var(--color-gold-light) 68%, var(--color-white));
		margin-bottom: var(--space-4);
	}

	.hero-eyebrow span {
		white-space: nowrap;
	}

	.hero-content h1 {
		max-width: 16ch;
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text-on-dark);
		text-wrap: balance;
	}

	.hero-subtitle {
		max-width: 36rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-text-on-dark-muted);
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-8);
	}

	.hero-phone {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		color: var(--color-text-on-dark);
		transition: color var(--dur-fast) ease;
	}

	.hero-phone span {
		font-size: var(--text-xs);
		font-weight: var(--fw-regular);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
	}

	.hero-phone:hover {
		color: var(--color-gold-light);
	}

	@keyframes hero-settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 600px) {
		.hub-hero {
			min-height: clamp(520px, 80svh, 700px);
		}
		.hero-content {
			padding-bottom: var(--space-12);
		}
		.hero-content h1 {
			margin-bottom: var(--space-4);
		}
		.hero-subtitle {
			font-size: var(--text-base);
			margin-bottom: var(--space-6);
		}
		.hero-actions :global(.btn) {
			width: 100%;
		}
		.hero-phone {
			flex-direction: row;
			align-items: baseline;
			gap: var(--space-2);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media :global(.hero-bg),
		.hero-content > * {
			animation: none;
		}
	}
</style>
