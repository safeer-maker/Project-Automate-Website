---
// The five pillars of services as editorial blocks: photograph, one line, and
// every member service as a link. Services shared with another pillar follow
// the home members, marked with where they come from. The sixth pillar,
// Concierge Care, is the dark band further down (_CareSection, id="care").
import Picture from '../../components/ui/Picture.astro';
import { withBase } from '../../lib/paths.ts';
import { pillarOf, pillars, servicesIn, type PillarKey } from '../../data/services.ts';

// Alt text for each pillar photograph, as it appears here.
const PILLAR_ALT: Record<PillarKey, string> = {
	control: 'A bright great room with tall garden windows and a slim control panel on the wall',
	'light-shade': 'A living room glowing with warm cove lighting, sheer curtains drawn',
	entertainment: 'A tiered private cinema with rows of recliners and warm step lights',
	outdoor: 'A stone residence above an infinity pool and ocean terrace at dusk',
	security: 'Lit iron gates opening onto a palm-lined drive to an estate at night',
	care: 'A finished residence glowing at dusk at the end of a palm-lined drive',
};

const blocks = pillars
	.map((pillar, index) => ({
		pillar,
		number: String(index + 1).padStart(2, '0'),
		members: servicesIn(pillar.key).map((service) => ({
			service,
			// Shared members name their home pillar.
			from: service.pillar === pillar.key ? undefined : pillarOf(service.key).title,
		})),
	}))
	.filter(({ pillar }) => pillar.key !== 'care');

// The photo fills half the container (1280px less padding), full width below 900px.
const mediaSizes = '(max-width: 900px) calc(100vw - 3rem), (min-width: 1280px) 600px, 47vw';
---

<section class="pillars" aria-labelledby="pillars-title">
	<div class="container">
		<header class="pillars-head">
			<div>
				<span class="eyebrow">Six Pillars</span>
				<h2 id="pillars-title">Every service, and where it belongs.</h2>
			</div>
			<p>
				Each service has a home, but none stands alone. Where one also serves another pillar, it is marked: landscape
				lighting, for instance, is as much about security as it is about the garden.
			</p>
		</header>

		<div class="pillar-list">
			{blocks.map(({ pillar, number, members }, i) => (
				<article
					class:list={['pillar', { 'is-flipped': i % 2 === 1 }]}
					id={pillar.key}
					aria-labelledby={`pillar-${pillar.key}-title`}
					data-pillar
				>
					<div class="pillar-media">
						<Picture id={pillar.image} alt={PILLAR_ALT[pillar.key]} sizes={mediaSizes} />
					</div>
					<div class="pillar-body">
						<span class="pillar-num" aria-hidden="true">{number}</span>
						<h3 id={`pillar-${pillar.key}-title`}>{pillar.title}</h3>
						<p class="pillar-line">{pillar.line}</p>
						<ul class="pillar-services">
							{members.map(({ service, from }) => (
								<li class:list={{ 'is-shared': Boolean(from) }}>
									<a class="svc" href={withBase(service.href)}>
										{from && <span class="svc-from">Also · from {from}</span>}
										<span class="svc-name">{service.title}</span>
										<span class="svc-line">{service.line}</span>
										<svg class="svc-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
											<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</a>
								</li>
							))}
						</ul>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	// Each pillar settles in once as it arrives: the photo eases from a slight
	// scale, the text rises. Without the observer, everything simply shows.
	const blocks = document.querySelectorAll<HTMLElement>('[data-pillar]');
	if (!('IntersectionObserver' in window)) {
		blocks.forEach((block) => block.classList.add('is-revealed'));
	} else {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-revealed');
					io.unobserve(entry.target);
				});
			},
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
		);
		blocks.forEach((block) => io.observe(block));
	}
</script>

<style>
	/* The intro above already leaves generous room, so less at the top. */
	.pillars {
		padding-block: clamp(2rem, 4vw, 3.5rem) clamp(4.5rem, 10vw, 8rem);
	}

	.pillars-head {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: var(--space-6) clamp(2.5rem, 6vw, 6rem);
		align-items: end;
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}

	.pillars-head h2 {
		max-width: 18ch;
		margin: 0;
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.pillars-head p {
		max-width: 30rem;
		margin: 0;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.pillar-list {
		display: grid;
		gap: clamp(4rem, 9vw, 7.5rem);
	}

	/* Photo and text side by side, alternating sides down the page. */
	.pillar {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: stretch;
		/* In-page links land below the sticky header. */
		scroll-margin-top: calc(var(--header-height, 96px) + var(--space-8));
	}

	.pillar.is-flipped .pillar-media {
		order: 2;
	}

	.pillar-media {
		overflow: hidden;
		border-radius: var(--radius-md);
		background: rgba(22, 16, 8, 0.05);
	}

	/* The photo fills its half, however long the list beside it runs. */
	.pillar-media :global(img) {
		width: 100%;
		height: 100%;
		min-height: 26rem;
		object-fit: cover;
	}

	.pillar-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: var(--space-4);
	}

	.pillar-num {
		display: block;
		margin-bottom: var(--space-4);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.14em;
		color: var(--color-bronze-text);
		font-variant-numeric: tabular-nums;
	}

	.pillar-body h3 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-display-sm);
		font-weight: var(--fw-medium);
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.pillar-line {
		max-width: 30rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.pillar-services {
		border-bottom: 1px solid var(--color-border);
	}

	.pillar-services li {
		border-top: 1px solid var(--color-border);
	}

	/* Name and line on the left, the arrow held top-right. */
	.svc {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: var(--space-6);
		padding-block: var(--space-4) calc(var(--space-4) + 2px);
	}

	.svc-from {
		grid-column: 1;
		margin-bottom: var(--space-1);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-bronze-text);
	}

	.svc-name {
		grid-column: 1;
		font-size: var(--text-xl);
		font-weight: var(--fw-medium);
		line-height: 1.3;
		color: var(--color-text);
		transition: color var(--dur-fast) ease;
	}

	.svc-line {
		grid-column: 1;
		margin-top: 2px;
		font-size: var(--text-sm);
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.svc-arrow {
		grid-column: 2;
		grid-row: 1 / span 3;
		align-self: center;
		width: 20px;
		height: 20px;
		color: var(--color-bronze);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.svc:hover .svc-name,
	.svc:focus-visible .svc-name {
		color: var(--color-bronze-text);
	}

	.svc:hover .svc-arrow,
	.svc:focus-visible .svc-arrow {
		transform: translateX(5px);
	}

	.svc:focus-visible {
		outline: 2px solid var(--color-bronze);
		outline-offset: 4px;
		border-radius: 2px;
	}

	/* Shared members read a shade quieter than the pillar's own. */
	.is-shared .svc-name {
		font-size: var(--text-lg);
	}

	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		.pillar-media :global(img) {
			transform: scale(1.06);
			transition: transform 1600ms var(--ease-out-expo);
		}

		.pillar-body > * {
			opacity: 0;
			transform: translateY(18px);
			transition:
				opacity 1000ms var(--ease-out-expo),
				transform 1000ms var(--ease-out-expo);
		}

		.pillar-body > :nth-child(2) {
			transition-delay: 80ms;
		}
		.pillar-body > :nth-child(3) {
			transition-delay: 160ms;
		}
		.pillar-body > :nth-child(4) {
			transition-delay: 240ms;
		}

		.pillar.is-revealed .pillar-media :global(img),
		.pillar.is-revealed .pillar-body > * {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 900px) {
		.pillars-head {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}

		.pillar {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-8);
		}

		.pillar.is-flipped .pillar-media {
			order: 0;
		}

		.pillar-media :global(img) {
			height: auto;
			min-height: 0;
			aspect-ratio: 3 / 2;
		}

		.pillar-body {
			padding-block: 0;
		}
	}

	@media (max-width: 480px) {
		.svc-name {
			font-size: var(--text-lg);
		}
		.is-shared .svc-name {
			font-size: var(--text-base);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.svc-arrow {
			transition: none;
		}
	}
</style>
