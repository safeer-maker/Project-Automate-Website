---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const capabilities = [
	{
		title: 'Alarm System',
		description: 'Smart alarms that detect, alert and act instantly. Receive real-time notifications and monitor your home from anywhere.',
		image: '/images/solutions/security-systems/feature-1.webp',
	},
	{
		title: 'Smart Entry Systems',
		description: 'See, speak and grant access from anywhere. Modern entry solutions that combine convenience with advanced security.',
		image: '/images/solutions/security-systems/feature-2.webp',
	},
	{
		title: 'Access Control Systems',
		description: 'Designed for peace of mind, our access control systems give you full command over who comes and goes, from any part of the property.',
		image: '/images/solutions/security-systems/feature-3.webp',
	},
];

const scenes = [
	{ title: 'Arrival', description: 'The system recognizes your approach, disarms the alarm and unlocks the entry automatically.' },
	{ title: 'Visitors', description: 'See and speak with anyone at the gate or front door before granting them access.' },
	{ title: 'Away', description: 'Arm the property with one tap and receive real-time alerts wherever you are.' },
	{ title: 'Overnight', description: 'Cameras, sensors and access points stay watched quietly while the home rests.' },
];
---

<ServiceLayout
	title="Security Systems"
	description="Custom smart home security systems from PROJECT: automate — intelligent alarms, entry systems and access control for refined Los Angeles residences."
	heroImage="/images/solutions/security-systems/hero.webp"
	eyebrow="A Smarter Way to Stay Safe"
	heroTitle="Complete Protection for Every Part of Your Property"
	heroSubtitle="We create intelligent environments where every detail works in harmony — quietly, beautifully, completely."
>
	<CapabilityList eyebrow="Modern Security" title="Smart alarms, entry and access control working together in harmony." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="Protection that moves quietly through your day." scenes={scenes} />

	<section class="section power-system">
		<div class="container">
			<SectionHeading eyebrow="Our Philosophy" title="Design Your Living Experience" subtitle="Intelligent technology, designed around your lifestyle." align="center" />
		</div>
	</section>

	<CtaBanner />
</ServiceLayout>
