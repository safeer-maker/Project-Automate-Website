---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import type { LibraryImageId } from '../../lib/images.ts';

type Capability = { title: string; description: string; imageId: LibraryImageId; imageAlt: string };

const capabilities: Capability[] = [
	{
		title: 'Intelligent Alarms',
		description:
			'Alarms that detect, alert and respond the moment something changes. Real-time notifications reach you wherever you are, and the whole property can be checked from a single screen.',
		imageId: 'solutions/security-camera',
		imageAlt: 'Security camera mounted discreetly on a modern residence at dusk',
	},
	{
		title: 'Smart Entry',
		description:
			'See, speak with and admit visitors from anywhere. Entry that is effortless for the family and exacting about everyone else.',
		imageId: 'solutions/security-smart-lock',
		imageAlt: 'Smart lock set into a timber front door, with a sunset terrace beyond',
	},
	{
		title: 'Access Control',
		description:
			'Full command over who comes and goes, at every gate and door, from any part of the property.',
		imageId: 'solutions/security-estate-gate',
		imageAlt: 'Estate gates lit at night, opening onto a palm-lined drive',
	},
];

const scenes = [
	{ title: 'Arrival', description: 'The system recognizes your approach, disarms the alarm and unlocks the entry.' },
	{ title: 'Visitors', description: 'See and speak with anyone at the gate or front door before they are let in.' },
	{ title: 'Away', description: 'One touch arms the property, and real-time alerts follow you wherever you are.' },
	{ title: 'Overnight', description: 'Cameras, sensors and access points keep watch while the home rests.' },
];
---

<ServiceLayout
	title="Estate Security Systems, Los Angeles"
	description="Discreet, integrated estate security for Los Angeles residences: alarms, cameras, gates and access control that protect quietly and answer to one interface."
	heroImageId="solutions/security-driveway-gate"
	serviceName="Estate Security Systems"
	serviceType="Residential security system design and integration"
	eyebrow="Estate Security"
	heroTitle="Complete Protection for Every Part of Your Property"
	heroSubtitle="Alarms, cameras, gates and access control, designed as one quiet system. Always present, and never in the way."
	intro="The finest protection is felt rather than seen. We design alarms, cameras, gates and access control as a single system, placed in step with the architecture and answering to the same interface as the rest of the home."
	related={['surveillance-systems', 'access-control-and-intercom', 'intrusion-detection-systems']}
	relatedEyebrow="The Security Suite"
	relatedTitle="Every layer, designed together."
>
	<CapabilityList eyebrow="Modern Security" title="Alarms, entry and access, working as one." items={capabilities} />

	<DailyExperience
		eyebrow="Daily Experience"
		title="Protection that moves quietly through your day."
		scenes={scenes}
		imageId="solutions/access-lit-gate"
		imageAlt="Contemporary gate traced with a line of light beside an intercom post at dusk"
	/>

	<CtaBanner slot="closing" />
</ServiceLayout>
