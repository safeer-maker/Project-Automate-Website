---
const features = [
	'Centralized whole-home automation and control',
	'Intelligent architectural lighting',
	'Automated shades and privacy control',
	'Multi-room audio and video distribution',
	'Dedicated media and entertainment spaces',
	'Enterprise-grade networking and Wi-Fi',
	'Integrated surveillance and access control',
	'Energy monitoring and intelligent power management',
];
---

<section class="features" aria-labelledby="cs-features-heading">
	<div class="container features-grid">
		<div class="features-head">
			<span class="eyebrow">Main System Features</span>
			<h2 id="cs-features-heading">Design Your Living Experience</h2>
			<p>
				From lighting and shading to entertainment, climate, security, and networking, every
				system works together discreetly, allowing the technology to disappear while the
				experience remains.
			</p>
		</div>
		<ol class="feature-list">
			{features.map((feature, i) => (
				<li>
					<span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					{feature}
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.features {
		padding-block: clamp(4.5rem, 10vw, 8rem);
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
	}

	.features-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.features-head h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.features-head p {
		margin: 0;
		max-width: 30rem;
		line-height: 1.75;
	}

	.feature-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: clamp(1.5rem, 3vw, 3rem);
	}

	.feature-list li {
		display: flex;
		gap: var(--space-4);
		padding-block: var(--space-4);
		border-top: 1px solid var(--color-border);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		line-height: 1.5;
		color: var(--color-text);
	}

	.feature-list span {
		flex: none;
		width: 1.75rem;
		padding-top: 0.2em;
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.1em;
		/* Small type on cream-alt: the text bronze clears 4.5:1, the brand bronze doesn't. */
		color: var(--color-bronze-text);
	}

	@media (max-width: 900px) {
		.features-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 600px) {
		.feature-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
