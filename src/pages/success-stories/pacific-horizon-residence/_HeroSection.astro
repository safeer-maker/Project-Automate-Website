---
import { withBase } from '../../../lib/paths.ts';

const facts = [
	{ label: 'Location', value: 'Pacific Coast, California' },
	{ label: 'Scope', value: 'Lighting, Shading, Audio/Video, Networking, Security' },
	{ label: 'Status', value: 'Completed' },
];
---

<section class="cs-hero">
	<div class="container">
		<div class="hero-grid">
			<div class="hero-head">
				<a class="back-link" href={withBase('/success-stories/')}>Success Stories</a>
				<h1>Pacific Horizon Residence</h1>
				<p class="hero-subtitle">Coastal Living, Intelligently Connected</p>
			</div>
			<dl class="hero-facts">
				{facts.map((fact) => (
					<div>
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))}
			</dl>
		</div>
		<figure class="hero-image">
			<img
				src={withBase('/images/project-single/hero-pacific-horizon.webp')}
				alt="Pacific Horizon Residence, a contemporary coastal home with an infinity pool at blue hour"
				width="1586"
				height="992"
				fetchpriority="high"
				decoding="sync"
			/>
		</figure>
	</div>
</section>

<style>
	.cs-hero {
		padding-top: clamp(3.5rem, 9vw, 7rem);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: var(--space-8) clamp(2rem, 6vw, 6rem);
		align-items: end;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.hero-head > *,
	.hero-facts {
		animation: cs-rise 1100ms var(--ease-out-expo) both;
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-4);
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		transition: color var(--dur-fast) ease;
	}

	.back-link::before {
		content: '←';
		margin-right: var(--space-2);
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: var(--color-accent-hover);
	}

	.hero-head h1 {
		margin: 0 0 var(--space-4);
		font-size: var(--text-display-lg);
		font-weight: var(--fw-medium);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
		animation-delay: 90ms;
	}

	.hero-subtitle {
		margin: 0;
		font-size: var(--text-xl);
		color: var(--color-text-muted);
		animation-delay: 180ms;
	}

	.hero-facts {
		margin: 0;
		animation-delay: 240ms;
	}

	.hero-facts div {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.hero-facts div:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.hero-facts dt {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		padding-top: 0.2em;
	}

	.hero-facts dd {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-text);
	}

	.hero-image {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-md);
		aspect-ratio: 16 / 9;
		background: var(--color-charcoal);
	}

	.hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		animation: cs-settle 2400ms var(--ease-out-expo) both;
	}

	@keyframes cs-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes cs-settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}
		.hero-image {
			aspect-ratio: 4 / 3;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-head > *,
		.hero-facts,
		.hero-image img {
			animation: none;
		}
	}
</style>
