---
import { withBase } from '../../lib/paths.ts';
---

<section class="closing" aria-labelledby="ss-closing-heading">
	<div class="container closing-inner">
		<span class="eyebrow">Start Your Project</span>
		<h2 id="ss-closing-heading">Bring Intelligent Living Into Your Home</h2>
		<p>
			Planning a new residence or major renovation? PROJECT: automate can collaborate with your
			architect, designer, and builder to integrate technology from the beginning.
		</p>
		<a class="partner-link" href={withBase('/design-partners/')}>
			For architects, designers and builders
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</div>
</section>

<style>
	.closing {
		padding-block: clamp(4.5rem, 10vw, 8rem);
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
	}

	.closing-inner {
		max-width: 46rem;
		text-align: center;
	}

	.closing h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.closing p {
		margin: 0 auto var(--space-8);
		max-width: 36rem;
		font-size: var(--text-body-lg);
		line-height: 1.7;
	}

	.partner-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding-bottom: var(--space-1);
		border-bottom: 1px solid currentColor;
		font-weight: var(--fw-medium);
		color: var(--color-accent);
		transition: color var(--dur-fast) ease;
	}

	.partner-link svg {
		width: 18px;
		height: 18px;
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.partner-link:hover,
	.partner-link:focus-visible {
		color: var(--color-accent-hover);
	}

	.partner-link:hover svg,
	.partner-link:focus-visible svg {
		transform: translateX(5px);
	}

	@media (prefers-reduced-motion: reduce) {
		.partner-link svg {
			transition: none;
		}
	}
</style>
