---
import { withBase } from '../../lib/paths.ts';
import Picture from '../../components/ui/Picture.astro';
import type { LibraryImageId } from '../../lib/images.ts';

type Project = {
	name: string;
	description: string;
	status: string;
	alt: string;
	/** Library photo, where one suits the project. */
	imageId?: LibraryImageId;
	/** Otherwise the project's own image. */
	image?: { src: string; width: number; height: number };
	href?: string;
};

// Pacific Horizon keeps its own photograph so the card matches the case study
// it opens; the others take the library photo closest to their name, avoiding
// the photos already captioned as other named residences (homepage + Get
// Inspired), so no photograph ever stands for two different projects. The
// identical "July 15, 2026" date on every card read as a template placeholder,
// so it is no longer shown.
const [feature, ...projects]: Project[] = [
	{
		name: 'Pacific Horizon Residence',
		description: 'A coastal home where lighting, shading, entertainment, security, and climate operate through one effortless system.',
		image: { src: withBase('/images/success-stories/pacific-horizon-residence.webp'), width: 1024, height: 640 },
		alt: 'Contemporary coastal residence with an infinity pool at blue hour',
		status: 'Completed',
		href: withBase('/success-stories/pacific-horizon-residence/'),
	},
	{
		name: 'Canyon Glass House',
		description: 'Intelligent lighting and automated shading enhance the architecture while preserving expansive views and privacy.',
		imageId: 'residences/malibu-stone-court',
		alt: 'Modern glass residence beside a softly lit stone wall at blue hour',
		status: 'Completed',
	},
	{
		name: 'Manhattan Beach Modern',
		description: 'Discreet audio, intuitive control, and reliable networking create a connected experience throughout the residence.',
		image: { src: withBase('/images/success-stories/manhattan-beach-modern.webp'), width: 1024, height: 640 },
		alt: 'Open living room with a fireplace and a sunset view over the coast',
		status: 'Completed',
	},
	{
		name: 'Bel Air Cinema Suite',
		description: 'A private cinema designed with immersive sound, precise lighting, and uncompromising picture quality.',
		imageId: 'solutions/cinema-starlight',
		alt: 'Private cinema beneath a starlit ceiling',
		status: 'Completed',
	},
	{
		name: 'Malibu Cliffside Retreat',
		description: 'Integrated surveillance, access control, and whole-home connectivity provide quiet protection without disrupting the design.',
		imageId: 'residences/malibu-coastal',
		alt: 'Ocean-view pool deck framed by tropical planting at dusk',
		status: 'Completed',
	},
	{
		name: 'Sunset Courtyard Estate',
		description: 'Architectural lighting and intelligent energy management bring comfort, atmosphere, and efficiency into perfect balance.',
		imageId: 'residences/stone-estate-wide',
		alt: 'Limestone estate with architectural uplighting at dusk',
		status: 'Completed',
	},
];
---

<section class="projects" aria-label="Portfolio">
	<div class="container">
		<a class="feature" href={feature.href} data-project>
			<figure class="feature-media">
				<img
					src={feature.image!.src}
					alt={feature.alt}
					width={feature.image!.width}
					height={feature.image!.height}
					fetchpriority="high"
					decoding="async"
				/>
			</figure>
			<div class="feature-copy">
				<span class="meta">Case Study · {feature.status}</span>
				<h2>{feature.name}</h2>
				<p>{feature.description}</p>
				<span class="view-link">
					View the case study
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</span>
			</div>
		</a>

		<div class="grid">
			{projects.map((project, i) => (
				<article class:list={['card', { 'is-wide': i === projects.length - 1 && projects.length % 2 === 1 }]} data-project>
					<figure class="card-media">
						{project.image && (
							<img
								src={project.image.src}
								alt={project.alt}
								width={project.image.width}
								height={project.image.height}
								loading="lazy"
								decoding="async"
							/>
						)}
						{project.imageId && (
							<Picture
								id={project.imageId}
								alt={project.alt}
								sizes={
									i === projects.length - 1 && projects.length % 2 === 1
										? '(max-width: 1280px) 100vw, 1232px'
										: '(max-width: 700px) 100vw, (max-width: 1280px) 50vw, 600px'
								}
							/>
						)}
					</figure>
					<div class="card-copy">
						<span class="meta">{project.status}</span>
						<h2>{project.name}</h2>
						<p>{project.description}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	// Each project settles once (image 1.06 → 1, copy fades up) as it enters.
	const items = document.querySelectorAll<HTMLElement>('[data-project]');
	if (!('IntersectionObserver' in window)) {
		items.forEach((item) => item.classList.add('is-revealed'));
	} else {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-revealed');
					io.unobserve(entry.target);
				});
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
		);
		items.forEach((item) => io.observe(item));
	}
</script>

<style>
	.projects {
		padding-bottom: clamp(4.5rem, 10vw, 8.5rem);
	}

	/* ---- Feature: the one project with a full case study ---- */

	.feature {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
		padding-bottom: clamp(4rem, 9vw, 7rem);
		margin-bottom: clamp(4rem, 9vw, 7rem);
		border-bottom: 1px solid var(--color-border);
	}

	.feature-media,
	.card-media {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-charcoal);
	}

	.feature-media {
		aspect-ratio: 16 / 10;
	}

	.feature-media img,
	.card-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.meta {
		display: block;
		margin-bottom: var(--space-4);
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.feature-copy h2 {
		margin: 0 0 var(--space-4);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
		transition: color var(--dur-fast) ease;
	}

	.feature-copy p {
		max-width: 30rem;
		margin-bottom: var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.65;
	}

	.view-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding-bottom: var(--space-1);
		border-bottom: 1px solid currentColor;
		font-weight: var(--fw-medium);
		color: var(--color-accent);
		transition: color var(--dur-fast) ease;
	}

	.view-link svg {
		width: 18px;
		height: 18px;
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.feature:hover h2,
	.feature:focus-visible h2 {
		color: var(--color-accent);
	}

	.feature:hover .view-link svg,
	.feature:focus-visible .view-link svg {
		transform: translateX(5px);
	}

	/* ---- The rest: 2 / 2 / 1, the last one wide ---- */

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 3vw, 2.5rem);
	}

	.card.is-wide {
		grid-column: 1 / -1;
	}

	.card-media {
		aspect-ratio: 4 / 3;
	}

	.card.is-wide .card-media {
		aspect-ratio: 21 / 9;
	}

	.card-copy {
		padding-top: var(--space-6);
	}

	.card-copy h2 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-tile);
		font-weight: var(--fw-medium);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.card-copy p {
		margin: 0;
		max-width: 32rem;
		line-height: 1.7;
	}

	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		[data-project] :global(img) {
			transform: scale(1.06);
			transition: transform 1600ms var(--ease-out-expo);
		}
		.feature-copy,
		.card-copy {
			opacity: 0;
			transform: translateY(20px);
			transition:
				opacity 1000ms var(--ease-out-expo) 150ms,
				transform 1000ms var(--ease-out-expo) 150ms;
		}
		.is-revealed :global(img) {
			transform: none;
		}
		.is-revealed .feature-copy,
		.is-revealed .card-copy {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 900px) {
		.feature {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 700px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.card.is-wide .card-media {
			aspect-ratio: 4 / 3;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.view-link svg {
			transition: none;
		}
	}
</style>
