---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const projects = [
	{
		slug: 'pacific-horizon-residence',
		name: 'Pacific Horizon Residence',
		description: 'A coastal home where lighting, shading, entertainment, security, and climate operate through one effortless system.',
		image: '/images/success-stories/pacific-horizon-residence.webp',
		date: 'July 15, 2026',
		status: 'Completed',
		href: '/project-single/',
	},
	{
		slug: 'canyon-glass-house',
		name: 'Canyon Glass House',
		description: 'Intelligent lighting and automated shading enhance the architecture while preserving expansive views and privacy.',
		image: '/images/success-stories/canyon-glass-house.webp',
		date: 'July 15, 2026',
		status: 'Completed',
	},
	{
		slug: 'manhattan-beach-modern',
		name: 'Manhattan Beach Modern',
		description: 'Discreet audio, intuitive control, and reliable networking create a connected experience throughout the residence.',
		image: '/images/success-stories/manhattan-beach-modern.webp',
		date: 'July 15, 2026',
		status: 'Completed',
	},
	{
		slug: 'bel-air-cinema-suite',
		name: 'Bel Air Cinema Suite',
		description: 'A private cinema designed with immersive sound, precise lighting, and uncompromising picture quality.',
		image: '/images/success-stories/bel-air-cinema-suite.webp',
		date: 'July 15, 2026',
		status: 'Completed',
	},
	{
		slug: 'malibu-cliffside-retreat',
		name: 'Malibu Cliffside Retreat',
		description: 'Integrated surveillance, access control, and whole-home connectivity provide quiet protection without disrupting the design.',
		image: '/images/success-stories/malibu-cliffside-retreat.webp',
		date: 'July 15, 2026',
		status: 'Completed',
	},
	{
		slug: 'sunset-courtyard-estate',
		name: 'Sunset Courtyard Estate',
		description: 'Architectural lighting and intelligent energy management bring comfort, atmosphere, and efficiency into perfect balance.',
		image: '/images/success-stories/sunset-courtyard-estate.webp',
		date: 'July 15, 2026',
		status: 'Completed',
	},
];
---

<PageLayout
	title="Success Stories"
	description="Explore PROJECT: automate residences where thoughtful design and intelligent technology work together effortlessly."
	image="/images/success-stories/pacific-horizon-residence.webp"
>
	<section class="section hero">
		<div class="container">
			<SectionHeading
				eyebrow="Success Stories"
				title="Spaces Made Intelligent."
				subtitle="Explore PROJECT:automate residences where thoughtful design and intelligent technology work together effortlessly."
				align="center"
			/>
		</div>
	</section>

	<section class="section projects">
		<div class="container">
			<div class="grid">
				{projects.map((project) => {
					const Wrapper = project.href ? 'a' : 'div';
					return (
						<Wrapper class="card" href={project.href}>
							<figure>
								<img src={project.image} alt={project.name} loading="lazy" width="1024" height="640" />
							</figure>
							<div class="card-body">
								<div class="meta">
									<span>{project.date}</span>
									<span class="dot" aria-hidden="true">&middot;</span>
									<span>{project.status}</span>
								</div>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
								{project.href && <span class="view-link">View Project &rarr;</span>}
							</div>
						</Wrapper>
					);
				})}
			</div>
		</div>
	</section>

	<section class="section closing">
		<div class="container">
			<SectionHeading
				eyebrow="Start Your Project"
				title="Bring Intelligent Living Into Your Home"
				subtitle="Planning a new residence or major renovation? PROJECT:automate can collaborate with your architect, designer, and builder to integrate technology from the beginning."
				align="center"
			/>
		</div>
	</section>

	<CtaBanner />
</PageLayout>

<style>
	.hero {
		padding-bottom: 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-8);
	}

	.card {
		display: block;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: border-color var(--transition-base), transform var(--transition-base);
	}

	a.card:hover {
		border-color: var(--color-accent);
		transform: translateY(-4px);
	}

	.card figure {
		margin: 0;
	}

	.card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.card-body {
		padding: var(--space-6);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-accent);
		margin-bottom: var(--space-3);
	}

	.dot {
		color: var(--color-text-muted);
	}

	.card-body h3 {
		font-size: var(--text-xl);
		margin-bottom: var(--space-2);
	}

	.card-body p {
		font-size: var(--text-sm);
		margin-bottom: var(--space-4);
	}

	.view-link {
		display: inline-block;
		font-size: var(--text-sm);
		font-weight: var(--fw-semibold);
		color: var(--color-accent);
		transition: color var(--transition-base);
	}

	a.card:hover .view-link {
		color: var(--color-accent-hover);
	}

	.closing {
		padding-top: 0;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
