---
// Inline GHL lead form, placed after the trust chapter so the page asks for
// the enquiry once the case has been made. The same form also opens as a
// popup from every Schedule/Book CTA (GhlFormModal in BaseLayout), which is
// why this copy is not `primary`: the homepage popup must stay available.
import GhlForm from '../components/ghl/GhlForm.astro';
import { siteInfo } from '../data/site.ts';
import { withBase } from '../lib/paths.ts';

const phone = siteInfo.phones[0];
const phoneHref = `tel:${phone.replace(/[^0-9+]/g, '')}`;
---

<section class="consult" id="consultation" aria-labelledby="consult-title">
	<div class="page consult-grid">
		<div class="consult-copy">
			<span class="eyebrow">Private Consultation</span>
			<h2 id="consult-title">Begin with a<br />conversation.</h2>
			<p>
				Tell us about your residence, your design team and your timeline. A senior specialist will
				reply personally to plan a system that works as one and disappears into the architecture.
			</p>

			<dl class="consult-contact">
				<div>
					<dt>Studio</dt>
					<dd><a href={phoneHref}>{phone}</a></dd>
				</div>
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></dd>
				</div>
			</dl>

			<aside class="consult-aside" aria-label="For architects, designers and builders">
				<p>Architect, designer or builder?</p>
				<a class="text-link" href={withBase('/design-partners/')}>
					Explore the Design Partner program
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			</aside>
		</div>

		<div class="consult-form">
			<GhlForm />
		</div>
	</div>
</section>

<style>
	.consult {
		background: var(--color-bg);
		padding-block: clamp(4.5rem, 10vw, 8.5rem);
		scroll-margin-top: var(--header-height, 96px);
	}

	.consult-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	/* The copy stays in view while the (tall) form scrolls past it. */
	.consult-copy {
		position: sticky;
		top: calc(var(--header-height, 96px) + var(--space-8));
	}

	.consult h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.consult-copy > p {
		max-width: 30rem;
		margin: 0 0 clamp(2rem, 4vw, 2.75rem);
		font-size: var(--text-body-lg);
		line-height: 1.65;
		color: var(--color-charcoal-2);
	}

	.consult-contact {
		display: grid;
		gap: var(--space-4);
		max-width: 30rem;
		margin: 0;
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.consult-contact > div {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-4);
	}

	.consult-contact dt {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.consult-contact dd {
		margin: 0;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.consult-contact a {
		font-size: var(--text-lg);
		font-weight: var(--fw-medium);
		color: var(--color-text);
		transition: color var(--dur-fast) var(--ease-in-out-soft);
	}

	.consult-contact a:hover {
		color: var(--color-accent);
	}

	/* A quiet side door for the trade, kept out of the client's path. */
	.consult-aside {
		max-width: 30rem;
		margin-top: clamp(2rem, 4vw, 2.75rem);
		padding: var(--space-6);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.consult-aside p {
		margin: 0 0 var(--space-2);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--text-base);
		font-weight: var(--fw-medium);
		letter-spacing: 0.01em;
		color: var(--color-text);
		transition: color var(--dur-fast) var(--ease-in-out-soft);
	}

	.text-link svg {
		flex: none;
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		transition: transform var(--dur-base) var(--ease-out-expo);
	}

	.text-link:hover {
		color: var(--color-accent);
	}

	.text-link:hover svg {
		transform: translateX(4px);
	}

	.consult-form {
		min-width: 0;
	}

	/* Stacked, the trade aside moves below the form so a homeowner meets the
	   form first. The copy wrapper dissolves (display: contents) so its
	   children and the aside can be reordered against the form. */
	@media (max-width: 899px) {
		.consult-grid {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}

		.consult-copy {
			display: contents;
		}

		.consult-copy > .eyebrow {
			align-self: flex-start;
		}

		.consult-form {
			margin-top: var(--space-12);
		}

		.consult-aside {
			order: 1;
			max-width: none;
			margin-top: var(--space-12);
		}
	}

	@media (max-width: 420px) {
		.consult-contact > div {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
