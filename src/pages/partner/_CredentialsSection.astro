---
import { withBase } from '../../lib/paths.ts';
import SectionHeading from '../../components/ui/SectionHeading.astro';

const badges = [
	{ src: withBase('/images/badges/17-years-badge.webp'), alt: '17+ Years in business badge' },
	{ src: withBase('/images/badges/cedia-certified.webp'), alt: 'CEDIA Smart Home Certified Expert Provider' },
	{ src: withBase('/images/badges/cert-level-luxury.webp'), alt: 'Certification Level: Luxury' },
	{ src: withBase('/images/badges/hta-design-partner.webp'), alt: 'HTA Design Partner' },
];
---

<section class="section credentials">
	<div class="container">
		<SectionHeading
			eyebrow="Credentials That Set the Standard"
			title="One of the nation's leading certified Savant dealers."
			subtitle="We work with hundreds of suppliers, clients, and businesses throughout Los Angeles. Joining our Partner Program gives you access to one of the nation's leading certified Savant dealers and smart home installers."
		/>
		<ul class="badges">
			{badges.map((badge) => (
				<li><img src={badge.src} alt={badge.alt} loading="lazy" width="110" height="110" /></li>
			))}
		</ul>
	</div>
</section>

<style>
	.credentials .badges {
		display: flex;
		gap: var(--space-8);
		flex-wrap: wrap;
		margin-top: var(--space-8);
	}

	.credentials .badges img {
		width: 80px;
		height: 80px;
		object-fit: contain;
		opacity: 0.9;
	}
</style>
