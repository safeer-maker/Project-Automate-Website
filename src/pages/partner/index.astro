---
import { withBase } from '../../lib/paths.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import FeatureList from '../../components/brands/FeatureList.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import HeroSection from './_HeroSection.astro';
import CredentialsSection from './_CredentialsSection.astro';
import ClosingSection from './_ClosingSection.astro';

const partners = [
	{
		title: 'Architects',
		description:
			"We work alongside architecture teams from early planning through construction, integrating technology infrastructure into the design — not around it.",
		image: withBase('/images/partner/partner-architects.webp'),
	},
	{
		title: 'Design Build Firms',
		description:
			'Coordinated technology planning and scheduling that keeps low-voltage and automation trades aligned with the rest of a design-build project.',
		image: withBase('/images/partner/partner-design-build-firms.webp'),
	},
	{
		title: 'Interior Designers',
		description:
			'Smart home systems specified and installed without compromising sightlines, finishes, or the aesthetic intent of the space.',
		image: withBase('/images/partner/partner-interior-designers.webp'),
	},
	{
		title: 'General Contractors',
		description:
			'Clear documentation and on-site coordination that keeps technology installation moving in step with the rest of the build.',
		image: withBase('/images/partner/partner-general-contractors.webp'),
	},
];

const education = [
	{
		title: 'CEU Courses',
		description:
			'Gain access to award-winning CEU courses that help design professionals stay licensed and nationally accredited in residential technology.',
	},
	{
		title: 'Custom Courses',
		description:
			'Take part in our own custom-tailored courses, built around the common challenges smart home installers and dealers face every day.',
	},
];
---

<PageLayout
	title="Partner Program"
	description="The PROJECT: automate Partner Program for architects, interior designers, general contractors, and design-build professionals — coordinated smart home technology integration across Los Angeles."
>
	<HeroSection />

	<CapabilityList eyebrow="Who We Partner With" title="Built for design-build teams." items={partners} />

	<CredentialsSection />

	<FeatureList eyebrow="For Design Professionals" title="Continuing education, built in." features={education} />

	<ClosingSection />

	<CtaBanner />
</PageLayout>
