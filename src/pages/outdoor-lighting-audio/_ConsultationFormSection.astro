---
// The point of this landing page. The form is `primary`: its src is in the
// HTML so it starts loading with the page, and every consultation CTA here
// (including the hero button) scrolls to it instead of opening the popup.
import GhlForm from '../../components/ghl/GhlForm.astro';
import { siteInfo } from '../../data/site.ts';

const phone = siteInfo.phones[0];
const phoneHref = `tel:${phone.replace(/[^0-9+]/g, '')}`;
---

<section class="consult" id="consultation" aria-labelledby="consult-title">
	<div class="container consult-grid">
		<div class="consult-copy">
			<span class="eyebrow">Private Design Consultation</span>
			<h2 id="consult-title">Tell us about your outdoor spaces.</h2>
			<p>
				Share a little about your property, your garden and your plans. A member of our team will follow up
				personally to arrange a design consultation for landscape lighting and outdoor audio.
			</p>

			<dl class="consult-contact">
				<div>
					<dt>Studio</dt>
					<dd><a href={phoneHref}>{phone}</a></dd>
				</div>
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></dd>
				</div>
			</dl>

			<p class="consult-credentials">17+ years · 400+ Los Angeles residences · CEDIA and HTA certified</p>
		</div>

		<div class="consult-form">
			<GhlForm primary />
		</div>
	</div>
</section>

<style>
	.consult {
		background: var(--color-surface);
		padding-block: clamp(4.5rem, 10vw, 8.5rem);
		scroll-margin-top: var(--header-height, 96px);
	}

	.consult-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	/* The copy stays in view while the (tall) form scrolls past it. */
	.consult-copy {
		position: sticky;
		top: calc(var(--header-height, 96px) + var(--space-8));
	}

	.consult h2 {
		margin: 0 0 var(--space-6);
		font-size: var(--text-display-md);
		font-weight: var(--fw-medium);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: var(--color-text);
		text-wrap: balance;
	}

	.consult-copy > p {
		max-width: 30rem;
		margin: 0 0 var(--space-8);
		font-size: var(--text-body-lg);
		line-height: 1.7;
	}

	.consult-contact {
		margin: 0 0 var(--space-8);
	}

	.consult-contact div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-4);
		border-top: 1px solid var(--color-border);
	}

	.consult-contact div:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.consult-contact dt {
		font-size: var(--text-xs);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.consult-contact dd {
		margin: 0;
		min-width: 0;
		overflow-wrap: anywhere;
		text-align: right;
	}

	.consult-contact a {
		font-size: var(--text-lg);
		font-weight: var(--fw-medium);
		color: var(--color-text);
		transition: color var(--dur-fast) ease;
	}

	.consult-contact a:hover {
		color: var(--color-bronze-fill-hover);
	}

	.consult-credentials {
		margin: 0;
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	@media (max-width: 900px) {
		.consult-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.consult-copy {
			position: static;
		}
	}
</style>
