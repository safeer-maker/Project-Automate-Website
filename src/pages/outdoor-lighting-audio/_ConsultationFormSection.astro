---
import SectionHeading from '../../components/ui/SectionHeading.astro';
import GhlForm from '../../components/ghl/GhlForm.astro';
---

<section class="section">
	<div class="container form-wrap">
		<SectionHeading
			eyebrow="Outdoor Lighting & Audio"
			title="Request a Consultation"
			subtitle="Tell us about your outdoor space and we'll follow up to design the right lighting and audio experience for it."
		/>

		<GhlForm />
	</div>
</section>

<style>
	.form-wrap {
		max-width: 780px;
		padding-block: var(--space-8) var(--space-24);
	}
</style>
