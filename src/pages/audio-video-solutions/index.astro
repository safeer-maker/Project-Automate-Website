---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/home/CtaBanner.astro';

const capabilities = [
	{
		title: 'Whole-Home Entertainment',
		description: 'Enjoy music, television and video throughout your home with simple room-by-room control. Play the same content everywhere or create personalized experiences in different spaces, all from one intuitive system.',
		image: '/images/solutions/audio-video-solutions/feature-1.webp',
	},
	{
		title: 'Outdoor Entertainment',
		description: 'Extend music, television and entertainment into patios, pools, gardens and outdoor living spaces. Weather-resistant audio and video systems are carefully positioned to deliver balanced performance while blending naturally into the landscape.',
		image: '/images/solutions/audio-video-solutions/feature-2.webp',
	},
	{
		title: 'Performance Audio & Video',
		description: 'Every speaker, display, room and source is carefully selected, positioned and calibrated to deliver natural sound and exceptional picture quality — refined and consistent, whether you are listening to music, watching a film or entertaining guests.',
		image: '/images/solutions/audio-video-solutions/feature-3.webp',
	},
];

const scenes = [
	{ title: 'Morning Playlist', description: 'Music follows you from kitchen to primary suite with one touch, at a level tuned to each room.' },
	{ title: 'Movie Night', description: 'Calibrated speakers and premium displays deliver clear, balanced sound and true-to-life picture.' },
	{ title: 'Poolside Gathering', description: 'Weather-resistant speakers and displays extend the entertainment outdoors without missing a beat.' },
	{ title: 'Effortless Control', description: 'Every room, every source, controlled from your phone, keypad, remote or touch panel.' },
];
---

<ServiceLayout
	title="Audio & Video Solutions"
	description="Whole-home audio and video systems from PROJECT: automate — discreet technology, intuitive control and professional installation for exceptional performance in every space."
	heroImage="/images/solutions/audio-video-solutions/hero.webp"
	eyebrow="Audio & Video Solutions"
	heroTitle="Audio and Video, Perfectly Integrated"
	heroSubtitle="Experience music, movies, television and entertainment throughout your home with thoughtfully designed audio and video systems, discreet technology and professional installation."
>
	<CapabilityList eyebrow="Complete Connected Custom" title="One system. Every experience connected." items={capabilities} />

	<DailyExperience eyebrow="Daily Experience" title="Music, movies and entertainment — wherever you are." scenes={scenes} />

	<section class="section power-system">
		<div class="container">
			<SectionHeading eyebrow="Design Your Experience" title="Design Your Entertainment Experience" subtitle="Bring music, movies, television and outdoor entertainment together through one beautifully integrated system designed around your home and lifestyle." align="center" />
		</div>
	</section>

	<CtaBanner />
</ServiceLayout>
