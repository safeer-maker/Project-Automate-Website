---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import CapabilityList from '../../components/brands/CapabilityList.astro';
import DailyExperience from '../../components/brands/DailyExperience.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const capabilities = [
	{
		title: 'Whole-Home Entertainment',
		description:
			'Music, television and film throughout the home, with simple room-by-room control. Play the same thing everywhere, or something different in every space, all from one intuitive system.',
		imageId: 'solutions/control-touch',
		imageAlt: 'Hands on a wall-mounted home control touchscreen in a bright, modern living room',
	},
	{
		title: 'Outdoor Entertainment',
		description:
			'Music and television carried out to patios, pools and gardens. Weather-resistant audio and video are placed for balanced performance and blend naturally into the landscape.',
		imageId: 'solutions/audio-pergola',
		imageAlt: 'Outdoor speakers mounted discreetly on a white pergola above a pool and lounge',
	},
	{
		title: 'Performance Audio & Video',
		description:
			'Every speaker, display and source is selected, positioned and calibrated for natural sound and exceptional picture, refined and consistent whether you are listening, watching or entertaining.',
		imageId: 'solutions/audio-garden-speaker',
		imageAlt: 'A sculptural landscape speaker set among planting in a modern garden',
	},
] as const;

const scenes = [
	{ title: 'Morning Playlist', description: 'Music follows you from the kitchen to the primary suite, at a level tuned to each room.' },
	{ title: 'Movie Night', description: 'Calibrated speakers and premium displays deliver clear, balanced sound and true-to-life picture.' },
	{ title: 'Poolside Gathering', description: 'Weather-resistant speakers carry the evening outdoors without missing a beat.' },
	{ title: 'Effortless Control', description: 'Every room and every source, from your phone, a keypad, a remote or a touch panel.' },
];
---

<ServiceLayout
	title="Whole-Home Audio & Video, Los Angeles"
	description="Invisible speakers, concealed displays and whole-home audio and video for Los Angeles residences: reference sound in every room, controlled with a single touch."
	heroImageId="solutions/cinema-media-room"
	heroAlt="A media room lined in warm wood slats, with a deep sofa facing a large screen"
	eyebrow="Whole-Home Audio & Video"
	heroTitle="Audio and Video, Perfectly Integrated"
	heroSubtitle="Music, film and television in every room and across the terrace, with speakers you never see and control that feels effortless."
	intro="Sound should fill a room, never clutter it. We design whole-home audio and video around the architecture, with invisible speakers, concealed displays and one intuitive way to play anything, anywhere."
	serviceName="Whole-Home Audio & Video"
	serviceType="Whole-home audio and video design and installation"
	related={['home-theater', 'outdoor-living', 'control-systems']}
>
	<CapabilityList eyebrow="Complete, Connected, Custom" title="One system. Every room, every source." items={capabilities} />

	<DailyExperience
		eyebrow="Daily Experience"
		title="Music, film and entertainment, wherever you are."
		scenes={scenes}
		imageId="solutions/audio-terrace"
		imageAlt="A terrace lounge at sunset, softly lit, looking out over the hills"
	/>

	<CtaBanner slot="closing" />
</ServiceLayout>
